{
  "name": "native-live-local-automation",
  "description": "通过原生 WebView2 UI 验证本地 automation 的 Rust CRUD、schedule/recurring/maxRuns、启停、手动派发、真实工具 Journal、超时失败运行历史与冷重启持久化；不注入状态、不伪造模型响应。",
  "providerId": "native-live-deepseek",
  "model": "deepseek-v4.1-flash",
  "files": {
    "evidence.txt": "原生 automation 验收初始内容\n"
  },
  "coverage": [
    {
      "id": "local-automation-crud",
      "status": "pending",
      "testIds": [
        "automations-open",
        "automations-page-tab-automation",
        "automations-list",
        "automation-create-manually",
        "automation-form-title",
        "automation-form-schedule",
        "automation-form-prompt",
        "form [role=\"switch\"]",
        "form input[inputmode=\"numeric\"][pattern=\"[0-9]*\"]",
        "automation-form-submit",
        "automation-action-toggle",
        "automation-run-now",
        "automation-card-menu",
        "automation-action-history",
        "automation-action-delete",
        "automation-run-open-session",
        "automation-run-row-*",
        "automation-run-row-* button[aria-label=\"删除记录\"]",
        "automation-run-row-* button[aria-label=\"Delete run\"]"
      ],
      "notes": "计划覆盖真实页面创建、cron、有限运行（recurring=false、maxRuns=2）、Rust 台账回读、编辑、暂停/恢复、立即运行、真实 tool_requested/tool_execution_started Journal、隔离请求超时产生的失败 run 历史、运行历史 deleteRun 和冷重启持久化。手动 run 的失败与 automation scheduler lifecycle 分开断言；运行前需要包含本地自动化 UI 的新 native binary。"
    }
  ],
  "knownGaps": [
    "automation 不提供独立 provider/model 表单，执行使用当前 workspace 默认模型；provider-config 必须让该默认模型可用。",
    "计划不直接读隔离 data/automations.json；创建、编辑、启停、重启、运行记录删除和 automation 删除均以 UI 重新读取与状态变化作为 Rust 持久化证据。",
    "Restart 入口只对 Rust lifecycleStatus=failed 或 completed 显示；手动模型超时只改变该 run 的 outcome，scheduler 仍保持 active，因此本计划不把 run failure 推断为 lifecycle failure。dispatch failure/completed scheduler 的 Restart 仍需独立真实夹具。"
  ],
  "steps": [
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"onboarding-page\"] footer > button') && !/主要工作方向|UI 模式|UI mode/.test(document.querySelector('[data-testid=\"onboarding-page\"]')?.innerText ?? \"\")",
      "timeoutMs": 30000,
      "description": "隔离新配置直接进入偏好页，无职业或模式选择"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"onboarding-page\"] footer > button",
      "description": "通过原生 UI 一次完成首次启动偏好"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"project-add\"]')",
      "timeoutMs": 45000,
      "description": "原生工作区完成启动"
    },
    {
      "action": "hover",
      "selector": "[data-testid=\"project-section\"]",
      "description": "悬停项目分区以显示真实新增项目控件"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"project-add\"]",
      "description": "打开项目菜单"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"] [data-slot=\"dropdown-menu-item\"]",
      "description": "从原生菜单选择隔离项目"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]')",
      "timeoutMs": 60000,
      "description": "项目 workspace 激活"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automations-open\"]')",
      "timeoutMs": 30000,
      "description": "自动化入口由原生侧栏挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-open\"]",
      "description": "打开自动化页面"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-automations-content]') && !!document.querySelector('[data-testid=\"automations-page-tab-automation\"]')",
      "timeoutMs": 45000,
      "description": "自动化页面和页签由原生 UI 挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-page-tab-automation\"]",
      "description": "选择本地 automation 页签"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"automations-page-tab-automation\"]')?.getAttribute('aria-selected') === 'true' && !!document.querySelector('[data-testid=\"automations-list\"]')",
      "timeoutMs": 45000,
      "description": "automation 列表状态真实回写"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automation-create-manually\"]",
      "description": "通过 UI 打开本地 automation 创建表单"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automation-form-title\"]') && !!document.querySelector('[data-testid=\"automation-form-prompt\"]') && !!document.querySelector('[data-testid=\"automation-form-submit\"]')",
      "timeoutMs": 30000,
      "description": "创建表单控件完整挂载"
    },
    {
      "action": "clear",
      "selector": "[data-testid=\"automation-form-schedule\"]",
      "description": "清除默认 cron 以填写可回读的工作日计划"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"automation-form-schedule\"]",
      "text": "15 10 * * 1-5",
      "description": "填写真实工作日 schedule"
    },
    {
      "action": "click",
      "selector": "form [role=\"switch\"]",
      "description": "关闭 recurring 以启用有限 maxRuns"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('form [role=\"switch\"]')?.getAttribute('aria-checked') === 'false' && !!document.querySelector('form input[inputmode=\"numeric\"][pattern=\"[0-9]*\"]')",
      "timeoutMs": 10000,
      "description": "有限运行表单显示 maxRuns 输入"
    },
    {
      "action": "type",
      "selector": "form input[inputmode=\"numeric\"][pattern=\"[0-9]*\"]",
      "text": "2",
      "description": "填写 Rust 约束的最大运行次数"
    },
    {
      "action": "assert",
      "expression": "document.querySelector('[data-testid=\"automation-form-schedule\"]')?.value === '15 10 * * 1-5' && document.querySelector('form [role=\"switch\"]')?.getAttribute('aria-checked') === 'false' && document.querySelector('form input[inputmode=\"numeric\"][pattern=\"[0-9]*\"]')?.value === '2'",
      "description": "创建前确认 schedule、recurring 和 maxRuns 都由真实表单持有"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"automation-form-title\"]",
      "text": "NATIVE_LOCAL_AUTOMATION",
      "description": "填写 automation 标题"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"automation-form-prompt\"]",
      "text": "Create NATIVE_AUTOMATION_RESULT.txt containing exactly NATIVE_AUTOMATION_OK and stop.",
      "description": "填写真实 Agent 指令"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automation-form-submit\"]",
      "description": "通过 Rust RPC 创建本地 automation"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-automation-id]') && document.body.innerText.includes('NATIVE_LOCAL_AUTOMATION')",
      "timeoutMs": 60000,
      "description": "创建结果从 Rust 台账回读到卡片"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-card-menu\"]",
      "description": "打开 automation 操作菜单"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"] [data-slot=\"dropdown-menu-item\"]",
      "description": "进入编辑表单"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automation-form-title\"]')",
      "timeoutMs": 30000,
      "description": "编辑表单读取已保存字段"
    },
    {
      "action": "assert",
      "expression": "document.querySelector('[data-testid=\"automation-form-schedule\"]')?.value === '15 10 * * 1-5' && document.querySelector('form [role=\"switch\"]')?.getAttribute('aria-checked') === 'false' && document.querySelector('form input[inputmode=\"numeric\"][pattern=\"[0-9]*\"]')?.value === '2'",
      "description": "编辑表单从 Rust 台账恢复 schedule、recurring 和 maxRuns"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"automation-form-title\"]",
      "text": "_EDITED",
      "description": "修改标题并保留原字段"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automation-form-submit\"]",
      "description": "通过 Rust RPC 保存修改"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-automation-id]') && document.body.innerText.includes('NATIVE_LOCAL_AUTOMATION_EDITED')",
      "timeoutMs": 60000,
      "description": "编辑结果重新从 Rust 台账回读"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-action-toggle\"]",
      "description": "暂停 automation"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-automation-id] [role=\"switch\"]')?.getAttribute('aria-checked') === 'false'",
      "timeoutMs": 30000,
      "description": "暂停状态真实回写"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-action-toggle\"]",
      "description": "恢复 automation"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-automation-id] [role=\"switch\"]')?.getAttribute('aria-checked') === 'true'",
      "timeoutMs": 30000,
      "description": "恢复状态真实回写"
    },
    {
      "action": "journalBaseline",
      "name": "before-automation-run",
      "eventType": "tool_requested",
      "captureEventSequence": true,
      "description": "固定 automation 手动运行前各 Session 的 Journal 高水位"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-run-now\"]",
      "description": "通过 UI 触发真实手动运行"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automation-card-menu\"]') && document.querySelector('[data-testid=\"automation-card-menu\"]')?.hasAttribute('disabled') !== true",
      "timeoutMs": 30000,
      "description": "等待手动运行请求完成且保留操作菜单"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-card-menu\"]",
      "description": "打开运行历史菜单"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"] [data-testid=\"automation-action-history\"]",
      "description": "从原生 UI 打开本次运行历史"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automations-refresh\"]')",
      "timeoutMs": 30000,
      "description": "运行历史页面完成挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-refresh\"]",
      "description": "从 Rust 台账重新读取刚创建的运行"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid^=\"automation-run-row-\"] [data-testid=\"automation-run-open-session\"]')",
      "timeoutMs": 90000,
      "description": "历史回读真实 run.sessionId"
    },
    {
      "action": "click",
      "selector": "[data-testid^=\"automation-run-row-\"] [data-testid=\"automation-run-open-session\"]",
      "description": "从历史打开本次运行对应的真实会话"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('[data-permission-option-kind=\"allowOnce\"][data-permission-request-id]') && !!document.querySelector('[data-permission-option-kind=\"rejectOnce\"][data-permission-request-id]')",
      "timeoutMs": 180000,
      "description": "真实会话显示待审批的写工具请求"
    },
    {
      "action": "journalBaseline",
      "name": "before-automation-allow-receipt",
      "eventType": "command_receipt_committed",
      "capturePermissionInteraction": true,
      "description": "记录本次 automation 写工具 allowOnce interactionId 与既有收据"
    },
    {
      "action": "click",
      "selector": "[data-permission-option-kind=\"allowOnce\"]",
      "description": "在真实会话中选择仅允许这一次"
    },
    {
      "action": "key",
      "key": "Enter",
      "description": "提交 allowOnce 权限选择"
    },
    {
      "action": "journalWait",
      "eventType": "tool_requested",
      "requestContains": "NATIVE_AUTOMATION_RESULT.txt",
      "requestEffect": "changes_state",
      "newSinceBaseline": "before-automation-run",
      "captureSessionAs": "automation-run-session",
      "timeoutMs": 180000,
      "description": "真实 automation Agent 工具请求进入权威 Journal"
    },
    {
      "action": "journalWait",
      "eventType": "tool_execution_started",
      "requestContains": "NATIVE_AUTOMATION_RESULT.txt",
      "requestEffect": "changes_state",
      "newSinceBaseline": "before-automation-run",
      "sessionEqualsCaptured": "automation-run-session",
      "timeoutMs": 180000,
      "description": "真实 automation 工具执行开始进入权威 Journal"
    },
    {
      "action": "file",
      "path": "NATIVE_AUTOMATION_RESULT.txt",
      "contains": "NATIVE_AUTOMATION_OK",
      "description": "真实 automation Agent 在隔离项目写入结果"
    },
    {
      "action": "journalWait",
      "eventType": "tool_completed",
      "requestContains": "NATIVE_AUTOMATION_RESULT.txt",
      "requestEffect": "changes_state",
      "newSinceBaseline": "before-automation-run",
      "sessionEqualsCaptured": "automation-run-session",
      "outcomeStatus": "succeeded",
      "outcomeIsError": false,
      "timeoutMs": 180000,
      "description": "确认 automation 写工具以成功结果写入权威 Journal"
    },
    {
      "action": "journal",
      "eventType": "command_receipt_committed",
      "receiptCommandType": "resolveInteraction",
      "receiptStatus": "completed",
      "receiptOptionId": "allowOnce",
      "receiptAckStatus": "accepted",
      "sessionEqualsCaptured": "automation-run-session",
      "receiptNewSince": "before-automation-allow-receipt",
      "receiptInteractionSince": "before-automation-allow-receipt",
      "description": "automation 写工具 allowOnce 答复以对应 interactionId 的真实收据写入 Journal"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-open\"]",
      "description": "返回本地 automation 管理页"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automations-page-tab-automation\"]')",
      "timeoutMs": 60000,
      "description": "automation 管理页重新挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-page-tab-automation\"]",
      "description": "重新打开本地 automation 页签"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automations-refresh\"]')",
      "timeoutMs": 30000,
      "description": "本地 automation 列表重新挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-refresh\"]",
      "description": "刷新本地 automation 台账"
    },
    {
      "action": "wait",
      "expression": "document.body.innerText.includes('已运行 1/2 次') || document.body.innerText.includes('Ran 1/2 times') || document.body.innerText.includes('已运行 1 次') || document.body.innerText.includes('Ran 1 times')",
      "timeoutMs": 90000,
      "description": "手动运行次数从 Rust 台账回读"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-card-menu\"]",
      "description": "打开 automation 编辑菜单准备真实失败终态"
    },
    {
      "action": "clickText",
      "selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"] [data-slot=\"dropdown-menu-item\"]",
      "texts": [
        "编辑",
        "Edit"
      ],
      "exact": false,
      "description": "从原生菜单重新打开编辑表单"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automation-form-prompt\"]')",
      "timeoutMs": 30000,
      "description": "失败运行夹具编辑表单挂载"
    },
    {
      "action": "clear",
      "selector": "[data-testid=\"automation-form-prompt\"]",
      "description": "清除成功运行指令"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"automation-form-prompt\"]",
      "text": "请只用一句话回复 NATIVE_AUTOMATION_TIMEOUT_MARKER_20261003。",
      "description": "把第二次真实运行设为只依赖模型请求的超时夹具"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automation-form-submit\"]",
      "description": "通过真实 UI 保存失败运行指令"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-automation-id]') && document.body.innerText.includes('NATIVE_LOCAL_AUTOMATION_EDITED')",
      "timeoutMs": 60000,
      "description": "失败运行指令从 Rust 台账回读"
    },
    {
      "action": "restart",
      "requestTimeoutMs": 1,
      "description": "重启隔离宿主并仅为本次真实模型请求注入 1ms 超时"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('[data-testid=\"automations-open\"]')",
      "timeoutMs": 60000,
      "description": "超时夹具重启后恢复原生工作区"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-open\"]",
      "description": "重启后返回本地 automation 管理页"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automations-page-tab-automation\"]')",
      "timeoutMs": 60000,
      "description": "超时夹具的 automation 页签重新挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-page-tab-automation\"]",
      "description": "重启后重新读取同一 automation"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automations-list\"]') && document.body.innerText.includes('NATIVE_LOCAL_AUTOMATION_EDITED')",
      "timeoutMs": 60000,
      "description": "确认超时夹具仍来自同一持久 automation"
    },
    {
      "action": "journalBaseline",
      "name": "before-automation-failure-run",
      "eventType": "turn_started",
      "captureEventSequence": true,
      "description": "固定超时手动运行前每个 Session 的 Journal 高水位"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-run-now\"]",
      "description": "通过 UI 触发真实超时运行"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automation-card-menu\"]') && document.querySelector('[data-testid=\"automation-card-menu\"]')?.hasAttribute('disabled') !== true",
      "timeoutMs": 30000,
      "description": "等待超时运行请求返回并保留操作菜单；不把按钮状态当作已排队证据"
    },
    {
      "action": "journalWait",
      "eventType": "turn_started",
      "newSinceBaseline": "before-automation-failure-run",
      "captureSessionAs": "automation-failure-session",
      "timeoutMs": 60000,
      "description": "以新 turn_started 绑定真实 Session，确认本次请求已实际派发"
    },
    {
      "action": "journalWait",
      "eventType": "turn_stopped",
      "reason": "failed",
      "newSinceBaseline": "before-automation-failure-run",
      "sessionEqualsCaptured": "automation-failure-session",
      "timeoutMs": 360000,
      "description": "等待真实 Provider 1ms 超时及默认 10 次尝试后同一 Session 的 failed TurnStopped"
    },
    {
      "action": "click",
      "selector": "[data-automation-id] [data-testid=\"automation-card-menu\"]",
      "description": "打开 automation 菜单读取手动失败历史"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"] [data-testid=\"automation-action-history\"]",
      "description": "从原生 UI 打开超时运行历史"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"automations-refresh\"]')",
      "timeoutMs": 30000,
      "description": "超时运行历史页面完成挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automations-refresh\"]",
      "description": "从 Rust 台账刷新超时运行历史"
    },
    {
      "action": "wait",
      "expression": "[...document.querySelectorAll('[data-testid^=\"automation-run-row-\"]')].some(row => /失败|Failure/.test(row.innerText))",
      "timeoutMs": 90000,
      "description": "历史行显示真实 run failed outcome"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"automation-edit-back\"]",
      "description": "返回 automation 列表核对 scheduler lifecycle"
    },
    {
      "action": "restart",
      "requestTimeoutMs": null,

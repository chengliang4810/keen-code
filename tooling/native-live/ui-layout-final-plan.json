  "acceptance": [
    "隔离 data 根启动并通过原始 onboarding/project/composer 流程进入设置页。",
    "在 1280x820、DPR1 下通过原始外观选择器选择 Zai 深色主题，截图和 appearanceLayout 必须来自真实 DOM/CSS。",
    "运行后使用 baseline.referenceDiff/comparisonScript 对齐共同外观卡片；记录结构化布局和局部像素 diff，不能省略截图或扩大比较范围。",
    "最终报告同时记录 runtime 的 dist tree、entry asset 和 native32 binary SHA-256；旧 attempt 仅作 reference，不冒充当前冻结32产物。"
  ],
  "steps": [
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"onboarding-page\"] footer > button') && !/主要工作方向|UI 模式|UI mode/.test(document.querySelector('[data-testid=\"onboarding-page\"]')?.innerText ?? \"\")",
      "description": "隔离新配置直接进入偏好页，无职业或模式选择"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"onboarding-page\"] footer > button",
      "description": "通过原生 UI 一次完成首次启动偏好"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"project-add\"]')",
      "description": "原生工作区完成启动"
    },
    {
      "action": "hover",
      "selector": "[data-testid=\"project-section\"]",
      "description": "真实悬停项目分区，显示 Source 原操作按钮"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"project-add\"]",
      "description": "打开原项目选择菜单"
    },
    {
      "action": "click",
      "selector": "[role=\"menuitem\"]",
      "description": "通过原界面选择隔离测试项目"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('[data-testid^=\"workspace-item-\"]')",
      "timeoutMs": 60000,
      "description": "本地项目激活后显示原 Composer"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"v4-composer-input\"]",
      "text": "NATIVE_SETTINGS_DRAFT_20261003",
      "description": "在真实 Composer 写入待保留草稿"
    },
    {
      "action": "assert",
      "expression": "document.querySelector('[data-testid=\"v4-composer-input\"]')?.textContent?.includes('NATIVE_SETTINGS_DRAFT_20261003') === true",
      "description": "设置操作前 Composer 草稿可见"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]",
      "description": "打开真实设置页"
    },
    {
      "action": "clickIf",
      "condition": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "selector": "[data-testid=\"sidebar-open-settings\"]",
      "description": "设置入口展开菜单时，再通过真实菜单项进入设置；返回工作区不执行此步"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"settings-page\"]')",
      "description": "设置页挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-section-nav-appearance\"]",
      "description": "打开外观设置"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"settings-page\"]')?.getAttribute('data-active-section') === 'appearance' && !!document.querySelector('[data-testid=\"settings-page\"][data-active-section=\"appearance\"] [data-slot=\"select-trigger\"]')",
      "description": "外观设置真实控件加载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-page\"][data-active-section=\"appearance\"] [data-slot=\"select-trigger\"]",
      "description": "打开主题选择器"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"select-item\"]:nth-child(2)",
      "description": "选择 Zai 深色主题"
    },
    {
      "action": "wait",
      "expression": "document.documentElement.classList.contains('dark') && document.documentElement.classList.contains('theme-zai-dark') && !document.documentElement.classList.contains('theme-zai-light')",
      "description": "深色主题真实应用到文档根"
    },
    {
      "action": "screenshot",
      "name": "01-settings-zai-dark"
    },
    {
      "action": "appearanceLayout",
      "description": "记录真实外观页DOM及CSS几何"
    }
  ],

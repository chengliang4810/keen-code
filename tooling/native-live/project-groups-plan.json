    },
    {
      "action": "assert",
      "expression": "(() => { const group = document.querySelector('[data-grouped-group-item-id]'); if (!group || !group.querySelector('[aria-label=\"Native Group 42\"]')) return false; const grouped = group.querySelectorAll('[data-grouped-task-key]').length; const top = [...document.querySelectorAll('[data-grouped-task-key]')].filter(e => !e.closest('[data-grouped-group-item-id]')).length; return grouped === 1 && top === 1; })()",

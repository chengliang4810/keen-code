{
  "name": "manual-feedback-coding-and-conversation-resources",
  "description": "不添加项目，使用真实默认 conversation、Rust RPC 和用户命令文件验证三项手工反馈。旧 office 值只写入隔离 WebView localStorage 后冷启动；不注入 store、IPC 或模拟服务。模型详情只断言控件，不截图凭据。",
  "providerId": "native-live-deepseek",
  "model": "deepseek-v4.1-flash",
  "steps": [
    {"action":"wait","expression":"!!document.querySelector('[data-testid=\"onboarding-page\"] footer > button')","description":"首次启动直接显示偏好页"},
    {"action":"assert","expression":"document.querySelector('[data-testid=\"onboarding-page\"]')?.innerText.includes('按需开启以下功能') && !/主要工作方向|UI 模式|办公模式/.test(document.querySelector('[data-testid=\"onboarding-page\"]')?.innerText ?? '')","description":"引导无职业和模式选择"},
    {"action":"screenshot","name":"onboarding-preferences"},
    {"action":"click","selector":"[data-testid=\"onboarding-page\"] footer > button","description":"一次跳过即可完成引导"},
    {"action":"wait","expression":"!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('[data-testid=\"task-settings-button\"]')","timeoutMs":60000,"description":"未添加项目的默认普通对话加载"},
    {"action":"click","selector":"[data-testid=\"task-settings-button\"]"},
    {
      "action": "clickIf",
      "condition": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "selector": "[data-testid=\"sidebar-open-settings\"]",
      "description": "设置入口展开菜单时，再通过真实菜单项进入设置；返回工作区不执行此步"
    },
    {"action":"wait","expression":"!!document.querySelector('[data-testid=\"settings-page\"]')"},
    {"action":"click","selector":"[data-testid=\"settings-section-nav-general\"]"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"]')?.dataset.activeSection === 'general'"},
    {"action":"assert","expression":"!/界面模式|办公模式/.test(document.querySelector('[data-testid=\"settings-page\"]')?.innerText ?? '')","description":"常规设置不再提供模式选择"},
    {"action":"screenshot","name":"general-coding-only"},
    {"action":"click","selector":"[data-testid=\"settings-section-nav-plugin\"]"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"]')?.dataset.activeSection === 'plugin' && !!document.querySelector('[data-testid=\"plugin-settings-add\"]') && document.body.innerText.includes('尚未安装插件')","description":"普通对话插件列表真实完成加载"},
    {"action":"assert","expression":"!document.body.innerText.includes('项目尚未添加')","description":"插件页没有项目登记错误"},
    {"action":"screenshot","name":"conversation-plugin-loaded"},
    {"action":"click","selector":"[data-testid=\"settings-section-nav-commands\"]"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"]')?.dataset.activeSection === 'commands' && document.body.innerText.includes('尚未安装命令')","description":"普通对话命令列表真实完成加载"},
    {"action":"assert","expression":"!document.body.innerText.includes('项目尚未添加')","description":"命令页没有项目登记错误"},
    {"action":"screenshot","name":"conversation-commands-loaded"},
    {"action":"clickText","text":"新建","selector":"[data-testid=\"settings-page\"] button"},
    {"action":"wait","expression":"!!document.querySelector('form input[placeholder=\"my-command\"]')"},
    {"action":"type","selector":"form input[placeholder=\"my-command\"]","text":"feedback-conversation-command"},
    {"action":"type","selector":"form textarea","text":"仅用于隔离验收的用户命令。"},
    {"action":"click","selector":"form button[type=\"submit\"]","description":"无登记项目时保存真实用户命令"},
    {"action":"wait","expression":"!document.querySelector('form input[placeholder=\"my-command\"]') && document.body.innerText.includes('feedback-conversation-command') && !document.body.innerText.includes('项目尚未添加')","description":"用户命令由真实 RPC 保存并回读"},
    {"action":"click","selector":"[data-testid=\"settings-section-nav-modelProvider\"]"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"]')?.dataset.activeSection === 'modelProvider' && !!document.querySelector('[data-testid=\"model-provider-nav-item-custom:native-live-deepseek\"]')"},
    {"action":"assert","expression":"![...document.querySelectorAll('[data-testid=\"settings-page\"] h3')].some(x => /内置供应商|自定义供应商/.test(x.textContent ?? ''))","description":"模型导航无两个供应商分组小标题"},
    {"action":"click","selector":"[data-testid=\"model-provider-nav-item-custom:native-live-deepseek\"]"},
    {"action":"wait","expression":"!!document.querySelector('[data-model-provider-model-id=\"deepseek-v4.1-flash\"]') && document.querySelector('[data-testid=\"model-provider-api-format-trigger\"]')?.textContent.includes('/chat/completions')","description":"自定义供应商和真实模型设置仍能加载，不截图敏感字段"},
    {"action":"setup","expression":"localStorage.setItem('zcode-interface-mode','office')","description":"为冷启动设置隔离旧版 office 偏好"},
    {"action":"restart","description":"同一隔离数据和 profile 冷启动"},
    {"action":"wait","expression":"!!document.querySelector('[data-testid=\"task-settings-button\"]') && !document.querySelector('[data-testid=\"onboarding-page\"]')","timeoutMs":60000,"description":"已完成引导不再次弹出"},
    {"action":"click","selector":"[data-testid=\"task-settings-button\"]"},
    {
      "action": "clickIf",
      "condition": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "selector": "[data-testid=\"sidebar-open-settings\"]",
      "description": "设置入口展开菜单时，再通过真实菜单项进入设置；返回工作区不执行此步"
    },
    {"action":"wait","expression":"!!document.querySelector('[data-testid=\"settings-page\"]')"},
    {"action":"click","selector":"[data-testid=\"settings-section-nav-general\"]"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"]')?.dataset.activeSection === 'general'"},
    {"action":"assert","expression":"!/界面模式|办公模式/.test(document.querySelector('[data-testid=\"settings-page\"]')?.innerText ?? '')","description":"旧 office 偏好不会恢复模式选择"},
    {"action":"click","selector":"[data-testid=\"settings-section-nav-plugin\"]"},
    {"action":"wait","expression":"document.body.innerText.includes('尚未安装插件') && !document.body.innerText.includes('项目尚未添加')","description":"冷恢复插件页无错误"},
    {"action":"click","selector":"[data-testid=\"settings-section-nav-commands\"]"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"]')?.dataset.activeSection === 'commands' && document.body.innerText.includes('feedback-conversation-command') && !document.body.innerText.includes('项目尚未添加')","description":"冷恢复真实用户命令"},
    {"action":"screenshot","name":"conversation-command-cold-restored"},
    {"action":"click","selector":"[data-testid=\"settings-page\"] [role=\"switch\"]","description":"普通对话上下文禁用用户命令"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"] [role=\"switch\"]')?.getAttribute('aria-checked') === 'false' && !document.body.innerText.includes('项目尚未添加')"},
    {"action":"click","selector":"[data-testid=\"settings-page\"] [role=\"switch\"]","description":"普通对话上下文重新启用用户命令"},
    {"action":"wait","expression":"document.querySelector('[data-testid=\"settings-page\"] [role=\"switch\"]')?.getAttribute('aria-checked') === 'true' && !document.body.innerText.includes('项目尚未添加')"},
    {"action":"clickText","text":"/feedback-conversation-command","selector":"[data-testid=\"settings-page\"] span"},
    {"action":"wait","expression":"!!document.querySelector('form input[placeholder=\"my-command\"]')"},
    {"action":"clickText","text":"删除","selector":"form button"},
    {"action":"wait","expression":"!!document.querySelector('[data-testid=\"confirm-dialog-confirm\"]')"},
    {"action":"click","selector":"[data-testid=\"confirm-dialog-confirm\"]","description":"真实确认删除隔离用户命令"},
    {"action":"wait","expression":"!document.querySelector('form input[placeholder=\"my-command\"]') && document.body.innerText.includes('尚未安装命令') && !document.body.innerText.includes('feedback-conversation-command') && !document.body.innerText.includes('项目尚未添加')","description":"用户命令删除后真实列表为空且无路径错误"}
  ]
}

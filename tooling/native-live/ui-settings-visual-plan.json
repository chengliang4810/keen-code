{
  "name": "native-live-ui-settings-visual",
  "description": "通过原生设置页控件验证 Zai 三种主题、中英文切换，以及设置导航前后的项目、Composer 草稿保留；不注入前端状态、不直接调用 RPC。工作流详情的阶段展开由 zcode-desktop-plan 覆盖。",
  "providerId": "native-live-deepseek",
  "model": "deepseek-v4.1-flash",
  "files": {
    "evidence.txt": "设置页视觉验收初始内容\n"
  },
  "steps": [
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"onboarding-page\"] footer > button') && !/主要工作方向|UI 模式|UI mode/.test(document.querySelector('[data-testid=\"onboarding-page\"]')?.innerText ?? \"\")",
      "description": "隔离新配置直接进入偏好页，无职业或模式选择"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"onboarding-page\"] footer > button",
      "description": "通过原生 UI 一次完成首次启动偏好"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"project-add\"]')",
      "description": "原生工作区完成启动"
    },
    {
      "action": "hover",
      "selector": "[data-testid=\"project-section\"]",
      "description": "真实悬停项目分区，显示 Source 原操作按钮"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"project-add\"]",
      "description": "打开原项目选择菜单"
    },
    {
      "action": "click",
      "selector": "[role=\"menuitem\"]",
      "description": "通过原界面选择隔离测试项目"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('[data-testid^=\"workspace-item-\"]')",
      "timeoutMs": 60000,
      "description": "本地项目激活后显示原 Composer"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"v4-composer-input\"]",
      "text": "NATIVE_SETTINGS_DRAFT_20261003",
      "description": "在真实 Composer 写入待保留草稿"
    },
    {
      "action": "assert",
      "expression": "document.querySelector('[data-testid=\"v4-composer-input\"]')?.textContent?.includes('NATIVE_SETTINGS_DRAFT_20261003') === true",
      "description": "设置操作前 Composer 草稿可见"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]",
      "description": "打开真实设置页"
    },
    {
      "action": "clickIf",
      "condition": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "selector": "[data-testid=\"sidebar-open-settings\"]",
      "description": "设置入口展开菜单时，再通过真实菜单项进入设置；返回工作区不执行此步"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"settings-page\"]')",
      "description": "设置页挂载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-section-nav-appearance\"]",
      "description": "打开外观设置"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"settings-page\"]')?.getAttribute('data-active-section') === 'appearance' && !!document.querySelector('[data-testid=\"settings-page\"][data-active-section=\"appearance\"] [data-slot=\"select-trigger\"]')",
      "description": "外观设置真实控件加载"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-page\"][data-active-section=\"appearance\"] [data-slot=\"select-trigger\"]",
      "description": "打开主题选择器"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"select-item\"]:nth-child(2)",
      "description": "选择 Zai 深色主题"
    },
    {
      "action": "wait",
      "expression": "document.documentElement.classList.contains('dark') && document.documentElement.classList.contains('theme-zai-dark') && !document.documentElement.classList.contains('theme-zai-light')",
      "description": "深色主题真实应用到文档根"
    },
    {
      "action": "screenshot",
      "name": "01-settings-zai-dark"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-page\"][data-active-section=\"appearance\"] [data-slot=\"select-trigger\"]",
      "description": "重新打开主题选择器"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"select-item\"]:nth-child(3)",
      "description": "选择 Zai 浅色主题"
    },
    {
      "action": "wait",
      "expression": "!document.documentElement.classList.contains('dark') && document.documentElement.classList.contains('theme-zai-light') && !document.documentElement.classList.contains('theme-zai-dark')",
      "description": "浅色主题真实应用到文档根"
    },
    {
      "action": "screenshot",
      "name": "02-settings-zai-light"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-page\"][data-active-section=\"appearance\"] [data-slot=\"select-trigger\"]",
      "description": "重新打开主题选择器"
    },
    {
      "action": "click",
      "selector": "[data-slot=\"select-item\"]:nth-child(1)",
      "description": "选择跟随系统主题"
    },
    {
      "action": "wait",
      "expression": "(() => { const root = document.documentElement; const dark = root.classList.contains('dark'); const zaiDark = root.classList.contains('theme-zai-dark'); const zaiLight = root.classList.contains('theme-zai-light'); return (dark === zaiDark) && (zaiDark !== zaiLight); })()",
      "description": "系统主题按当前系统偏好解析且只保留一个 Zai 主题类"
    },
    {
      "action": "screenshot",
      "name": "03-settings-system"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-back-button\"]",
      "description": "返回工作区并保留 Composer"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && document.querySelector('[data-testid=\"v4-composer-input\"]')?.textContent?.includes('NATIVE_SETTINGS_DRAFT_20261003') && !!document.querySelector('[data-testid^=\"workspace-item-\"]')",
      "timeoutMs": 30000,
      "description": "主题切换与设置导航不丢失项目和 Composer 草稿"
    },
    {
      "action": "click",
      "selector": "button[aria-label=\"KeenCode\"]",
      "description": "打开共享设置菜单"
    },
    {
      "action": "clickText",
      "selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"] [data-slot=\"dropdown-menu-sub-trigger\"]",
      "text": [
        "界面语言",
        "Language"
      ],
      "exact": true,
      "description": "打开语言子菜单（绑定原控件文字，避免命中主题子菜单）"
    },
    {
      "action": "clickText",
      "selector": "[data-slot=\"dropdown-menu-sub-content\"][data-state=\"open\"] [data-slot=\"dropdown-menu-radio-item\"]",
      "text": "English",
      "exact": true,
      "description": "切换到英文界面"
    },
    {
      "action": "key",
      "key": "Enter",
      "description": "通过原菜单键盘语义确认当前语言条目"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"task-settings-button\"]')?.getAttribute('aria-label') === 'Settings' && document.querySelector('[data-testid=\"v4-composer-input\"]')?.textContent?.includes('NATIVE_SETTINGS_DRAFT_20261003')",
      "timeoutMs": 30000,
      "description": "英文界面刷新且草稿仍在"
    },
    {
      "action": "screenshot",
      "name": "04-settings-locale-en-draft"
    },
    {
      "action": "click",
      "selector": "button[aria-label=\"KeenCode\"]",
      "description": "重新打开共享设置菜单"
    },
    {
      "action": "clickText",
      "selector": "[data-slot=\"dropdown-menu-content\"][data-state=\"open\"] [data-slot=\"dropdown-menu-sub-trigger\"]",
      "text": [
        "界面语言",
        "Language"
      ],
      "exact": true,
      "description": "重新打开语言子菜单（绑定原控件文字，避免命中主题子菜单）"
    },
    {
      "action": "clickText",
      "selector": "[data-slot=\"dropdown-menu-sub-content\"][data-state=\"open\"] [data-slot=\"dropdown-menu-radio-item\"]",
      "text": "中文简体",
      "exact": true,
      "description": "切回中文界面"
    },
    {
      "action": "key",
      "key": "Enter",
      "description": "通过原菜单键盘语义确认当前语言条目"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"task-settings-button\"]')?.getAttribute('aria-label') === '设置' && document.querySelector('[data-testid=\"v4-composer-input\"]')?.textContent?.includes('NATIVE_SETTINGS_DRAFT_20261003')",
      "timeoutMs": 30000,
      "description": "中文界面刷新且草稿仍在"
    },
    {
      "action": "screenshot",
      "name": "05-settings-locale-zh-draft"
    },
    {
      "action": "restart",
      "description": "重启隔离桌面进程验证设置持久化"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && document.querySelector('[data-testid=\"v4-composer-input\"]')?.textContent?.includes('NATIVE_SETTINGS_DRAFT_20261003') && !!document.querySelector('[data-testid^=\"workspace-item-\"]')",
      "timeoutMs": 60000,
      "description": "重启后本地项目、中文偏好和未发送草稿仍由真实本地状态恢复"
    },
    {
      "action": "assert",
      "expression": "document.querySelector('[data-testid=\"task-settings-button\"]')?.getAttribute('aria-label') === '设置'",
      "description": "重启后语言偏好仍保持中文"
    },
    {
      "action": "screenshot",
      "name": "06-settings-retained-after-restart"
    }
  ],
  "onboardingRevision": "2026-10-04 preferences-only；历史报告和执行快照保持不变，当前计划需重新执行方可认定通过。"
}

{
  "name": "sidebar-settings-menu",
  "description": "仅用真实原生 UI 验证设置入口、主题、语言、缩放、返回、草稿与冷启动。不发送模型请求。",
  "providerId": "native-live-deepseek",
  "model": "deepseek-v4.1-flash",
  "steps": [
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"onboarding-page\"] footer > button')",
      "timeoutMs": 60000
    },
    {
      "action": "click",
      "selector": "[data-testid=\"onboarding-page\"] footer > button"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('footer [data-testid=\"task-settings-button\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "type",
      "selector": "[data-testid=\"v4-composer-input\"]",
      "text": "SIDEBAR_SETTINGS_DRAFT_20261004"
    },
    {
      "action": "assert",
      "expression": "(() => { const b=document.querySelector('footer [data-testid=\"task-settings-button\"]');const f=b?.closest(\"footer\");return !!f && f.querySelectorAll(\"button\").length===1 && b.textContent.trim()===\"设置\" && !!b.querySelector(\"svg.lucide-settings\") && !!b.querySelector(\"svg.lucide-chevron-down\") && !f.querySelector(\"svg.lucide-user\") && !f.textContent.includes(\"KeenCode\"); })()",
      "description": "单一设置入口，移除头像、用户名和重复按钮"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "assert",
      "expression": "(() => { const m=document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]');const items=Array.from(m.querySelectorAll('[role=\"menuitem\"]'));return items.map(e=>e.textContent.trim()).join(\"|\")===\"打开设置|界面主题|界面语言|界面缩放\" && !!m.querySelector('[role=\"separator\"]'); })()",
      "description": "菜单首项打开设置，分组保留主题、语言、缩放"
    },
    {
      "action": "wait",
      "expression": "(() => {const menu=document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]');return !!menu && getComputedStyle(menu).opacity === \"1\" && menu.getAnimations().every(animation => animation.playState !== \"running\");})()",
      "description": "等待原菜单淡入完成后截取稳定画面"
    },
    {
      "action": "screenshot",
      "name": "workspace-settings-menu"
    },
    {
      "action": "key",
      "key": "Escape"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('footer [data-testid=\"task-settings-button\"]')?.getAttribute(\"aria-expanded\")===\"false\"",
      "timeoutMs": 60000
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "clickText",
      "selector": "[data-testid=\"sidebar-settings-menu\"] [role=\"menuitem\"]",
      "text": "界面主题"
    },
    {
      "action": "clickText",
      "selector": "[role=\"menuitemradio\"]",
      "text": "浅色主题"
    },
    {
      "action": "wait",
      "expression": "document.documentElement.classList.contains(\"theme-zai-light\") && !document.documentElement.classList.contains(\"dark\")",
      "timeoutMs": 60000,
      "description": "真实菜单切换浅色主题"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "clickText",
      "selector": "[data-testid=\"sidebar-settings-menu\"] [role=\"menuitem\"]",
      "text": "界面语言"
    },
    {
      "action": "clickText",
      "selector": "[role=\"menuitemradio\"]",
      "text": "English"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('footer [data-testid=\"task-settings-button\"]')?.getAttribute(\"aria-label\")===\"Settings\"",
      "timeoutMs": 60000,
      "description": "真实菜单切换英文"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "clickText",
      "selector": "[data-testid=\"sidebar-settings-menu\"] [role=\"menuitem\"]",
      "text": "App theme"
    },
    {
      "action": "clickText",
      "selector": "[role=\"menuitemradio\"]",
      "text": "Dark theme"
    },
    {
      "action": "wait",
      "expression": "document.documentElement.classList.contains(\"theme-zai-dark\") && document.documentElement.classList.contains(\"dark\")",
      "timeoutMs": 60000,
      "description": "真实菜单切换深色主题"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "clickText",
      "selector": "[data-testid=\"sidebar-settings-menu\"] [role=\"menuitem\"]",
      "text": "Language"
    },
    {
      "action": "clickText",
      "selector": "[role=\"menuitemradio\"]",
      "text": "中文简体"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('footer [data-testid=\"task-settings-button\"]')?.getAttribute(\"aria-label\")===\"设置\"",
      "timeoutMs": 60000,
      "description": "真实菜单切回中文"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "clickText",
      "selector": "[data-testid=\"sidebar-settings-menu\"] [role=\"menuitem\"]",
      "text": "界面缩放"
    },
    {
      "action": "clickText",
      "selector": "[role=\"menuitem\"]",
      "texts": [
        "放大",
        "Zoom in"
      ],
      "exact": false
    },
    {
      "action": "wait",
      "expression": "(async()=> (await window.__TAURI_INTERNALS__.invoke(\"desktop_zoom_level\")).zoomLevel===1)()",
      "timeoutMs": 60000,
      "description": "真实缩放菜单生效，读取 Rust 原生状态确认"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "click",
      "selector": "[data-testid=\"sidebar-open-settings\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"settings-page\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "assert",
      "expression": "(() => {const b=document.querySelector('[data-testid=\"settings-page\"] footer [data-testid=\"task-settings-button\"]');const f=b?.closest(\"footer\");return !!f && f.querySelectorAll(\"button\").length===2 && b.getAttribute(\"aria-label\")===\"返回工作区\" && !!b.querySelector(\"svg.lucide-arrow-left\") && !b.querySelector(\"svg.lucide-settings\") && !!f.querySelector('[data-testid=\"sidebar-settings-menu-trigger\"]');})()",
      "description": "设置页独立返回箭头与共享设置菜单"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"sidebar-settings-menu-trigger\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "assert",
      "expression": "document.querySelector('[data-testid=\"sidebar-open-settings\"]')?.getAttribute(\"aria-disabled\")===\"true\" && !!document.querySelector('[data-testid=\"settings-page\"]')",
      "description": "设置页打开设置项禁用，不误调用返回回调"
    },
    {
      "action": "wait",
      "expression": "(() => {const menu=document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]');return !!menu && getComputedStyle(menu).opacity === \"1\" && menu.getAnimations().every(animation => animation.playState !== \"running\");})()",
      "description": "等待原菜单淡入完成后截取稳定画面"
    },
    {
      "action": "screenshot",
      "name": "settings-page-preferences-menu"
    },
    {
      "action": "clickText",
      "selector": "[data-testid=\"sidebar-settings-menu\"] [role=\"menuitem\"]",
      "text": "界面缩放"
    },
    {
      "action": "clickText",
      "selector": "[role=\"menuitem\"]",
      "texts": [
        "实际大小",
        "Actual size"
      ],
      "exact": false
    },
    {
      "action": "wait",
      "expression": "(async()=> (await window.__TAURI_INTERNALS__.invoke(\"desktop_zoom_level\")).zoomLevel===0)()",
      "timeoutMs": 60000,
      "description": "设置页快捷缩放恢复默认"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-page\"] footer [data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!document.querySelector('[data-testid=\"settings-page\"]') && document.querySelector('[data-testid=\"v4-composer-input\"]')?.textContent.includes(\"SIDEBAR_SETTINGS_DRAFT_20261004\")",
      "timeoutMs": 60000,
      "description": "返回工作区并保留 Composer 草稿"
    },
    {
      "action": "screenshot",
      "name": "workspace-settings-entry-dark"
    },
    {
      "action": "restart"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('footer [data-testid=\"task-settings-button\"]') && !document.querySelector('[data-testid=\"onboarding-page\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "assert",
      "expression": "document.querySelector('footer [data-testid=\"task-settings-button\"]')?.getAttribute(\"aria-label\")===\"设置\" && document.documentElement.classList.contains(\"theme-zai-dark\")",
      "description": "冷启动保留中文与深色偏好"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"sidebar-settings-menu\"][data-state=\"open\"]')",
      "timeoutMs": 60000
    },
    {
      "action": "clickText",
      "selector": "[data-testid=\"sidebar-settings-menu\"] [role=\"menuitem\"]",
      "text": "界面主题"
    },
    {
      "action": "assert",
      "expression": "Array.from(document.querySelectorAll('[role=\"menuitemradio\"][aria-checked=\"true\"]')).some(e=>e.textContent.trim()===\"深色主题\")",
      "description": "冷启动后菜单选中项与持久化主题一致"
    },
    {
      "action": "key",
      "key": "Escape"
    },
    {
      "action": "key",
      "key": "Escape"
    }
  ]
}

{
  "name": "native-live-error-retry-hook",
  "description": "使用隔离项目和 exact deepseek-v4.1-flash 真实模型验证 workspace Hook 的待审核 banner、Trust、摘要变更回退；同时通过隔离 native runner 入口验证 provider 请求超时、真实网络错误重试与恢复。",
  "acceptanceStatus": "pending",
  "acceptanceBoundary": {
    "retry": {
      "status": "pending_isolated_native_timeout_entry",
      "reason": "产品 Model Provider 设置不新增 timeout 控件；本计划使用授权的 native runner 测试入口，仅在隔离进程为 RuntimeProviderConfig 注入 1ms 或 null 默认值。该入口不改变产品 UI，也不修改用户真实配置。",
      "runnerContract": {
        "restartField": "requestTimeoutMs",
        "shortTimeoutMs": 1,
        "restoreValue": null,
        "allowedRangeMs": "1..300000",
        "isolationEnv": "KEENCODE_NATIVE_PROVIDER_TIMEOUT_MS",
        "cliOption": "--request-timeout-ms"
      },
      "modelFailureBridge": {
        "status": "pending_until_rpcagent_source_freeze",
        "requiredFact": "AgentStreamEventKind::ModelFailure must reach the active Runtime bridge for this captured UI turn before native evidence can be accepted"
      },
      "requiredEvidence": [
        "短 timeout 只由隔离 native runner 注入并在同一隔离根以 null 恢复默认",
        "exact deepseek-v4.1-flash 真实请求产生真实失败 Journal/投影",
        "第 3 次重试起出现 [data-zcode-chat-loading-slot=\"true\"] 中的重新连接计数",
        "[data-testid=\"chat-error-banner\"] 的 data-error-code 与失败事实对应",
        "同一 captured task/session 的 fresh Turn 产生 turn_completed，清除旧错误并完成真实回复",
        "同一新 Turn 的 AgentStreamEventKind::ModelFailure 进入真实失败投影；新 Runtime bridge 需在 RpcAgent source freeze 后提供证据，不能由业务 RPC 写入",
        "retry 的 model_retry_scheduled 是同一 UI connection 的临时 ACP 事实，最终失败以同一 session 的 turn_stopped(reason=failed) Journal 为权威"
      ],
      "forbiddenSubstitutions": [
        "新增或伪造产品 Model Provider timeout 控件",
        "HookForm 的 timeout 或 MCP timeoutMs",
        "未授权的 benchmark request.timeout_ms 或非隔离环境变量",
        "业务 RPC/Journal 直接写入 retry 或 lastError",
        "拦截网络并伪造成功响应",
        "切换模型或写入用户现有配置"
      ]
    },
    "hook": {
      "status": "planned_pending_native_run",
      "bannerSelector": "[data-testid=\"v4-workspace-hook-pending-banner\"]",
      "trustNoticeSelector": "[data-testid=\"workspace-hook-trust-notice\"]",
      "fixtureScope": "isolated project files only"
    }
  },
  "retryCase": {
    "status": "pending_native_runner_and_binary",
    "runnerActionSupport": "The root runner will accept requestTimeoutMs on restart steps and --request-timeout-ms for the isolated provider path; this plan must not be run before that support is present.",
    "steps": [
      {
        "id": "retry.set-short-timeout",
        "action": "restart",
        "requestTimeoutMs": 1,
        "evidence": "Isolated RuntimeProviderConfig.request_timeout only"
      },
      {
        "id": "retry.send-real-request",
        "action": "openCapturedTask-and-real-model-request",
        "model": "deepseek-v4.1-flash",
        "evidence": "Same captured task/session, no network interception or synthetic response"
      },
      {
        "id": "retry.observe",
        "action": "observe-ui-and-journal",
        "assertions": [
          "apiRetry attempt >= 3 is visible in the real loading slot",
          "chat-error-banner is visible with the actual failure code",
          "model_retry_scheduled belongs to the same UI connection and turn",
          "same-session Journal turn_stopped with reason failed is the authoritative final failure"
        ]
      },
      {
        "id": "retry.restore-timeout",
        "action": "restart",
        "requestTimeoutMs": null,
        "evidence": "Isolated RuntimeProviderConfig.request_timeout restored to default"
      },
      {
        "id": "retry.fresh-turn-clears-error",
        "action": "openCapturedTask-and-fresh-real-model-request",
        "model": "deepseek-v4.1-flash",
        "assertions": [
          "same captured task/session is opened through the UI",
          "new successful turn produces authoritative turn_completed",
          "old chat-error-banner is not projected after the fresh turn",
          "no synthetic success or direct state mutation"
        ]
      }
    ]
  },
  "sourceEvidence": [
    {
      "path": "packages/ui/src/v4/SessionPane.tsx",
      "lines": "3374-3382,3464-3500,3543-3549,3746",
      "fact": "control.lastError feeds Composer error, workspaceHookAdmission renders the pending banner, and apiRetry is passed to ConversationTimeline."
    },
    {
      "path": "packages/ui/src/ChatErrorBanner.tsx",
      "lines": "167-168",
      "fact": "The real failure banner is data-testid=chat-error-banner with data-error-code."
    },
    {
      "path": "packages/ui/src/v4/ConversationTurnGroup.tsx",
      "lines": "122,147-157",
      "fact": "Retry text is intentionally visible only from attempt 3 and is rendered in data-zcode-chat-loading-slot."
    },
    {
      "path": "packages/ui/src/v4/WorkspaceHookPendingBanner.tsx",
      "lines": "142-163",
      "fact": "The pending Hook banner and review/dismiss controls have stable test IDs."
    },
    {
      "path": "core/provider/src/config.rs",
      "lines": "216-232,321-322",
      "fact": "Provider request_timeout/read_timeout are Rust config fields with defaults; the product UI has no timeout control, so the authorized runner-only override must remain isolated."
    },
    {
      "path": "apps/desktop/src/providers.rs",
      "fact": "The authorized test-only provider path applies KEENCODE_NATIVE_PROVIDER_TIMEOUT_MS to RuntimeProviderConfig; it must not enter normal user configuration or product UI."
    },
    {
      "path": "core/acp/src/event.rs",
      "lines": "810-818,1023-1041",
      "fact": "model_retry_scheduled is a transient ACP delivery fact; it has no Journal sequence. Final same-session turn_stopped with reason failed is the authoritative Journal failure fact."
    },
    {
      "path": "core/agent/src/event.rs",
      "lines": "677-680",
      "fact": "ModelFailure exists in AgentStreamEvent; delivery through the Runtime's new bridge remains pending until RpcAgent provides a source-frozen contract."
    },
    {
      "path": "apps/desktop/src/frontend_rpc/session.rs",
      "lines": "5350-5370",
      "fact": "A projection handler exists for AgentStreamEventKind::ModelFailure, but native evidence remains pending until the Runtime bridge/source freeze proves this is the active path."
    },
    {
      "path": "core/resources/src/types.rs",
      "lines": "55-83,1221-1232",
      "fact": "The Journal event is turn_stopped with reason failed; TurnStopReason uses snake_case serde, so the exact matcher is reason=failed."
    }
  ],
  "providerId": "native-live-deepseek",
  "model": "deepseek-v4.1-flash",
  "files": {
    "hook-trust-marker.txt": "HOOK_TRUST_UNTOUCHED_20261003\n",

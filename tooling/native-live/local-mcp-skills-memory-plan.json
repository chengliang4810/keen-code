{
  "name": "native-live-local-mcp-skills-memory",
  "description": "独立验证保留的本地 MCP、Skills、Memory UI；覆盖 user/workspace Skill scope 隔离、真实 Skill mention/tool 消费、MCP/Skill 删除和 Memory 启用状态的冷重启回读。Skills scope 只决定 catalog 目录，不改变活动 Composer；mention 前通过项目行真实新建 project draft，避免把 project Skill 误测为内部 conversation workspace。沿用原生引导、工作区、模型和 PTY 夹具步骤，跳过 local-features 的浏览器段。",
  "providerId": "native-live-deepseek",
  "model": "deepseek-v4.1-flash",
  "files": {
    "evidence.txt": "原生验收初始内容\n",
    "mcp-fixture.ps1": "param(\n  [Parameter(Mandatory = $true)]\n  [string]$IsolatedProject\n)\n\n# This fixture is deliberately stdio-only: every response is a single JSON-RPC line.\nSet-StrictMode -Version Latest\n$root = [IO.Path]::GetFullPath($IsolatedProject)\nif (-not (Test-Path -LiteralPath $root -PathType Container)) {\n  throw \"isolated project does not exist\"\n}\n$rootPrefix = if ($root.EndsWith([IO.Path]::DirectorySeparatorChar) -or $root.EndsWith([IO.Path]::AltDirectorySeparatorChar)) {\n  $root\n} else {\n  $root + [IO.Path]::DirectorySeparatorChar\n}\n$evidence = [IO.Path]::GetFullPath((Join-Path $root \"evidence.txt\"))\nif (-not $evidence.StartsWith($rootPrefix, [StringComparison]::OrdinalIgnoreCase)) {\n  throw \"evidence path escapes isolated project\"\n}\n\nfunction Write-RpcResponse([object]$Response) {\n  $json = $Response | ConvertTo-Json -Depth 12 -Compress\n  [Console]::Out.WriteLine($json)\n  [Console]::Out.Flush()\n}\n\nfunction New-RpcError([object]$Id, [int]$Code, [string]$Message) {\n  return [ordered]@{\n    jsonrpc = \"2.0\"\n    id = $Id\n    error = [ordered]@{ code = $Code; message = $Message }\n  }\n}\n\nfunction New-ToolsListResult {\n  return [ordered]@{\n    tools = @(\n      [ordered]@{\n        name = \"read_evidence\"\n        description = \"Read the evidence.txt file inside the isolated project.\"\n        inputSchema = [ordered]@{\n          type = \"object\"\n          properties = [ordered]@{}\n          required = @()\n          additionalProperties = $false\n        }\n        annotations = [ordered]@{ readOnlyHint = $true }\n      }\n    )\n  }\n}\n\nwhile ($null -ne ($line = [Console]::In.ReadLine())) {\n  if ([string]::IsNullOrWhiteSpace($line)) { continue }\n  $request = $null\n  $id = $null\n  try {\n    $request = $line | ConvertFrom-Json\n    $hasId = $request.PSObject.Properties.Name -contains \"id\"\n    if ($hasId) { $id = $request.id }\n    $method = [string]$request.method\n    if (-not $hasId) {\n      # Notifications, including notifications/initialized, have no response.\n      continue\n    }\n\n    $result = switch ($method) {\n      \"initialize\" {\n        [ordered]@{\n          protocolVersion = \"2025-11-25\"\n          capabilities = [ordered]@{ tools = [ordered]@{} }\n          serverInfo = [ordered]@{ name = \"keencode-native-fixture\"; version = \"1.0.0\" }\n        }\n        break\n      }\n      \"ping\" {\n        [ordered]@{}\n        break\n      }\n      \"tools/list\" {\n        New-ToolsListResult\n        break\n      }\n      \"tools/call\" {\n        $params = $request.params\n        if ($null -eq $params -or [string]$params.name -ne \"read_evidence\") {\n          throw [System.ArgumentException]::new(\"unknown MCP tool\")\n        }\n        $arguments = $params.arguments\n        if ($null -ne $arguments -and @($arguments.PSObject.Properties).Count -gt 0) {\n          throw [System.ArgumentException]::new(\"read_evidence does not accept a path or other arguments\")\n        }\n        $text = [IO.File]::ReadAllText($evidence)\n        [ordered]@{\n          content = @([ordered]@{ type = \"text\"; text = $text })\n          isError = $false\n        }\n        break\n      }\n      default {\n        throw [System.NotSupportedException]::new(\"unsupported MCP method\")\n      }\n    }\n    Write-RpcResponse ([ordered]@{ jsonrpc = \"2.0\"; id = $id; result = $result })\n  } catch [System.ArgumentException] {\n    Write-RpcResponse (New-RpcError $id -32602 $_.Exception.Message)\n  } catch [System.NotSupportedException] {\n    Write-RpcResponse (New-RpcError $id -32601 $_.Exception.Message)\n  } catch {\n    Write-RpcResponse (New-RpcError $id -32603 \"MCP fixture request failed\")\n  }\n}\n"
  },
  "steps": [
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"onboarding-page\"] footer > button') && !/主要工作方向|UI 模式|UI mode/.test(document.querySelector('[data-testid=\"onboarding-page\"]')?.innerText ?? \"\")",
      "description": "隔离新配置直接进入偏好页，无职业或模式选择"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"onboarding-page\"] footer > button",
      "description": "通过原生 UI 一次完成首次启动偏好"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"project-add\"]')",
      "description": "原生工作区完成启动"
    },
    {
      "action": "hover",
      "selector": "[data-testid=\"project-section\"]",
      "description": "真实悬停项目分区，显示 Source 原操作按钮"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"project-add\"]",
      "description": "打开项目菜单"
    },
    {
      "action": "click",
      "selector": "[role=\"menuitem\"]",
      "description": "从原生菜单选择本次隔离项目"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]')",
      "timeoutMs": 45000,
      "description": "项目会话和 Composer 由真实桌面 UI 建立"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid^=\"workspace-item-\"]') && !document.querySelector('[data-testid=\"composer-workspace-trigger\"]')?.textContent?.includes('选择项目')",
      "timeoutMs": 30000,
      "description": "项目选择完成后真实 workspace 行挂载并绑定 Composer"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"chat-model-select-trigger\"]",
      "description": "打开聊天模型选择器"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-model-provider-key=\"registry-provider:native-live-deepseek\"]')",
      "timeoutMs": 30000,
      "description": "等待隔离 provider 分组真实挂载"
    },
    {
      "action": "click",
      "selector": "[data-model-provider-key=\"registry-provider:native-live-deepseek\"]",
      "description": "展开真实 Deepseek provider 分组"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"chat-model-select-item-custom:native-live-deepseek:deepseek-v4.1-flash\"]')",
      "timeoutMs": 30000,
      "description": "等待自定义 provider 的完整模型 ID"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"chat-model-select-item-custom:native-live-deepseek:deepseek-v4.1-flash\"]",
      "description": "通过原生菜单选择配置模型"
    },
    {
      "action": "clickIf",
      "condition": "!!document.querySelector('[data-model-provider-key=\"registry-provider:native-live-deepseek\"]')",
      "selector": "[data-testid=\"chat-model-select-trigger\"]",
      "description": "若模型菜单仍保持打开，通过真实触发器关闭菜单"
    },
    {
      "action": "wait",
      "expression": "(() => { const input = document.querySelector('[data-testid=\"v4-composer-input\"]'); const rect = input?.getBoundingClientRect(); return document.querySelector('[data-testid=\"chat-model-select-trigger\"]')?.textContent?.includes('deepseek-v4.1-flash') && !document.querySelector('[data-model-provider-key=\"registry-provider:native-live-deepseek\"]') && !!input && !input.closest('[aria-hidden=\"true\"]') && !!rect && rect.width > 0 && rect.height > 0; })()",
      "timeoutMs": 30000,
      "description": "等待模型选择结果回写聊天工具栏"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"v4-composer-input\"]",
      "text": "native-live-readiness",
      "description": "在真实 Composer 输入就绪文本以验证发送入口状态"
    },
    {
      "action": "wait",
      "expression": "(() => { const input = document.querySelector('[data-testid=\"v4-composer-input\"]'); const rect = input?.getBoundingClientRect(); const send = document.querySelector('[data-testid=\"v4-composer-send\"]'); return document.querySelector('[data-testid=\"chat-model-select-trigger\"]')?.textContent?.includes('deepseek-v4.1-flash') && !document.querySelector('[data-model-provider-key=\"registry-provider:native-live-deepseek\"]') && !!input && !input.closest('[aria-hidden=\"true\"]') && !!rect && rect.width > 0 && rect.height > 0 && !!send && !send.hasAttribute('disabled'); })()",
      "timeoutMs": 30000,
      "description": "模型已选定且真实发送控件进入可用状态"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"terminal-toggle\"]",
      "description": "打开真实 workspace PTY"
    },
    {
      "action": "wait",
      "expression": "(() => { const e = document.querySelector('[data-testid=\"terminal\"] .xterm-screen'); if (!e) return false; const r = e.getBoundingClientRect(); return r.width > 0 && r.height > 0; })()",
      "timeoutMs": 30000,
      "description": "PTY 输入面真实挂载"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"terminal\"]')?.innerText.includes('PS ')",
      "timeoutMs": 30000,
      "description": "等待 PowerShell 真实提示符和 PTY 输入就绪"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"terminal\"] .xterm-screen",
      "text": "echo NATIVE_PTY_ECHO_OK",
      "description": "向真实 PTY 写入回显命令"
    },
    {
      "action": "key",
      "key": "Enter",
      "description": "执行 PTY 回显命令"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"terminal\"]')?.innerText.includes('NATIVE_PTY_ECHO_OK')",
      "timeoutMs": 30000,
      "description": "收到真实 PTY 输出"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"terminal\"] .xterm-screen",
      "text": "powershell -NoProfile -Command \"Set-Content -LiteralPath '${PROJECT}\\evidence.txt' -Value 'NATIVE_FILE_SAVED_OK' -Encoding utf8 -ErrorAction Stop; if ((Get-Content -LiteralPath '${PROJECT}\\evidence.txt' -Raw) -notmatch 'NATIVE_FILE_SAVED_OK') { throw 'file content verification failed' }; Write-Output NATIVE_FILE_SAVED\"",
      "description": "用真实本地 UI 操作修改文件，覆盖当前没有内置编辑器的路径"
    },
    {
      "action": "key",
      "key": "Enter",
      "description": "保存真实磁盘文件"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"terminal\"]')?.innerText.includes('NATIVE_FILE_SAVED')",
      "timeoutMs": 30000,
      "description": "确认 PTY 写文件命令完成"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"terminal\"] .xterm-screen",
      "text": "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force -Path '${PROJECT}\\.agents\\skills\\native-live-fixture' -ErrorAction Stop | Out-Null; Set-Content -LiteralPath '${PROJECT}\\.agents\\skills\\native-live-fixture\\SKILL.md' -Value @('---','name: native-live-fixture','description: Local native acceptance fixture','---','# Native skill fixture','When invoked, use the Skill tool and reply exactly NATIVE_SKILL_CONSUMED_41.') -Encoding utf8 -ErrorAction Stop; New-Item -ItemType Directory -Force -Path '${DATA}\\skills\\native-user-fixture' -ErrorAction Stop | Out-Null; Set-Content -LiteralPath '${DATA}\\skills\\native-user-fixture\\SKILL.md' -Value @('---','name: native-user-fixture','description: Local user-scope native acceptance fixture','---','# Native user skill fixture','When invoked, use the Skill tool and reply exactly NATIVE_USER_SKILL_CONSUMED_41.') -Encoding utf8 -ErrorAction Stop; New-Item -ItemType Directory -Force -Path '${DATA}\\memories' -ErrorAction Stop | Out-Null; Set-Content -LiteralPath '${DATA}\\memories\\NATIVE_MEMORY.md' -Value '# Native memory fixture' -Encoding utf8 -ErrorAction Stop; if (-not (Test-Path '${PROJECT}\\.agents\\skills\\native-live-fixture\\SKILL.md')) { throw 'workspace skill fixture missing' }; if (-not (Test-Path '${DATA}\\skills\\native-user-fixture\\SKILL.md')) { throw 'user skill fixture missing' }; if (-not (Test-Path '${DATA}\\memories\\NATIVE_MEMORY.md')) { throw 'memory fixture missing' }; Write-Output NATIVE_LOCAL_RESOURCES_CREATED\"",
      "description": "通过真实隔离 PTY 创建本地 Skill 和 Memory 夹具"
    },
    {
      "action": "key",
      "key": "Enter",
      "description": "执行本地资源创建"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"terminal\"]')?.innerText.includes('NATIVE_LOCAL_RESOURCES_CREATED')",
      "timeoutMs": 30000,
      "description": "确认 Skill/Memory 文件已落到本次隔离根"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"task-settings-button\"]",
      "description": "进入本地设置页"

      "selector": "[data-testid=\"v4-composer-input\"]",
      "text": "只完成本地 MCP 读取验收。必须调用已连接的 native-local-mcp Server 的 read_evidence 工具，读取当前隔离项目 evidence.txt。禁止使用 Bash、Read、Edit、Write 或其他直接文件工具，也不要猜测内容。工具返回后，只回复 NATIVE_MCP_CALL_OK_41，并逐字包含返回正文 NATIVE_FILE_SAVED_OK。",
      "description": "要求真实模型只通过隔离 MCP 读取证据文件"
    },
    {
      "action": "journalBaseline",
      "name": "before-mcp-tools-call",
      "eventType": "tool_requested",
      "captureEventSequence": true,
      "description": "固定 MCP tools/call 发送前各 Session 的 Journal 高水位"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"v4-composer-send\"]",
      "description": "发送真实 MCP tools/call 验收请求"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-permission-option-kind=\"allowOnce\"][data-permission-request-id]') && !!document.querySelector('[data-permission-option-kind=\"rejectOnce\"][data-permission-request-id]')",
      "timeoutMs": 120000,
      "description": "MCP 工具的真实权限选项和 interactionId 已挂载"
    },
    {
      "action": "journalBaseline",
      "name": "before-mcp-allow-receipt",
      "eventType": "command_receipt_committed",
      "capturePermissionInteraction": true,
      "description": "记录本次 MCP allowOnce interactionId 与既有收据"
    },
    {
      "action": "journalWait",
      "eventType": "tool_requested",
      "requestContains": "read_evidence",
      "requestToolName": "ExecuteExtraTool",
      "requestEffect": "changes_state",
      "newSinceBaseline": "before-mcp-tools-call",
      "captureSessionAs": "mcp-tools-session",
      "timeoutMs": 180000,
      "approvePermissions": true,
      "description": "先通过真实 allowOnce 权限门，再确认权威 Journal 请求 ExecuteExtraTool；MCP 目标名称在包装器参数中保留"
    },
    {
      "action": "journalWait",
      "eventType": "tool_execution_started",
      "requestContains": "read_evidence",
      "requestToolName": "ExecuteExtraTool",
      "requestEffect": "changes_state",
      "newSinceBaseline": "before-mcp-tools-call",
      "sessionEqualsCaptured": "mcp-tools-session",
      "timeoutMs": 180000,
      "approvePermissions": true,

      "selector": "input[placeholder=\"-y @modelcontextprotocol/server-memory\"]",
      "text": "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PROJECT}\\mcp-fixture.ps1\" \"${PROJECT}\"",

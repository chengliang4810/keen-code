      "description": "确认插件创建入口由真实 DOM 提供"
    },
    {
      "action": "key",
      "key": "Escape",
      "description": "关闭插件菜单"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"settings-section-nav-mcp\"]",
      "description": "打开 MCP 设置"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"settings-page\"]')?.dataset.activeSection === 'mcp' && !!document.querySelector('[data-settings-create-action=\"settings.mcp.create.open\"]')",
      "timeoutMs": 30000,

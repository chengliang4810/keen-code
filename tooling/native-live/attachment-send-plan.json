{
  "name": "native-live-retained-attachment",
  "description": "使用真实 Composer 文件输入上传 UTF-8 文本附件，发送后验证模型只返回文件 marker、Journal 用户引用、Transcript 附件投影和冷恢复。图片拒绝只由离线 Rust 契约测试覆盖，不向 vision=false 模型发送视觉请求。",
  "providerId": "native-live-deepseek",
  "model": "deepseek-v4.1-flash",
  "attachment": {
    "fileName": "native-attachment.txt",
    "mime": "text/plain",
    "marker": "NATIVE_RETAINED_ATTACHMENT_MARKER_20261003_42",
    "content": "这是原生 retained attachment 的 UTF-8 合成夹具。\n唯一需要模型返回的字符串是：NATIVE_RETAINED_ATTACHMENT_MARKER_20261003_42\n"
  },
  "offlineContracts": [
    "agent_runtime::tests::root_attachment_image_is_rejected_before_provider_without_vision",
    "图片在 Journal 用户消息和 Provider HTTP 请求前拒绝；本计划不执行视觉请求。"
  ],
  "files": {
    "evidence.txt": "附件原生验收基线，不应被本计划修改。\n",
    "native-attachment.txt": "这是原生 retained attachment 的 UTF-8 合成夹具。\n唯一需要模型返回的字符串是：NATIVE_RETAINED_ATTACHMENT_MARKER_20261003_42\n"
  },
  "steps": [
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"onboarding-page\"] footer > button') && !/主要工作方向|UI 模式|UI mode/.test(document.querySelector('[data-testid=\"onboarding-page\"]')?.innerText ?? \"\")",
      "description": "隔离新配置直接进入偏好页，无职业或模式选择"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"onboarding-page\"] footer > button",
      "description": "通过原生 UI 一次完成首次启动偏好"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"project-add\"]')",
      "timeoutMs": 60000,
      "description": "原生桌面界面完成启动"
    },
    {
      "action": "hover",
      "selector": "[data-testid=\"project-section\"]",
      "description": "将鼠标移动到项目分区以显示真实新增项目控件"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"project-add\"]",
      "description": "打开项目菜单"
    },
    {
      "action": "click",
      "selector": "[role=\"menuitem\"]",
      "description": "选择隔离测试项目"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('[data-testid^=\"workspace-item-\"]')",
      "timeoutMs": 60000,
      "description": "隔离项目激活并显示 Composer"
    },
    {
      "action": "wait",
      "expression": "(() => { const e = document.querySelector('[data-testid=\"chat-model-select-trigger\"]'); return !!e && !e.hasAttribute('disabled') && e.getAttribute('aria-disabled') !== 'true' && e.getAttribute('data-disabled') !== 'true'; })()",
      "timeoutMs": 60000,
      "description": "等待真实模型选择控件完成 provider/session 加载并启用"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"chat-model-select-trigger\"]",
      "description": "打开原生模型选择器"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-model-provider-key=\"registry-provider:native-live-deepseek\"]')",
      "timeoutMs": 30000,
      "description": "隔离模型菜单显示 native-live-deepseek provider 分组"
    },
    {
      "action": "click",
      "selector": "[data-model-provider-key=\"registry-provider:native-live-deepseek\"]",
      "description": "展开隔离 provider 的模型子菜单"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"chat-model-select-item-custom:native-live-deepseek:deepseek-v4.1-flash\"]')",
      "timeoutMs": 30000,
      "description": "隔离 provider 子菜单显示完整 custom 模型项"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"chat-model-select-item-custom:native-live-deepseek:deepseek-v4.1-flash\"]",
      "description": "选择隔离 provider 的验收模型"
    },
    {
      "action": "wait",
      "expression": "document.querySelector('[data-testid=\"chat-model-select-trigger\"]')?.textContent?.includes('deepseek-v4.1-flash') && !!document.querySelector('[data-testid=\"v4-composer-input\"]')",
      "timeoutMs": 30000,
      "description": "模型已回写工具栏并恢复 Composer"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('input[type=\"file\"]')",
      "timeoutMs": 30000,
      "description": "真实 Composer 文件输入已挂载，等待 CDP 注入"
    },
    {
      "action": "fileInput",
      "selector": "input[type=\"file\"]",
      "path": "native-attachment.txt",
      "description": "通过真实文件控件注入隔离 UTF-8 附件"
    },
    {
      "action": "wait",
      "expression": "Array.from(document.querySelectorAll('[data-composer-attachment-kind]')).some(e => e.textContent.includes('native-attachment.txt') && e.getAttribute('data-upload-status') === 'ready')",
      "timeoutMs": 60000,
      "description": "真实 Composer 附件上传完成并进入 ready"
    },
    {
      "action": "type",
      "selector": "[data-testid=\"v4-composer-input\"]",
      "text": "请读取我附加的 UTF-8 文本文件，只回复文件中唯一的 marker：NATIVE_RETAINED_ATTACHMENT_MARKER_20261003_42。最终回复必须严格只包含这一串字符，不要 Markdown、解释、前后缀或标点。",
      "description": "请求真实模型读取 retained 文本附件并只返回 marker"
    },
    {
      "action": "click",
      "selector": "[data-testid=\"v4-composer-send\"]",
      "description": "发送带 retained 附件的真实用户消息"
    },
    {
      "action": "wait",
      "expression": "Array.from(document.querySelectorAll('[data-conversation-selectable=\"true\"]')).some(e => e.closest('[data-row-id]')?.classList.contains('group/assistant-row') && e.innerText.trim() === 'NATIVE_RETAINED_ATTACHMENT_MARKER_20261003_42') && !document.querySelector('[data-testid=\"v4-stop\"]')",
      "timeoutMs": 180000,
      "description": "真实模型只返回附件 marker 并完成回合"
    },
    {
      "action": "clickIf",
      "selector": "[data-testid^=\"workspace-item-\"]",
      "condition": "document.querySelector('[data-testid^=\"workspace-item-\"]')?.getAttribute('aria-expanded') !== 'true'",
      "description": "展开真实附件任务所属项目分区"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid^=\"task-item-\"]')",
      "timeoutMs": 30000,
      "description": "附件回复完成后等待真实持久任务行"
    },
    {
      "action": "captureTask",
      "name": "retained-attachment-session",
      "selector": "[data-testid^=\"task-item-\"]",
      "description": "捕获附件会话的真实任务身份供冷恢复后重新打开"
    },
    {
      "action": "file",
      "path": "evidence.txt",
      "contains": "附件原生验收基线，不应被本计划修改。",
      "description": "附件读取回合未修改隔离项目文件"
    },
    {
      "action": "journalWait",
      "eventType": "message_added",
      "timeoutMs": 30000,
      "description": "权威 Journal 已记录用户消息"
    },
    {
      "action": "assert",
      "expression": "Array.from(document.querySelectorAll('[data-v4-user-input-attachments=\"true\"]')).some(e => e.innerText.includes('native-attachment.txt'))",
      "description": "原 Transcript 用户行显示 retained 附件"
    },
    {
      "action": "screenshot",
      "name": "01-retained-attachment-before-restart"
    },
    {
      "action": "restart",
      "description": "关闭并重新启动原生窗口验证冷恢复"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid=\"v4-composer-input\"]') && !!document.querySelector('[data-testid^=\"workspace-item-\"]')",
      "timeoutMs": 60000,
      "description": "冷启动按 Source 草稿语义恢复并挂载项目行"
    },
    {
      "action": "clickIf",
      "selector": "[data-testid^=\"workspace-item-\"]",
      "condition": "document.querySelector('[data-testid^=\"workspace-item-\"]')?.getAttribute('aria-expanded') !== 'true'",
      "description": "展开持久附件任务所属项目分区"
    },
    {
      "action": "wait",
      "expression": "!!document.querySelector('[data-testid^=\"task-item-\"]')",
      "timeoutMs": 60000,
      "description": "冷启动后等待持久附件任务行挂载"
    },
    {
      "action": "assert",
      "expression": "!Array.from(document.querySelectorAll('[data-testid^=\"task-item-\"]')).some(e => e.classList.contains('bg-selected'))",
      "description": "确认 Source 冷启动保持 activeTaskId=null，尚未自动打开历史会话"
    },
    {
      "action": "clickCapturedTask",
      "name": "retained-attachment-session",
      "description": "通过真实任务列表打开重启前捕获的附件会话"
    },
    {
      "action": "wait",
      "expression": "Array.from(document.querySelectorAll('[data-conversation-selectable=\"true\"]')).some(e => e.closest('[data-row-id]')?.classList.contains('group/assistant-row') && e.innerText.trim() === 'NATIVE_RETAINED_ATTACHMENT_MARKER_20261003_42') && !!document.querySelector('[data-testid=\"v4-composer-input\"]')",
      "timeoutMs": 60000,
      "description": "重新打开后 Composer 和真实模型回复仍在"
    },
    {
      "action": "assert",
      "expression": "Array.from(document.querySelectorAll('[data-v4-user-input-attachments=\"true\"]')).some(e => e.innerText.includes('native-attachment.txt'))",
      "description": "冷恢复后原 Transcript 用户行仍显示 retained 附件"
    },
    {
      "action": "screenshot",
      "name": "02-retained-attachment-after-restart"
    }
  ],
  "onboardingRevision": "2026-10-04 preferences-only；历史报告和执行快照保持不变，当前计划需重新执行方可认定通过。"
}

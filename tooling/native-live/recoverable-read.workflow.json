{
  "version": 1,
  "meta": {
    "name": "native_recoverable_read",
    "description": "隔离原生验收：1024 次有界只读 Read 串行排队，验证取消后的安全冷恢复。"
  },
  "inputs": {
    "label": {
      "type": "string",
      "description": "本轮只读取消与恢复验收标签。",
      "required": true,
      "default": "NATIVE_RECOVERABLE_READ_41"
    }
  },
  "body": [
    {
      "type": "repeat",
      "node_id": "queued_reads",
      "max_iterations": 1024,
      "body": [
        {
          "type": "tool",
          "node_id": "read_once",
          "name": "Read",
          "input": { "type": "literal", "value": { "file_path": "evidence.txt" } },
          "effect": "read_only"
        }
      ]
    }
  ]
}

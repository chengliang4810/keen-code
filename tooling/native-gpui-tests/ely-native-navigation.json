    { "type": "key", "key": "right", "modifiers": ["alt"] },
    { "type": "wait", "ms": 800 },
    {
      "type": "wait_for_accessibility",
      "label": "界面主题",
      "timeout_ms": 30000
    },
    { "type": "screenshot", "label": "navigation-forward-to-appearance" },

    { "type": "screenshot", "label": "navigation-workbench" },
    { "type": "accessibility", "label": "navigation-workbench" },
    { "type": "metrics", "label": "navigation-workbench" },
    { "type": "click_accessibility", "label": "返回会话", "timeout_ms": 30000 },
    { "type": "wait", "ms": 800 },
    {
      "type": "wait_for_accessibility",
      "label": "任务输入",
      "timeout_ms": 30000
    },
    { "type": "click_accessibility", "label": "任务输入", "timeout_ms": 30000 },
    { "type": "wait", "ms": 200 },
    { "type": "key", "key": "a", "modifiers": ["ctrl"] },
    { "type": "wait", "ms": 100 },
    {
      "type": "type_text",
      "text": "请只用一句话回复 KEENCODE_NAVIGATION_OK，不要调用工具。"
    },
    { "type": "wait", "ms": 200 },
    { "type": "key", "key": "enter" },
    {
      "type": "wait_for_journal",
      "event_type": "turn_started",
      "count": 1,
      "timeout_ms": 180000
    },
    {
      "type": "wait_for_journal",
      "event_type": "turn_completed",
      "count": 1,
      "timeout_ms": 180000
    },
    {
      "type": "assert_journal_count",
      "event_type": "turn_started",
      "count": 1
    },
    {
      "type": "assert_journal_count",
      "event_type": "turn_completed",
      "count": 1
    },
    { "type": "close" }
  ]
}

{
  "version": 1,
  "name": "ely-native-navigation",
  "requires_real_provider": true,
  "requires_journal": true,
  "requires_network_trace": true,
  "native_general_settings": {
    "appearance": "dark",
    "fontFamily": "系统默认",
    "fontSizePx": 14,
    "density": "compact",
    "reducedMotion": true
  },
  "visual": {
    "logicalWidth": 1280,
    "logicalHeight": 820,
    "physicalClientWidth": 2560,
    "physicalClientHeight": 1640,
    "dpi": 192,
    "deviceScaleFactor": 2,
    "theme": "dark",
    "sourceBaseline": "out/ely-native/zcode-windows-reference-6/native-run"
  },
  "actions": [
    { "type": "focus" },
    { "type": "resize_client", "width": 2560, "height": 1640 },
    {
      "type": "assert_window",
      "title_contains": "KeenCode",
      "client_width": 2560,
      "client_height": 1640,
      "dpi": 192
    },
    { "type": "wait", "ms": 1500 },
    { "type": "key", "key": "n", "modifiers": ["ctrl"] },
    {
      "type": "wait_for_journal",
      "event_type": "session_created",
      "count": 1,
      "timeout_ms": 30000
    },
    { "type": "wait", "ms": 500 },
    {
      "type": "wait_for_accessibility",
      "label": "任务输入",
      "timeout_ms": 30000
    },
    {
      "type": "wait_for_accessibility",
      "label": "新建任务",
      "timeout_ms": 30000
    },
    { "type": "screenshot", "label": "navigation-chat-initial" },
    { "type": "accessibility", "label": "navigation-chat-initial" },
    { "type": "metrics", "label": "navigation-chat-initial" },
    { "type": "click_accessibility", "label": "任务输入", "timeout_ms": 30000 },
    { "type": "wait", "ms": 200 },
    {
      "type": "type_text",
      "text": "导航草稿 KEENCODE_NAVIGATION_DRAFT"
    },
    { "type": "wait", "ms": 500 },
    { "type": "screenshot", "label": "navigation-chat-draft" },
    { "type": "accessibility", "label": "navigation-chat-draft" },
    { "type": "click_accessibility", "label": "设置", "timeout_ms": 30000 },
    { "type": "wait", "ms": 300 },
    {
      "type": "wait_for_accessibility",
      "label": "常规",
      "timeout_ms": 30000
    },
    { "type": "click_accessibility", "label": "常规", "timeout_ms": 30000 },
    { "type": "wait", "ms": 800 },
    {
      "type": "wait_for_accessibility",
      "label": "任务通知",
      "timeout_ms": 30000
    },
    { "type": "screenshot", "label": "navigation-settings-general" },
    { "type": "accessibility", "label": "navigation-settings-general" },
    { "type": "metrics", "label": "navigation-settings-general" },
    { "type": "click_accessibility", "label": "外观", "timeout_ms": 30000 },
    { "type": "wait", "ms": 800 },
    {
      "type": "wait_for_accessibility",
      "label": "界面主题",
      "timeout_ms": 30000

      "type": "wait_for_accessibility",
      "label": "新建任务",
      "timeout_ms": 30000
    },
    { "type": "screenshot", "label": "navigation-new-chat-truncates-forward" },
    { "type": "accessibility", "label": "navigation-new-chat-truncates-forward" },
    { "type": "key", "key": "right", "modifiers": ["alt"] },
    { "type": "wait", "ms": 800 },
    {
      "type": "wait_for_accessibility",
      "label": "任务输入",
      "timeout_ms": 30000
    },
    {
      "type": "wait_for_accessibility",
      "label": "新建任务",
      "timeout_ms": 30000
    },
    { "type": "screenshot", "label": "navigation-forward-after-truncate" },
    { "type": "accessibility", "label": "navigation-forward-after-truncate" },

    { "type": "screenshot", "label": "navigation-workbench-forward-to-terminal" },
    { "type": "accessibility", "label": "navigation-workbench-forward-to-terminal" },
    {
      "type": "wait_for_accessibility",
      "label": "返回会话",
      "timeout_ms": 30000

{
  "version": 1,
  "name": "ely-native-visual-settings",
  "requires_real_provider": false,
  "requires_journal": false,
  "requires_network_trace": false,
  "native_general_settings": {
    "appearance": "dark",
    "fontFamily": "系统默认",
    "fontSizePx": 14,
    "density": "compact",
    "reducedMotion": true
  },
  "visual": {
    "logicalWidth": 1280,
    "logicalHeight": 820,
    "physicalClientWidth": 2560,
    "physicalClientHeight": 1640,
    "dpi": 192,
    "deviceScaleFactor": 2,
    "theme": "dark",
    "sourceBaseline": "out/ely-native/zcode-windows-settings-reference-2/native-run"
  },
  "actions": [
    {
      "type": "focus"
    },
    {
      "type": "resize_client",
      "width": 2560,
      "height": 1640
    },
    {
      "type": "assert_window",
      "title_contains": "KeenCode",
      "client_width": 2560,
      "client_height": 1640,
      "dpi": 192
    },
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "screenshot",
      "label": "startup-empty"
    },
    {
      "type": "metrics",
      "label": "startup-empty"
    },
    {
      "type": "click_accessibility",
      "label": "设置",
      "timeout_ms": 30000
    },
    {
      "type": "wait",
      "ms": 100
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "screenshot",
      "label": "settings-entry"
    },
    {
      "type": "accessibility",
      "label": "settings-entry"
    },
    {
      "type": "metrics",
      "label": "settings-entry"
    },
    {
      "type": "click_accessibility",
      "label": "常规",
      "timeout_ms": 30000
    },
    {
      "type": "wait",
      "ms": 100
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "screenshot",
      "label": "settings-general"
    },
    {
      "type": "accessibility",
      "label": "settings-general"
    },
    {
      "type": "metrics",
      "label": "settings-general"
    },
    {
      "type": "click_accessibility",
      "label": "外观",
      "timeout_ms": 30000
    },
    {
      "type": "wait",
      "ms": 100
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "screenshot",
      "label": "settings-appearance"
    },
    {
      "type": "accessibility",
      "label": "settings-appearance"
    },
    {
      "type": "metrics",
      "label": "settings-appearance"
    }
  ]
}

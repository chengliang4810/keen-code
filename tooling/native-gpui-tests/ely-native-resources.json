{
  "version": 1,
  "name": "ely-native-resources-crud",
  "requires_real_provider": true,
  "requires_journal": true,
  "requires_network_trace": true,
  "native_general_settings": {
    "appearance": "dark",
    "fontFamily": "系统默认",
    "fontSizePx": 14,
    "density": "compact",
    "reducedMotion": true
  },
  "visual": {
    "logicalWidth": 1280,
    "logicalHeight": 820,
    "physicalClientWidth": 2560,
    "physicalClientHeight": 1640,
    "dpi": 192,
    "deviceScaleFactor": 2,
    "theme": "dark",
    "sourceBaseline": "out/ely-native/zcode-windows-settings-reference-1/native-run"
  },
  "actions": [
    {"type": "focus"},
    {"type": "resize_client", "width": 2560, "height": 1640},
    {
      "type": "assert_window",
      "title_contains": "KeenCode",
      "client_width": 2560,
      "client_height": 1640,
      "dpi": 192
    },
    {"type": "wait", "ms": 1500},
    {"type": "screenshot", "label": "startup"},
    {"type": "accessibility", "label": "startup"},
    {"type": "key", "key": "n", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {
      "type": "wait_for_journal",
      "event_type": "session_created",
      "count": 1,
      "timeout_ms": 30000
    },
    {"type": "wait", "ms": 500},
    {"type": "click_accessibility", "label": "设置", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "click_accessibility", "label": "插件", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "screenshot", "label": "plugins-empty"},
    {"type": "accessibility", "label": "plugins-empty"},
    {"type": "metrics", "label": "plugins-empty"},
    {"type": "click_accessibility", "label": "MCP", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "screenshot", "label": "mcp-empty"},
    {"type": "accessibility", "label": "mcp-empty"},
    {"type": "metrics", "label": "mcp-empty"},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "wait_for_accessibility", "label": "服务器名称", "timeout_ms": 30000},
    {"type": "click_accessibility", "label": "服务器名称", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "ely-resource-mcp"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "MCP 配置 JSON 对象", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "key", "key": "a", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "{\"command\":\"ely-resource-mcp\"}"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "添加服务器", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "mcp.json",
      "contains": "ely-resource-mcp",
      "min_bytes": 1
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-mcp", "timeout_ms": 30000},
    {"type": "click_accessibility", "label": "读取运行态", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "screenshot", "label": "mcp-created"},
    {"type": "accessibility", "label": "mcp-created"},
    {"type": "metrics", "label": "mcp-created"},
    {"type": "click_accessibility", "label": "编辑 MCP 配置：ely-resource-mcp", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "key", "key": "a", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "{\"command\":\"ely-resource-mcp-updated\"}"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "保存", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "mcp.json",
      "contains": "ely-resource-mcp-updated",
      "min_bytes": 1
    },
    {"type": "click_accessibility", "label": "模型与供应商", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "click_accessibility", "label": "MCP", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-mcp", "timeout_ms": 30000},
    {"type": "screenshot", "label": "mcp-reloaded"},
    {"type": "accessibility", "label": "mcp-reloaded"},
    {"type": "metrics", "label": "mcp-reloaded"},
    {"type": "click_accessibility", "label": "移除", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {"type": "assert_file", "scope": "data", "path": "mcp.json", "contains": "mcpServers", "min_bytes": 1},
    {"type": "screenshot", "label": "mcp-deleted"},
    {"type": "accessibility", "label": "mcp-deleted"},
    {"type": "click_accessibility", "label": "技能", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "screenshot", "label": "skills-empty"},
    {"type": "accessibility", "label": "skills-empty"},
    {"type": "metrics", "label": "skills-empty"},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "wait_for_accessibility", "label": "Skill 目录名", "timeout_ms": 30000},
    {"type": "click_accessibility", "label": "Skill 目录名", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "ely-resource-skill"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "global 或 project", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "key", "key": "a", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "global"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "SKILL.md 内容", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {
      "type": "type_text",
      "text": "---\nname: ely-resource-skill\ndescription: dummy skill\n---\nSKILL_CREATE_V1"
    },
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "创建技能", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "skills/ely-resource-skill/SKILL.md",
      "contains": "SKILL_CREATE_V1",
      "min_bytes": 1
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-skill", "timeout_ms": 30000},
    {"type": "click_accessibility", "label": "编辑 SKILL.md 内容：global:ely-resource-skill", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "key", "key": "a", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {
      "type": "type_text",
      "text": "---\nname: ely-resource-skill\ndescription: dummy skill edited\n---\nSKILL_EDIT_V2"
    },
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "保存", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "skills/ely-resource-skill/SKILL.md",
      "contains": "SKILL_EDIT_V2",
      "min_bytes": 1
    },
    {"type": "click_accessibility", "label": "模型与供应商", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "click_accessibility", "label": "技能", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-skill", "timeout_ms": 30000},
    {"type": "screenshot", "label": "skill-reloaded"},
    {"type": "accessibility", "label": "skill-reloaded"},
    {"type": "metrics", "label": "skill-reloaded"},
    {"type": "click_accessibility", "label": "删除", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {"type": "accessibility", "label": "skill-deleted"},
    {"type": "click_accessibility", "label": "记忆", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "screenshot", "label": "memory-empty"},
    {"type": "accessibility", "label": "memory-empty"},
    {"type": "metrics", "label": "memory-empty"},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "click_accessibility", "label": "文件名，例如 project.md", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "ely-resource-memory.md"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "Memory 内容", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "MEMORY_CREATE_V1"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "创建记忆", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "memories/ely-resource-memory.md",
      "contains": "MEMORY_CREATE_V1",
      "min_bytes": 1
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-memory.md", "timeout_ms": 30000},
    {"type": "click_accessibility", "label": "编辑 Memory 内容：ely-resource-memory.md", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "key", "key": "a", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "MEMORY_EDIT_V2"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "保存", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "memories/ely-resource-memory.md",
      "contains": "MEMORY_EDIT_V2",
      "min_bytes": 1
    },
    {"type": "click_accessibility", "label": "模型与供应商", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "click_accessibility", "label": "记忆", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-memory.md", "timeout_ms": 30000},
    {"type": "screenshot", "label": "memory-reloaded"},
    {"type": "accessibility", "label": "memory-reloaded"},
    {"type": "metrics", "label": "memory-reloaded"},
    {"type": "click_accessibility", "label": "删除", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {"type": "accessibility", "label": "memory-deleted"},
    {"type": "click_accessibility", "label": "Agent 模板", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "screenshot", "label": "agent-templates-empty"},
    {"type": "accessibility", "label": "agent-templates-empty"},
    {"type": "metrics", "label": "agent-templates-empty"},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "click_accessibility", "label": "模板文件名", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "ely-resource-template"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "global 或 project", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "key", "key": "a", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "global"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "Agent 模板正文", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "TEMPLATE_CREATE_V1"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "创建模板", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "agents/ely-resource-template.md",
      "contains": "name: ely-resource-template",
      "min_bytes": 1
    },
    {
      "type": "assert_file",
      "scope": "data",
      "path": "agents/ely-resource-template.md",
      "contains": "TEMPLATE_CREATE_V1",
      "min_bytes": 1
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-template", "timeout_ms": 30000},
    {"type": "click_accessibility", "label": "编辑 Agent 模板正文：global:ely-resource-template", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "key", "key": "a", "modifiers": ["ctrl"]},
    {"type": "wait", "ms": 150},
    {"type": "type_text", "text": "TEMPLATE_EDIT_V2"},
    {"type": "wait", "ms": 150},
    {"type": "click_accessibility", "label": "保存", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {
      "type": "assert_file",
      "scope": "data",
      "path": "agents/ely-resource-template.md",
      "contains": "TEMPLATE_EDIT_V2",
      "min_bytes": 1
    },
    {"type": "click_accessibility", "label": "模型与供应商", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {"type": "click_accessibility", "label": "Agent 模板", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1000},
    {
      "type": "repeat",
      "count": 2,
      "actions": [
        {"type": "scroll", "x": 2200, "y": 1400, "delta_y": -1920},
        {"type": "wait", "ms": 500}
      ]
    },
    {"type": "wait_for_accessibility", "label": "ely-resource-template", "timeout_ms": 30000},
    {"type": "screenshot", "label": "template-reloaded"},
    {"type": "accessibility", "label": "template-reloaded"},
    {"type": "metrics", "label": "template-reloaded"},
    {"type": "click_accessibility", "label": "删除", "timeout_ms": 30000},
    {"type": "wait", "ms": 150},
    {"type": "wait", "ms": 1200},
    {"type": "accessibility", "label": "template-deleted"},
    {"type": "assert_journal_count", "event_type": "session_created", "count": 1},
    {"type": "screenshot", "label": "resources-crud-final"},
    {"type": "click_accessibility", "label": "返回工作区", "timeout_ms": 30000},
    {"type": "wait", "ms": 1000},
    {
      "type": "wait_for_accessibility",
      "label": "任务输入",
      "timeout_ms": 30000
    },
    {
      "type": "click_accessibility",
      "label": "任务输入",
      "timeout_ms": 30000
    },
    {
      "type": "type_text",
      "text": "请只回复 KEENCODE_NATIVE_RESOURCES_LIVE_OK，不要调用工具。"
    },
    {"type": "wait", "ms": 800},
    {"type": "key", "key": "enter"},
    {
      "type": "wait_for_journal",
      "event_type": "turn_started",
      "count": 1,
      "timeout_ms": 180000
    },
    {"type": "screenshot", "label": "resources-turn-started"},
    {
      "type": "wait_for_journal",
      "event_type": "turn_completed",
      "count": 1,
      "timeout_ms": 180000
    },
    {"type": "assert_journal_count", "event_type": "turn_started", "count": 1},
    {"type": "assert_journal_count", "event_type": "turn_completed", "count": 1},
    {"type": "screenshot", "label": "resources-turn-completed"},
    {"type": "accessibility", "label": "resources-turn-completed"},
    {"type": "metrics", "label": "resources-turn-completed"}
  ]
}

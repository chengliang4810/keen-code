    {
      "type": "type_text",
      "text": "请使用 Bash 工具执行 powershell.exe -NoProfile -Command \"Start-Sleep -Seconds 20\"，等待它执行完成后再简短回答，不要提前结束。"
    },
    {
      "type": "wait",
      "ms": 800
    },
    {
      "type": "key",
      "key": "enter"
    },
    {
      "type": "wait_for_journal",
      "event_type": "turn_started",
      "count": 1,
      "timeout_ms": 180000
    },
    {
      "type": "wait_for_journal",
      "event_type": "tool_execution_started",
      "count": 1,
      "timeout_ms": 180000
    },
    {
      "type": "screenshot",
      "label": "before-stop"
    },
    {
      "type": "accessibility",
      "label": "before-stop"
    },
    {
      "type": "click",
      "x": 2375,
      "y": 1547
    },
    {
      "type": "wait",
      "ms": 150

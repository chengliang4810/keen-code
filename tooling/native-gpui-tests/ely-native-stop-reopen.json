      "client_height": 1640,
      "dpi": 192
    },
    {
      "type": "wait",
      "ms": 1500
    },
    {
      "type": "screenshot",
      "label": "startup"
    },
    {
      "type": "accessibility",
      "label": "startup"
    },
    {
      "type": "metrics",
      "label": "startup"
    },
    {
      "type": "focus"
    },
    {
      "type": "wait",
      "ms": 200
    },
    {
      "type": "click",
      "x": 150,
      "y": 142
    },
    {
      "type": "wait",
      "ms": 150
    },
    {
      "type": "wait_for_journal",
      "event_type": "session_created",
      "count": 1,
      "timeout_ms": 30000
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "click",
      "x": 1050,
      "y": 985
    },
    {
      "type": "wait",
      "ms": 400

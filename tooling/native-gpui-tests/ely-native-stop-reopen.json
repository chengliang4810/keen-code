      "label": "session-reopened"
    },
    {
      "type": "accessibility",
      "label": "session-reopened"
    },
    {
      "type": "metrics",
      "label": "session-reopened"
    },
    {
      "type": "click",
      "x": 1000,
      "y": 1380
    },
    {
      "type": "wait",
      "ms": 150
    },
    {
      "type": "type_text",
      "text": "会话重开后请使用 write 工具创建 out/native-acceptance/stop-reopen-second.txt，文件内容必须精确等于以下标记，不能添加其他字符或换行： KEENCODE_NATIVE_STOP_REOPEN_SECOND_MARKER_20261005，完成后只简短确认。"
    },
    {
      "type": "wait",
      "ms": 800
    },
    {
      "type": "key",
      "key": "enter"
    },
    {
      "type": "wait_for_journal",
      "event_type": "turn_started",
      "count": 2,
      "timeout_ms": 180000
    },
    {
      "type": "wait_for_journal",
      "event_type": "tool_requested",
      "count": 1,
      "matching": {
        "/payload/request/toolName": "Write",
        "/payload/request/arguments/content": "KEENCODE_NATIVE_STOP_REOPEN_SECOND_MARKER_20261005",
        "/payload/request/effect": "changes_state"
      },
      "timeout_ms": 180000,
      "matching_project_paths": {
        "/payload/request/arguments/file_path": "out/native-acceptance/stop-reopen-second.txt"
      }
    },
    {
      "type": "wait_for_journal",
      "event_type": "tool_execution_started",
      "count": 2,
      "timeout_ms": 180000
    },
    {
      "type": "wait_for_file",
      "path": "out/native-acceptance/stop-reopen-second.txt",
      "contains": "KEENCODE_NATIVE_STOP_REOPEN_SECOND_MARKER_20261005",
      "timeout_ms": 180000
    },
    {
      "type": "wait_for_journal",
      "event_type": "tool_completed",
      "count": 1,
      "timeout_ms": 180000
    },
    {
      "type": "wait_for_journal",
      "event_type": "turn_completed",
      "count": 1,
      "timeout_ms": 180000
    },
    {
      "type": "screenshot",
      "label": "second-round-completed"
    },
    {
      "type": "accessibility",
      "label": "second-round-completed"
    },
    {
      "type": "metrics",
      "label": "second-round-completed"
    }
  ]

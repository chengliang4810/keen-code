    {
      "type": "assert_file",
      "scope": "project",
      "path": "README.md",
      "contains": "Ely native acceptance isolated project",
      "min_bytes": 1
    },
    {
      "type": "key",
      "key": "n",
      "modifiers": [
        "ctrl"
      ]
    },
    {
      "type": "wait_for_journal",
      "event_type": "session_created",
      "count": 1,
      "timeout_ms": 15000
    },
    {
      "type": "wait",
      "ms": 500
    },
    {
      "type": "click",
      "x": 1000,
      "y": 880
    },
    {
      "type": "wait",
      "ms": 100
    },
    {
      "type": "type_text",
      "text": "只回复字符串 settings ok。不要调用工具。"
    },
    {
      "type": "wait",
      "ms": 800
    },
    {
      "type": "key",
      "key": "enter"
    },
    {
      "type": "wait_for_journal",
      "event_type": "turn_completed",
      "count": 1,
      "timeout_ms": 120000
    },
    {
      "type": "wait",
      "ms": 500
    },
    {
      "type": "click",
      "x": 120,
      "y": 1575
    },
    {
      "type": "wait",
      "ms": 100
    },
    {
      "type": "wait",
      "ms": 1000

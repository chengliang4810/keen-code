{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../../packages/ui/src/*"],
      "@app/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "../../packages/ui/src/**/*.d.ts"
  ],
  "references": [
    { "path": "../../packages/rpc" },
    { "path": "../../packages/provider" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/services" },
    { "path": "../../packages/client" },
    { "path": "../../packages/ui" }
  ]
}

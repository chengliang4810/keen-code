-                            Ok(result_val.unwrap_or(Value::Null))
-                        };
-                        let msg = IncomingMessage::Response { id: req_id, result };
-                        if !pump_router.dispatch(&msg).await {
-                            let _ = incoming_tx.send(msg);
-                        }
-                    }

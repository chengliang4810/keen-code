-      cur.toolNames[tu.name] = (cur.toolNames[tu.name] ?? 0) + 1;
-      cur.toolUseBytes.push(tu.inputBytes);
-      cur.toolSeq.push({ name: tu.name, args: JSON.stringify(tu.input).slice(0, 200) });
-    }
-  } else if (p.role === "tool") {

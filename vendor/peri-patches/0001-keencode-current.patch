-
-/// 发送错误。
-#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
-pub enum SendError {
-    /// transport 已停止（停止重连或优雅关闭）。
-    #[error("transport 已停止")]
-    Stopped,
-    /// 发送队列已满（背压，§8.6 硬阈值）。由 [`TransportHandle::dispatch`]

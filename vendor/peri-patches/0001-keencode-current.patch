-    }
-    let chars = name.chars().count();
-    if chars > MAX_DEVICE_NAME_CHARS {
-        anyhow::bail!("device name too long: {chars} chars > {MAX_DEVICE_NAME_CHARS}");
-    }
-    Ok(())
-}

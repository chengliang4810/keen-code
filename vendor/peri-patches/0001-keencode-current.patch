-/// 解析 unified diff 文本。`path_hint` 优先（Edit/Write 的 `file_path`），
-/// 缺失时从 `+++ b/…` / `diff --git a/… b/…` 头提取。
-pub fn parse_unified_diff(text: &str, path_hint: Option<&str>) -> Option<TuiDiffBlock> {

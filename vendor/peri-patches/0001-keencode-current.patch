-/// 脱敏截断（§9.3：4KB 容量约束；按字节截断，非法 UTF-8 边界由
-/// `String::truncate` 语义规避——先按 char 边界裁剪）。
-fn truncate_text(s: &str) -> String {
-    if s.len() <= TEXT_MAX_BYTES {
-        return s.to_string();
-    }
-    let mut end = TEXT_MAX_BYTES;
-    while !s.is_char_boundary(end) {
-        end -= 1;
-    }
-    s[..end].to_string()
-}

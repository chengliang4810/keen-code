-                        if parsed.get("jsonrpc").is_some() {
-                            if tx
-                                .send(ChildOutput::Frame(ChildEvent {
-                                    session_id: inner.session_id.clone(),
-                                    frame: parsed,
-                                }))
-                                .is_err()
-                            {
-                                return;
-                            }

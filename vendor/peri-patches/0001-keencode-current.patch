-            }
-            spans.push(Span::styled(
-                line[s_s_byte..s_e_byte].to_string(),
-                selection_style,
-            ));
-            if s_e_byte < line.len() {
-                spans.push(Span::raw(line[s_e_byte..].to_string()));
-            }
-            result.push(Line::from(spans));
-        } else {
-            // ── 纯文本行 ──
-            result.push(Line::from(line.to_string()));
-        }
-    }

+/// Claude 插件清单解析后的一条 Hook 注册记录。
+#[derive(Clone, Debug)]
+pub struct ClaudeHookRegistration {
+    /// 热刷新之间保持稳定的 Hook 标识。
+    pub id: String,
+    /// 提供此 Hook 的完整插件标识。
+    pub plugin_id: String,
+    /// Claude 生命周期事件名称。
+    pub event: String,

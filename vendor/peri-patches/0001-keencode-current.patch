-        for (i, call) in calls.iter().enumerate() {
-            // 非敏感工具 → 直接放行（ExecuteExtraTool 透传目标工具名）
-            let effective_name = effective_tool_name(&call.name, &call.input);
-            if !(self.requires_approval)(&effective_name) {

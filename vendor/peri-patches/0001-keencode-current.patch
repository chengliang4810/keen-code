-        name: entry.name, path: relPath, type: "directory",
-        hasChildren: await hasVisibleChildren(join(dirPath, entry.name), docsDir),
-      });
-    } else {
-      nodes.push({ name: entry.name, path: relPath, type: "file" });
-    }
-  }

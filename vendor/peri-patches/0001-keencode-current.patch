-    // 独立完成，两者互不干扰。
-    let sigint_shutdown = shutdown.clone();
-    tokio::spawn(async move {
-        loop {
-            tokio::select! {
-                _ = sigint_shutdown.cancelled() => break,
-                _ = tokio::signal::ctrl_c() => {

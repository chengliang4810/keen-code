-            warn!(error = ?e, "registry init baseline persist failed");
-        }
-    }
-
-    while let Some(msg) = rx.recv().await {
-        match msg {
-            RegistryMsg::Command(cmd, reply) => {
-                let r = applier.apply(&cmd);
-                persist_registry_updates(&mut update_rx, &sink, &broadcast).await;
-                let _ = reply.send(r);

-  printMetric("极短会话占比", pct(shortCount, threads.length));
-  printMetric(
-    "其中无工具调用",
-    `${shortNoToolCount} (${pct(shortNoToolCount, Math.max(shortCount, 1))})`,
-  );
-  printMetric(
-    "放弃信号率（极短 + 无工具）",
-    pct(shortNoToolCount, threads.length),
-  );

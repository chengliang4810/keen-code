-/** 把文件列表 round-robin 分片给 N 个 worker */
-function shardFiles(files, n) {
-  const shards = Array.from({ length: n }, () => []);
-  files.forEach((f, i) => shards[i % n].push(f));
-  return shards.filter((s) => s.length > 0);
-}

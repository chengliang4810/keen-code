-impl TrustedPeer {
-    /// 从设备公开身份构造信任记录。
-    pub fn from_device(device: &DevicePublic, trusted_at: u64) -> Self {
-        Self {
-            device_id: device.device_id,
-            ed_pub: device.ed_pub,
-            x_pub: device.x_pub,
-            name: device.name.clone(),
-            trusted_at,

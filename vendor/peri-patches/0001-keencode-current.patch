-// tool_search/middleware.rs
-const TOOL_ALIASES: &[(&str, &str)] = &[
-    ("Task", "Agent"),
-    ("Bash", "bash"),     // 如果注册名是小写
-    ("Shell", "bash"),
-];
-
-fn resolve_alias(tool_name: &str) -> String {
-    for (alias, real) in TOOL_ALIASES {

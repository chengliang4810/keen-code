-        assert_eq!(s.user_prompt, ">");
-        // 辅助字形（§12 同一降级契约）：▶/↻/✎ → >/~/*
-        assert_eq!(s.todo_started, ">");
-        assert_eq!(s.todo_reopened, "~");
-        assert_eq!(s.todo_edited, "*");
-        // 显式状态文本后备与符号等价性（无 unicode 时每个语义仍有明确符号）
-        let all = [
-            s.running,
-            s.success,
-            s.error,
-            s.warning,
-            s.collapsed,
-            s.expanded,
-            s.queued,
-            s.user_prompt,
-            s.todo_started,
-            s.todo_reopened,
-            s.todo_edited,

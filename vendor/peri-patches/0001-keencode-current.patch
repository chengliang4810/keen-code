-// ── Metric 3: 死循环检测（N≥5） ──
-
-function normalizeArgs(args: Record<string, any>): string {
-  try {
-    const sorted: Record<string, any> = {};
-    for (const key of Object.keys(args).sort()) {
-      sorted[key] = args[key];
-    }
-    return JSON.stringify(sorted);
-  } catch {
-    return JSON.stringify(args);
-  }
-}

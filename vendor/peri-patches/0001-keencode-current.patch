-    let join_auth = auth_header_at(
-        (flow.cfg.now)(),
-        flow.store,
-        &local.device_id,
-        "join",
-        &[
-            &channel_id,
-            &code_norm,
-            &local.device_id.to_b64(),
-            &b64url(&local.ed_pub),
-            &b64url(&local.x_pub),
-        ],
-    )?;

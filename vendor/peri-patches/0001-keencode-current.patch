-/// H1a：从 ViewModelsSnapshot 派生按 TuiRenderUnit 类型分类的统计。
-struct VmStats {
-    total: usize,
-    user_bubbles: usize,
-    assistant_bubbles: usize,
-    tool_cards: usize,
-    subagent_groups: usize,
-    system_notes: usize,
-}

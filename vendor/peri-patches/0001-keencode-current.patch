-function mergeToolCounts(ss: SessionStat[]): Record<string, number> {
-  const out: Record<string, number> = {};
-  for (const s of ss) for (const [k, v] of Object.entries(s.toolNames)) out[k] = (out[k] ?? 0) + v;
-  return out;
-}

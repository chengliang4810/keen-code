-/// `Bash`、`Agent`、`delete_*`、`rm_*` 不属于编辑工具，仍需审批。
-pub fn is_edit_tool(tool_name: &str) -> bool {
-    tool_name == TOOL_WRITE || tool_name == TOOL_EDIT || tool_name == TOOL_FOLDER_OPS

-  --danger-soft: #fff0ef; /* §3.2 --ui-danger-soft（destructive hover 底） */
-  --btn-primary: #252524; /* §3.8 主按钮底色 */
-  --btn-primary-hover: #111110; /* §3.8 主按钮 hover */
-  --shadow-popover: 0 16px 42px rgb(25 25 24 / 14%), 0 2px 8px rgb(25 25 24 / 8%); /* §3.2 --ui-shadow-popover */
-  --shadow-float: 0 12px 32px rgb(25 25 24 / 10%), 0 2px 8px rgb(25 25 24 / 6%); /* §3.2 --ui-shadow-float：仅用于 Composer 悬浮输入卡 */
-
-  /* 尺寸 */
-  --sidebar-w: 280px; /* §3.4 --ui-sidebar-width */
-  --rail-w: 320px; /* §3.4 --ui-rail-width */
-  --header-h: 64px; /* §3.4 --ui-header-height */
-  --composer-radius: 24px; /* §3.4 --ui-radius-composer */
-  --composer-max: 864px; /* §3.4 --ui-composer-max */
-
-  /* 系统字体栈（§3.3，不下载 Web Font，中文/等宽统一） */
-  --font-sans:
-    -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC',
-    'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
-  --font-mono:
-    'SFMono-Regular', 'SF Mono', Menlo, Monaco, Consolas, 'Liberation Mono',
-    monospace;
-}
-
-html,
-body,
-#app {
-  height: 100%;
-}
-
-body {
-  margin: 0;
-  overflow: hidden; /* 固定视口应用壳：页面本身不滚动，三栏各自滚动 */
-  font-family: var(--font-sans);
-  color: var(--text-primary);
-  background: var(--app-bg);
-  -webkit-font-smoothing: antialiased;
-}
-
-/* 等宽字体统一走系统 mono 栈；code 降低对比（去掉 slate 大背景感） */
-code,
-pre,
-kbd {
-  font-family: var(--font-mono);
-}
-
-code {
-  border-radius: 6px;
-  background: var(--surface-muted);
-  color: var(--text-secondary);
-  padding: 1px 6px;
-  font-size: 0.85em;
-}
-
-/* 统一键盘焦点环：不依赖浏览器默认 outline，hover-only 交互也要能聚焦 */
-:focus-visible {
-  outline: 2px solid var(--focus-ring);
-  outline-offset: 1px;
-}
-
-/* 桌面端三处独立滚动的统一细滚动条（§3.12）：默认透明，hover 显示
-   6px 浅灰 thumb；Composer textarea 沿用同一规则。 */
-.ui-scrollbar {
-  scrollbar-width: thin;
-  scrollbar-color: transparent transparent;
-}
-
-.ui-scrollbar:hover {
-  scrollbar-color: #cececa transparent;
-}
-
-.ui-scrollbar::-webkit-scrollbar {
-  width: 6px;
-  height: 6px;
-}
-
-.ui-scrollbar::-webkit-scrollbar-track {
-  background: transparent;
-}
-
-.ui-scrollbar::-webkit-scrollbar-thumb {
-  border-radius: 999px;
-  background: transparent;
-}
-
-.ui-scrollbar:hover::-webkit-scrollbar-thumb {
-  background: #cececa;
-}
-
-/* 尊重系统减弱动态：取消位移与循环动画，只保留即时状态变化（§3.11） */
-@media (prefers-reduced-motion: reduce) {
-  *,
-  *::before,
-  *::after {
-    animation-duration: 0.01ms !important;
-    animation-iteration-count: 1 !important;
-    transition-duration: 0.01ms !important;
-    scroll-behavior: auto !important;
-  }
-}
-
-/* popover 进入：140ms opacity + 4px 上移（§3.11）；reduced-motion 由
-   上方全局规则归零。 */
-@keyframes ui-popover-in {
-  from {
-    opacity: 0;
-    transform: translateY(4px);
-  }
-  to {
-    opacity: 1;
-    transform: translateY(0);
-  }
-}

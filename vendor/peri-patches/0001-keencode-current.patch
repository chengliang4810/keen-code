-            }
-        })
-        .collect();
-
-    let empty = display_lines.is_empty();
-    let popup_block = Block::default()
-        .borders(Borders::TOP | Borders::BOTTOM)
-        .border_style(Style::new().fg(popup_tokens.border))
-        .title_top(

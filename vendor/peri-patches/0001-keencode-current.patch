-    // ── 4. ws 客户端全流程 ────────────────────────────────────────────────
-    await runWsFlow({ base, clientToken, instance, server, port });
-    console.log(`\n结果: ${passed} PASS / ${failed} FAIL`);
-    return failed === 0;
-  } finally {
-    await cleanup(keep);
-  }
-}

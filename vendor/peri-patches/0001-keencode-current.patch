-
-    // 输出摘要（§6.4）：error 摘要拆行 + error 色（§9.2）；展开态 ≤4 行。
-    // [G-Diff] 含 diff 的 Edit/Write 展开体由 render_diff_lines 展示（§6.5）——
-    // diff 文本就是 output_summary 本体，原始行直接显示会与 hunk 渲染重复。
-    let show_output = if data.is_error {

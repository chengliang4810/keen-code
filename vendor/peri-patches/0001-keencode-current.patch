-/// 判断鼠标列是否落在滚动条列（drawer.area 最右 1 列）。
-fn is_scrollbar_column(mouse_col: u16, area: Rect) -> bool {
-    mouse_col == area.x.saturating_add(area.width).saturating_sub(1)
-}

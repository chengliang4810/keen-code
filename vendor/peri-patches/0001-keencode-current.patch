-pub struct StdioTransport {
-    incoming_rx: tokio::sync::Mutex<mpsc::UnboundedReceiver<IncomingMessage>>,
-    router: RequestRouter,
-    writer: Arc<Mutex<BufWriter<tokio::io::Stdout>>>,
-}

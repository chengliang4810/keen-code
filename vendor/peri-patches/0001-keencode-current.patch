-    // markdown 增量缓存；md 复制按钮关闭——嵌套内容不提供复制按钮）。
-    let mut lines: Vec<Line<'static>> = Vec::new();
-    match &group {
-        Some(g) => {
-            lines.push(Line::from(vec![Span::styled(
-                g.agent_name.clone(),
-                Style::new()
-                    .fg(theme_def.read().component.panel.title)
-                    .bold(),
-            )]));
-            lines.push(Line::from(vec![Span::styled(

-
-    // 6. 退出前触发 shutdown，让后台任务干净退出
-    shutdown.cancel();
-
-    // 7. teardown：hooks / MCP / Langfuse
-    teardown_app(&mut app).await;
-
-    result?;
-    Ok(())
-}

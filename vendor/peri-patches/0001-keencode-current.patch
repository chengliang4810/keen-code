-/// session/cancel 核心逻辑
-pub(crate) fn handle_cancel(ctx: &StdioContext, session_id: &str) {
-    let sessions = ctx.sessions.read();
-    if let Some(s) = sessions.get(session_id)
-        && let Some(ref token) = s.cancel_token

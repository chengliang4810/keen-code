-// RFC3339 → 本地 HH:MM:SS（空串/非法 → '—'）。
-function shortTime(s: string | null): string {
-  if (!s || s === '—') return '—';
-  const d = new Date(s);
-  if (Number.isNaN(d.getTime())) return '—';
-  return d.toLocaleTimeString();
-}

-        CT["CurrentTurn 状态机<br/>segments (TurnSegment 交错)<br/>reasoning / text / subagents"]
-        BV["build_view_models()<br/>→ segments 顺序展开<br/>→ Vec〈TuiRenderUnit〉"]

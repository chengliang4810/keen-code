-/// 渲染行数（鼠标命中反推行号契约的依据）。
-pub fn wrap_text(s: &str, width: usize) -> Vec<String> {
-    let chars: Vec<char> = s.chars().collect();
-    let mut out = Vec::new();
-    let mut i = 0;

-
-    // ── 2. join（签名绑定 channel/code_norm/自身公钥）──
-    let join_body = http_client::JoinBody {
-        code: code_norm.clone(),
-        device_id: local.device_id.to_b64(),
-        ed_pub: b64url(&local.ed_pub),
-        x_pub: b64url(&local.x_pub),

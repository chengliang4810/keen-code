-    for k in blocks.keys(&txn) {
-        let b = blocks.get(&txn, k)?.cast::<yrs::MapRef>().ok()?;
-        if let Some(t) = b.get(&txn, "text").and_then(|v| v.cast::<String>().ok()) {
-            text.push_str(&t);
-        }
-    }

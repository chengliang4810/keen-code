+/// 读取 `PERI_AGENT_DIRS` 指向的插件与全局 Agent 目录列表。
+pub(crate) fn global_agent_dirs() -> Vec<std::path::PathBuf> {
+    std::env::var_os("PERI_AGENT_DIRS")
+        .map(|value| std::env::split_paths(&value).collect())
+        .unwrap_or_default()

-impl Aggregator {
-    /// 应用单个事件（纯函数）。自管理事务：chat 一次、control 一次，顺序固定
-    /// chat → control（§6.4/§7.4）；不涉及某 doc 时跳过该事务。
-    pub fn apply(&mut self, pair: &mut DocPair, ev: &NormalizedEvent) -> ApplyResult {

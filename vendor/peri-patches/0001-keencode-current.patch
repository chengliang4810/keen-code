+
+    let mut next_turn_prompt = frozen_system_prompt.clone();
+    append_developer_context(&mut next_turn_prompt, None);
+    assert_eq!(
+        next_turn_prompt, frozen_system_prompt,
+        "下一轮未传上下文时必须继续使用未污染的冻结基线"
+    );
+}

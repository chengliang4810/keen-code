-            InteractionResponse::Decisions(mut d) => d.pop().unwrap_or(ApprovalDecision::Reject {
-                reason: "用户拒绝".to_string(),
-                source: None,
-            }),
-            _ => ApprovalDecision::Reject {
-                reason: "用户拒绝".to_string(),
-                source: None,
-            },
-        };

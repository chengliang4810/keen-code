-		return `bytes ${obj.size - r.suffix}-${obj.size - 1}/${obj.size}`;
-	}
-	if (r && r.offset !== undefined && r.length !== undefined) {
-		return `bytes ${r.offset}-${r.offset + r.length - 1}/${obj.size}`;
-	}
-	return `bytes */${obj.size}`;
-}

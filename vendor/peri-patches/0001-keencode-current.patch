-                    match crate::config::save(&snap) {
-                        Ok(()) => {
-                            *NOTIFICATION.state().write() = Some(Notification {
-                                message: i18n::tr("config-saved").to_string(),
-                                until: Instant::now() + Duration::from_secs(1),
-                            });
-                        }
-                        Err(e) => {
-                            *NOTIFICATION.state().write() = Some(Notification {

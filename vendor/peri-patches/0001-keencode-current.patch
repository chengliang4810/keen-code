-    // 需要已 committed 的 session（binding 建立，§6.2 全时序）。
-    let create_cid = uuid::Uuid::new_v4().to_string();
-    c.send(&Frame::Action(acp_hub_proto::action::ActionEnvelope::Create {
-        command_id: create_cid,

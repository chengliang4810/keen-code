-/// API Key 脱敏显示
-pub fn mask_api_key(key: &str) -> String {
-    let chars: Vec<char> = key.chars().collect();
-    let len = chars.len();
-    if len <= 8 {
-        "•".repeat(len)
-    } else {
-        let prefix: String = chars[..4].iter().collect();
-        let suffix: String = chars[len - 4..].iter().collect();
-        format!("{}••••{}", prefix, suffix)
-    }
-}

-    cfg: Config,
-    auth: AuthService,                  // F2：machine 双向 / client 单向
-    conns: Arc<ConnectionRegistry>,
-    channel: Arc<SessionChannel 工厂>,
-    coordinator: Arc<CommandCoordinator>,

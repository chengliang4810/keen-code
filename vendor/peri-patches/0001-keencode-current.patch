-/// API Key 脱敏显示：保留最后 4 个字符，其余用 * 代替。
-fn mask_api_key_display(raw: &str) -> String {
-    if raw.is_empty() {
-        return String::new();
-    }
-    if raw.len() <= 4 {
-        return "*".repeat(raw.len());
-    }
-    let tail: String = raw
-        .chars()
-        .rev()
-        .take(4)
-        .collect::<String>()
-        .chars()
-        .rev()
-        .collect();
-    format!("{}...{}", "*".repeat(4), tail)
-}

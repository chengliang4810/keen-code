-            t.clone()
-        } else {
-            let total = todos.len();
-            let done = todos
-                .iter()
-                .filter(|t| t.status == TodoStatus::Completed)
-                .count();
-            let active = todos
-                .iter()
-                .find(|t| t.status == TodoStatus::InProgress)

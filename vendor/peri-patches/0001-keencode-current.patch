-        let mut t = self.tracer.lock();
-        match event {
-            UnifiedLangfuseEvent::LlmCallStart {
-                agent_id,
-                step,
-                messages,
-                tools,
-            } => {
-                self.llm_start_steps.lock().insert(agent_id.clone(), *step);

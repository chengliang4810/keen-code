-impl RenderedRow {
-    fn separator(style: Style) -> Self {
-        Self {
-            cells: vec![],
-            style,
-            is_separator: true,
-        }
-    }
-    fn height(&self) -> u16 {
-        if self.is_separator {
-            1
-        } else {
-            self.cells
-                .iter()
-                .map(|c| c.lines.len() as u16)
-                .max()
-                .unwrap_or(1)
-                .max(1)
-        }

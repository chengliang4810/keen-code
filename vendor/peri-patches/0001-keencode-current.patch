-/// S5.2：慢 flush 期间命令通道满 → DropNew 丢弃事件，丢弃计数必须累加，
-/// flush 完成后汇总输出并清零。
-#[tokio::test]
-async fn test_batcher_drop_new_increments_dropped_counter_during_slow_flush() {

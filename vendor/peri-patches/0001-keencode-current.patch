-                history_path
-            );
-        }
-        std::thread::sleep(std::time::Duration::from_millis(10));
-        waited_ms += 10;
-    };
-
-    // 还原 HOME。
-    unsafe {
-        if let Some(h) = prev_home {
-            std::env::set_var("HOME", h);
-        } else {
-            std::env::remove_var("HOME");
-        }
-    }

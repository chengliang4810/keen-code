-/// acp-hub 自定义错误码
-pub const SESSION_NOT_FOUND: i64 = -32000;
-pub const SESSION_CRASHED: i64 = -32001;
-pub const SPAWN_FAILED: i64 = -32002;
-pub const CHILD_TIMEOUT: i64 = -32003;
-pub const CHILD_EXITED: i64 = -32004;

-        if let Err(e) = lc.borrow_mut().switch(lang) {
-            tracing::warn!("i18n switch failed: {e}");
-        }
-    });
-    crate::kit::atoms::LANG_VERSION.set(crate::kit::atoms::LANG_VERSION.get().wrapping_add(1));
-}
-
-/// 翻译 key（无参数）。

-fn move_entry_focus(items_len: usize, current: Option<usize>, delta: i32) -> Option<usize> {
-    if items_len == 0 {
-        return None;
-    }
-    let base: i64 = match current {
-        Some(i) => i as i64,
-        None if delta < 0 => items_len as i64, // 从无焦点向上 → 最新 entry

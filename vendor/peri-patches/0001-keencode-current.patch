+            return None;
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+
+    let output = child.wait_with_output().ok()?;
+    let path = parse_user_shell_path(&output.stdout);
+    if path.is_none() {
+        warn!("The user shell did not return a usable PATH");
+    }
+    path
+}

-        }
-        ProtoError::Malformed(e) => {
-            tracing::warn!(target: "acp_hub::instance", error = %e, "入站畸形帧（计数，丢弃）");
-        }
-        ProtoError::DirectionRejected(tag) => {
-            tracing::warn!(target: "acp_hub::instance", tag, "入站帧方向违反（计数，丢弃）");
-        }
-    }
-}

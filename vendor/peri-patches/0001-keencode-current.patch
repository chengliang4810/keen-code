-// ── 衍生计算: 占比 / token 换算 / 敏感性 ──
-// 主标定: 方法 A 全局比率 (token/字节); 敏感性: 方法 C 全局 + 经验值 250/300/350 per KB
-const RATE_A = calibA.globalRatio;
-const RATE_C = calibC.globalRatio;
-const rates = {
-  methodA: RATE_A,
-  methodC: RATE_C,
-  kb250: 250 / 1024,
-  kb300: 300 / 1024,
-  kb350: 350 / 1024,
-};
-const tokensAt = (bytes: number, r: number) => bytes * r;

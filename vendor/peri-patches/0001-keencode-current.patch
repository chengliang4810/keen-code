-                        started_at: self.text_started_at,
-                        duration_ms: None,
-                        content_hash,
-                    })
-                };
-                if self.cached_view_models.len() <= trailing_idx {
-                    self.cached_view_models.push_back(trailing);
-                } else {
-                    self.cached_view_models.set(trailing_idx, trailing);
-                }
-            }
-        }

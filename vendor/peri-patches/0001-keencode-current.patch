-                        }
-                        replied_dsr = true;
-                    }
-                    if accumulated.contains(&target) {
-                        break;
-                    }
-                }
-                Err(_) => break,
-            }
-        }
-        let _ = tx.send(accumulated);
-    });
-    match rx.recv_timeout(timeout) {
-        Ok(s) => s,
-        Err(_) => shared.lock().unwrap().clone(),
-    }
-}

-                entry_id,
-                block_id,
-                text,
-                visibility,
-            } => {
-                let (turn_id, entry_id, block_id) = self.resolve_entry_ids_from_snapshot(
-                    stream,
-                    snapshot,
-                    turn_id,
-                    entry_id,
-                    block_id,
-                    "reasoning",
-                );
-                chat_writer::ensure_entry_with_blocks(
-                    txn,
-                    &root,
-                    &entry_id,
-                    EntryKind::Message,
-                    EntryRole::Assistant,
-                    Some(&turn_id),
-                    "",
-                );
-                chat_writer::append_text_delta(
-                    txn,
-                    &root,
-                    &entry_id,
-                    &block_id,

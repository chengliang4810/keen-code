-/// Down 冻结：记录 Pending 手势（屏幕坐标 + 一次性换算的内容坐标 +
-/// entry header 命中反查）。不改任何可视状态——真实拖动（Drag 超容差）
-/// 才升级为拖拽。
-pub(super) fn freeze_down(
-    screen: (u16, u16),
-    visual: (usize, u16),
-    wrap_map: &[WrappedLineInfo],
-    slot_offsets: &[usize],
-) -> GesturePending {

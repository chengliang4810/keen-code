-pub struct WorkflowProgressStore {
-    runs: RwLock<HashMap<String, RunProgress>>,
-    /// AgentStarted 仅由本次真实执行产生；resume cache-hit 只会收到 AgentDone。
-    started_agents: RwLock<HashSet<(String, u64)>>,
-}

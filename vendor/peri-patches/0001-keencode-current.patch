-    assert!(
-        lines.contains(&"第二段 with 中文"),
-        "段落 2 无前缀 chrome，实际: {text:?}"
-    );
-    for l in lines {
-        assert!(
-            !l.contains('│') && !l.starts_with(' '),
-            "行无竖线/前缀空格，实际: {l:?}"

-/// 判定时机在 Drag 分支（升级判定先于节流闸门）；Up 结算不做坐标比较，
-/// 只看手势是否仍为 Pending（是否升级过）。
-pub(super) fn is_click(down: (u16, u16), cur: (u16, u16)) -> bool {
-    cur.0.abs_diff(down.0) <= 2 && cur.1.abs_diff(down.1) <= 1

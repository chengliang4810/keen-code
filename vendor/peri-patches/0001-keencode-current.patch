-    let options: &[&str] = match row {
-        ROW_LANGUAGE => LANGUAGE_OPTS,
-        ROW_ACTIVE_ALIAS => ALIAS_OPTS,
-        ROW_PERMISSION_MODE => PERMISSION_OPTS,
-        _ => return None,
-    };
-    let cur_idx = match row {
-        ROW_LANGUAGE => LANGUAGE_OPTS
-            .iter()
-            .position(|s| cfg.config.language.as_deref() == Some(*s))
-            .unwrap_or(0),
-        ROW_ACTIVE_ALIAS => ALIAS_OPTS

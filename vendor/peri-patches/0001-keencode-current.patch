-      })
-      return
-    }
-
-    case 'workflow/kill': {
-      currentAbortController?.abort()
-      send({
-        jsonrpc: '2.0',
-        id: id!,
-        result: { ok: true },
-      })
-      return
-    }
-
-    default:
-      send({
-        jsonrpc: '2.0',
-        id: id!,
-        error: {
-          code: -32601,
-          message: `unknown method: ${method}`,
-        },
-      })

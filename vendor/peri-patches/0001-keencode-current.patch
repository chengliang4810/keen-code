-macro_rules! tui_impl_partial_eq {
-    ($ty:ty: $($field:ident),+ $(,)?) => {
-        impl PartialEq for $ty {
-            fn eq(&self, other: &Self) -> bool {
-                $(self.$field == other.$field)&&+
-            }
-        }
-    };
-}

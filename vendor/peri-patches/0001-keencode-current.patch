-    row: u16,
-    /// 按钮文本列范围（屏幕绝对坐标，[x_start, x_end)）。
-    x_start: u16,
-    x_end: u16,
-    /// 所属 VM 在 VIEW_MODELS.items 中的索引——点击时读取其 text 复制。
-    slot_index: usize,
-    /// 渲染时该 VM 的 content_hash——点击时校验索引仍指向同一 VM
-    /// （Rewind / Reset 可能增删 items 导致索引错位）。
-    vm_hash: u64,
-}

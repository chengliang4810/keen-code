-    assert!(sessions.get(&txn, "old-key").is_none(), "孤儿 key 已删除");
-    let b = sessions.get(&txn, "b").unwrap().cast::<yrs::MapRef>().unwrap();
-    assert_eq!(b.get(&txn, "title").unwrap().cast::<String>().unwrap(), "B");
-}

-      roleDistribution: Object.fromEntries(roleDistribution.map((r) => [r.role, r.count])),
-      totalToolErrors: errors.total as number,
-    };
-  }
-
-  /** 获取时间范围内统计 */
-  getFilteredStats(sinceHours: number) {

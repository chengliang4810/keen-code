-    x_start: u16,
-    x_end: u16,
-    /// 所属 VM 在 VIEW_MODELS.items 中的索引——点击时校验仍指向同一 VM。
-    slot_index: usize,
-    /// 渲染时该 VM 的 content_hash——点击时校验（Rewind / Reset 索引错位防御）。
-    vm_hash: u64,
-    /// 选项索引——提交时选择哪个 option。
-    option_index: usize,

-    if let Some(au) = pending {
-        for (i, q) in au.questions.iter().enumerate() {
-            let val = if let Some(Some(opt_idx)) = answers.get(i) {
-                if let Some(opt) = q.options.get(*opt_idx) {
-                    json!(opt.label)
-                } else {
-                    json!("")
-                }
-            } else {
-                json!("")
-            };
-            map.insert(q.id.clone(), val);
-        }
-    }
-    serde_json::Value::Object(map)
-}

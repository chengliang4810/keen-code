-        cwd_canonical.join(&path)
-    };
-    let canonical = abs
-        .canonicalize()
-        .map_err(|e| format!("path not found: {e}"))?;
-    if !canonical.starts_with(cwd_canonical) {
-        return Err(format!("path '{}' is outside the working directory", raw));

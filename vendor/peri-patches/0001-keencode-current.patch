-
-    let response = json!({
-        "action": "accept",
-        "content": answers
-    });
-
-    info!(request_id = %request_id_str, "kit ask_user_consumer: sending Accept response");
-
-    if let Err(e) = acp_client.send_response(id, Ok(response)).await {
-        error!(error = %e, "kit ask_user_consumer: send_response failed");
-    }
-}

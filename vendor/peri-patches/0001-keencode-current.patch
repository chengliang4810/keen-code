-    tracing::info!(tool = %tool_name, "print mode: auto-approving permission request");
-    let response = json!({
-        "action": "accept",
-        "content": Value::Null,
-    });
-    if let Err(e) = client.send_response(id, Ok(response)).await {
-        tracing::warn!(error = %e, "print mode: auto-approve send_response failed");
-    }

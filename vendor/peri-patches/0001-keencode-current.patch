-
-    // 面板滚轮仲裁注册（每帧覆盖写入，area 用上一帧组件区域）
-    crate::kit::panel_scroll::register_panel_scroll(PanelKind::Cron, hooks.use_previous_size(), sv);
-
-    panel_shell!(PanelKind::Cron, {
-            ScrollView(
-                scrollbars: crate::kit::panel_registry::clean_scrollbars(),

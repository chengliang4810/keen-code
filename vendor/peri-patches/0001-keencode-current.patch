-                                    }
-                                }
-                            });
-                        }
-                        "progress/event" => {
-                            if let Some(p) = params {
-                                match serde_json::from_value::<ProgressEvent>(p.clone()) {
-                                    Ok(event) => {
-                                        let run_id = event.run_id().to_string();
-                                        debug!(
-                                            target: "workflow.rpc",

-        {
-            let client = client.clone();
-            tokio::spawn(async move {
-                match client.new_session(&cwd_for_init, None).await {
-                    Ok(session_id) => {
-                        tracing::info!(%session_id, "kit: initial session created");
-                        atoms::ACTIVE_SESSION_ID.set(session_id);

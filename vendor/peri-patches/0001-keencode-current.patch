-#[test]
-fn test_format_size_bytes_below_kb() {
-    // 0 走 fallthrough 路径（UNITS 全部 threshold 都不满足 0 >= t）
-    assert_eq!(format_size(0), "0 B");
-    // 1~9 走 B 分支：v = bytes/1.0 < 10 → "X.0 B"
-    assert_eq!(format_size(1), "1.0 B");

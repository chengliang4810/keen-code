-        return false;
-    };
-    match session.resize(cols as u16, rows as u16) {
-        Ok(()) => true,
-        Err(e) => {
-            warn!("PTY resize 失败: {e}");
-            true // resize 失败也消耗掉这条消息，不当作 stdin
-        }
-    }

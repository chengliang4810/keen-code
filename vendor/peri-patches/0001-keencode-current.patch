-    cwd: currentCwd,
-    budgetTotal: currentBudget,
-    maxConcurrency,
-    resume: !!currentResumeJournal,
-  })
-
-  // 排空 stdout 后再发送终态通知
-  await waitDrain()
-
-  rpcNotify('workflow/done', {
-    runId,
-    status: result.status,
-    returnValue: result.returnValue,
-    error: result.error,
-  })
-
-  // 确保 workflow/done 消息被写入后再退出
-  await waitDrain()

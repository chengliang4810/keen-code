-
-  // ── Statistics ──
-
-  getStats() {
-    const threads = this.db
-      .query("SELECT COUNT(*) as total, SUM(CASE WHEN hidden=0 THEN 1 ELSE 0 END) as visible FROM threads")
-      .get() as any;
-    const messages = this.db
-      .query("SELECT COUNT(*) as total FROM messages")

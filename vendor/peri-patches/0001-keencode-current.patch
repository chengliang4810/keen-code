-        TuiRenderUnit::TuiCollapsedGroup(data) => {
-            format!("[Collapsed: {} ({} items)]", data.title, data.count)
-        }
-        TuiRenderUnit::TuiDivider(data) => data.label.as_deref().unwrap_or("---").to_string(),
-        TuiRenderUnit::TuiTodoSummary(data) => data.text.clone(),

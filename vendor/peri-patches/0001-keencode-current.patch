-        *ctx.last_scrolled_at.write() = ctx.total_visual_rows;
-    } else {
-        tracing::trace!(target: "msg_scroll_diag", total = ctx.total_visual_rows, prev_lsa, "auto_follow: non-loading → skip (total_rows not greater than prev_lsa)");
-    }
-}

-        // 先收集再应用（避免迭代中修改）。
-        let mut flips: Vec<usize> = Vec::new();
-        for (i, vm) in self.cached_view_models.iter().enumerate() {
-            if i == last_idx {
-                continue;
-            }
-            if let TuiRenderUnit::TuiAssistantBubble(b) = vm
-                && let Some(r) = &b.reasoning
-                && !r.collapsed

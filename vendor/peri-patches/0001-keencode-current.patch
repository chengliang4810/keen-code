-            UnifiedLangfuseEvent::SubagentStop {
-                parent_agent_id,
-                child_agent_id,
-                agent_name,
-                result,
-                is_error,
-            } => {
-                let mut reg = self.subagent_registry.lock();
-                let was_registered = reg.remove(child_agent_id).is_some();
-                self.subagent_counters.lock().1 += 1;

-use crate::kit::atoms::{self, BgDisplayEntry};
-use ratatui_kit::{
-    prelude::*,
-    ratatui::{
-        layout::{Constraint, Direction},
-        style::{Color, Style, Stylize},
-        text::{Line, Span},
-        widgets::Paragraph,
-    },

-/// 构造带真实 stdin 管道的 RpcChannel（perl 长驻子进程；跨平台：Unix 预装
-/// perl，Windows 由 Git for Windows 提供）。perl 60s 后自然退出，不留永久孤儿。
-async fn make_rpc_channel() -> RpcChannel {

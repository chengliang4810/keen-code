-
-    // 同 key 的新实例注册（同 agentId 重试/新调用）
-    let (cancel_rx_2, token_2) = ch.register_agent("run-1", 7, Some(2)).unwrap();
-    // 旧实例迟到注销：token 不匹配 → false，且不触碰新实例

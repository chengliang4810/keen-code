-
-/// 自动批准所有权限请求（等价迁移前 `PrintBroker` 语义：-p 模式无交互）。
-async fn auto_approve(
-    client: &AcpTuiClient,
-    id: peri_acp::transport::types::RequestId,
-    params: &Value,
-) {
-    let tool_call = params.get("toolCall").unwrap_or(&Value::Null);
-    let tool_name = tool_call
-        .get("title")
-        .and_then(|v| v.as_str())
-        .unwrap_or("")

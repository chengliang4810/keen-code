-                }
-                EventBody::UserMessage {
-                    turn_id,
-                    entry_id,
-                    text,
-                    author_user_id,
-                    created_at,
-                } => {
-                    // 回放模式（§8.5）：历史 user 消息无 turn_id——按回放序
-                    // 生成归位 turn（`load:{seq}`；seq 水位单调，天然幂等），

-    if let Some(au) = crate::kit::atoms::ASK_USER_PENDING.state().read().as_ref() {
-        for (i, q) in au.questions.iter().enumerate() {
-            let val = if i == 0 && !label.is_empty() {
-                serde_json::json!(label)
-            } else {
-                serde_json::json!("")
-            };
-            map.insert(q.id.clone(), val);
-        }

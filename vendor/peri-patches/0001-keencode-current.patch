-      bytes: Buffer.byteLength(text, "utf8"),
-    };
-  }
-  if (role === "tool") {
-    const c = msg.content;
-    const bytes = Buffer.byteLength(typeof c === "string" ? c : JSON.stringify(c), "utf8");
-    return {
-      role,
-      kind: "tool_result",
-      text: typeof c === "string" ? c : "",

+            r#"{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"no"}}}"#,
+        )
+        .unwrap();
+        assert_eq!(response.blocking_reason().as_deref(), Some("no"));

-    pub fn get(&self, device_id: &DeviceId) -> Option<&TrustedPeer> {
-        self.peers.iter().find(|p| &p.device_id == device_id)
-    }
-
-    pub fn contains(&self, device_id: &DeviceId) -> bool {
-        self.get(device_id).is_some()

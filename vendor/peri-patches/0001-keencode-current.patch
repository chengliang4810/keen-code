-        assert!(all.iter().all(|c| c.is_ascii()));
-    }
-
-    #[test]
-    fn test_symbols_all_ascii_distinct_except_documented() {
-        // ▸ 与 › 在 ASCII 后备中同为 '>'——规格 §4.1 明确如此降级。
-        let s = symbols(&TerminalCaps {

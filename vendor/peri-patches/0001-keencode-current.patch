+/// 创建跨平台目录符号链接，供沙箱根逃逸回归测试使用。
+#[cfg(unix)]
+fn create_directory_symlink(
+    target: &std::path::Path,
+    link: &std::path::Path,
+) -> std::io::Result<()> {
+    std::os::unix::fs::symlink(target, link)

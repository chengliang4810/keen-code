-    let msg_layout = ListLayout {
-        header_rows: 2,
-        item_rows: 1,
-        footer_rows: lines_len.saturating_sub(2 + msg_rendered + msg_extra) as u16,
-        visible_items: msg_rendered as u16,
-        scroll_start: 0,
-        item_count: msg_count,

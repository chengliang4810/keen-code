-                payload: acp_hub_proto::action::CloseChatPayload {
-                    chat_id: sid.clone(),
-                },
-            }))
-            .await?;
-            let ack = wait_terminal(&mut c, RECV_TIMEOUT).await?;
-            match ack {
-                Frame::ActionAck(a) if a.status == AckStatus::Committed => {

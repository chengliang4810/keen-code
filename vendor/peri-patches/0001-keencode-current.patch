-    excludedPerSession: groupStats(B.map((s) => s.excluded)),
-    metricsCompactTriggers: { sessions: B.filter((s) => (metricsCompact[s.id] ?? 0) > 0).length, total: B.reduce((a, s) => a + (metricsCompact[s.id] ?? 0), 0) },
-  },
-};

-        format!(
-            "{}-{}-{}-{}-{}-{}-{}-{}",
-            &hex[0..4],
-            &hex[4..8],
-            &hex[8..12],
-            &hex[12..16],
-            &hex[16..20],
-            &hex[20..24],
-            &hex[24..28],
-            &hex[28..32]
-        )

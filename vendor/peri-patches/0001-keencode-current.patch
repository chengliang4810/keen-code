-
-/// `instance/kill_ack`：kill 结果（§4.5）。
-#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
-#[serde(rename_all = "camelCase")]
-pub struct InstanceKillAck {
-    pub command_id: String,
-    pub chat_id: String,
-    pub ok: bool,

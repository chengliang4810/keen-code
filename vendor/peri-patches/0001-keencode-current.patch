-/// 解析预算响应为文件改动列表。
-pub fn parse_budget_response(resp: &Value) -> Result<Vec<RewindFileChange>, String> {
-    let changes = resp
-        .get("file_changes")
-        .and_then(|v| v.as_array())
-        .ok_or_else(|| i18n::tr("rewind-error-budget-missing"))?;
-    changes
-        .iter()
-        .map(|c| {
-            Ok(RewindFileChange {
-                path: c
-                    .get("path")
-                    .and_then(|v| v.as_str())
-                    .ok_or_else(|| i18n::tr("rewind-error-path-missing"))?
-                    .to_string(),
-                kind: c
-                    .get("kind")
-                    .and_then(|v| v.as_str())
-                    .unwrap_or("")
-                    .to_string(),
-            })
-        })
-        .collect()
-}

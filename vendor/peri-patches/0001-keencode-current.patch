-fn render_timing_enabled() -> bool {
-    thread_local! {
-        static ENABLED: bool = std::env::var("PERI_RENDER_TIMING")
-            .map(|v| v == "1" || v.eq_ignore_ascii_case("true"))
-            .unwrap_or(false);
-    }
-    ENABLED.with(|&e| e)
-}

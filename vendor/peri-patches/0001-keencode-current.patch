-            }
-            // SubagentStart/Stop:bridge 层保留 C4 注册/注销 + 日志 + 计数(指标),
-            // 归属/生命周期由 tracer registry 接管(AGENT obs 创建/关闭)。
-            UnifiedLangfuseEvent::SubagentStart {
-                parent_agent_id,
-                child_agent_id,
-                agent_name,
-                is_background,
-            } => {
-                let mut reg = self.subagent_registry.lock();
-                if reg.contains_key(child_agent_id) {

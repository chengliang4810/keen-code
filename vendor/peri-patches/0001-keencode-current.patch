-                    target: "langfuse::subagent",
-                    event = "subagent_start",
-                    %parent_agent_id,
-                    %child_agent_id,
-                    %agent_name,
-                    is_background,
-                    active = reg.len(),
-                    "SubagentStart 注册"
-                );
-                drop(reg);
-                // tracer registry:AGENT obs 创建(join 成功后) + gate 重放
-                t.on_subagent_start(parent_agent_id, child_agent_id, agent_name, *is_background);

-            let params = serde_json::json!({ "server_name": server_name });
-            if let Err(e) = client.send_raw_request("mcp/oauth_cancel", params).await {
-                tracing::warn!(error = %e, "mcp/oauth_cancel RPC failed");
-            }
-        });
-    }
-}

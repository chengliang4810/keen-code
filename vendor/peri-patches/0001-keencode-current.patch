-const waste = {
-  whiteSearchK1: 0,
-  whiteSearchK3: 0,
-  whiteSearchK5: 0,
-  whiteSearchSessionsK3: new Set<string>(),
-  reread: 0,
-  rereadBytes: 0,
-  rereadSessions: new Set<string>(),
-  dupSearch: 0,
-  dupSearchBytes: 0,
-  dupSearchSessions: new Set<string>(),
-  giantCount: 0,
-  giantBytes: 0,
-  bashNarrowband: 0,

-
-    async fn dispatch(&self, out: Outbound) -> Result<(), SendError> {
-        let mut guard = self.tx.lock().await;
-        let Some(tx) = guard.as_ref() else {
-            return Err(SendError::Disconnected);
-        };
-        match try_dispatch(tx, out) {
-            Ok(()) => Ok(()),

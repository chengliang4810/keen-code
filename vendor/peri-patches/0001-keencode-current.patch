-fn handle_language_keys(
-    state: &mut SetupWizardState,
-    key: ratatui_kit::crossterm::event::KeyEvent,
-) {
-    use KeyCode::*;
-    match key.code {
-        Up => {
-            state.language_cursor =
-                (state.language_cursor + LANGUAGE_OPTIONS.len() - 1) % LANGUAGE_OPTIONS.len();
-        }
-        Down => {

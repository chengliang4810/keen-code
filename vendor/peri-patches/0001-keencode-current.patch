-    /// 日志文件路径（诊断/测试）。
-    pub fn path(&self) -> &Path {
-        &self.path
-    }
-
-    /// degraded 状态（供 Store 聚合，§7）。
-    pub fn degraded_is_set(&self) -> bool {
-        self.degraded.is_set()
-    }

{
  "name": "keencode-desktop",
  "private": true,
  "version": "0.0.1",
  "description": "KeenCode，一款轻量、本地优先的桌面 AI 编码工具。",
  "author": "KeenCode contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite apps/ui",
    "dev:desktop": "cd apps/desktop && tauri dev",
    "build": "tsc -b apps/ui/tsconfig.json && vite build apps/ui",
    "build:desktop": "cd apps/desktop && tauri build",
    "preview": "vite preview apps/ui",
    "postinstall": "node tooling/scripts/sync-appica-scan.mjs",
    "test": "node --test tooling/scripts/release-version.test.mjs tooling/scripts/benchmark-statistics.test.mjs tooling/scripts/benchmark-batch.test.mjs tooling/scripts/clean-room-source-gate.test.mjs tooling/scripts/verify-bundle-resources.test.mjs tooling/scripts/design-system-gate.test.mjs tooling/scripts/appica-scan.test.mjs && node tooling/scripts/clean-room-source-gate.mjs && vitest run --root apps/ui",
    "test:watch": "vitest --root apps/ui",
    "typecheck": "tsc -b apps/ui/tsconfig.json --pretty false",
    "check:clean-room": "node tooling/scripts/clean-room-source-gate.mjs",
    "release:verify-bundle": "node tooling/scripts/verify-bundle-resources.mjs --target target",
    "release:version": "node tooling/scripts/release-version.mjs",
    "lint:css": "stylelint \"apps/ui/src/**/*.css\"",
    "check:design-system": "node tooling/scripts/design-system-gate.mjs",
    "benchmark:startup": "node tooling/scripts/benchmark-startup.mjs",
    "benchmark:batch": "node tooling/scripts/benchmark-batch.mjs"
  },
  "dependencies": {
    "@appica/ui-react": "^1.1.0",
    "@blobatar/react": "2.5.0",
    "@pierre/diffs": "1.3.4",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@tabler/icons-react": "^3.45.0",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "blobatar": "2.5.0",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "dompurify": "3.4.13",
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "plyr": "^3.8.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-cjk-friendly-gfm-strikethrough": "^2.3.1",
    "shiki": "^4.4.2",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "unified": "^11.0.5",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0"
}

{
  "name": "keencode-desktop",
  "private": true,
  "version": "0.0.1",
  "description": "KeenCode，一款轻量、本地优先的桌面 AI 编码工具。",
  "author": "KeenCode contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "test": "node --test scripts/release-version.test.mjs scripts/benchmark-statistics.test.mjs scripts/clean-room-source-gate.test.mjs scripts/verify-bundle-resources.test.mjs && node scripts/clean-room-source-gate.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check:clean-room": "node scripts/clean-room-source-gate.mjs",
    "release:verify-bundle": "node scripts/verify-bundle-resources.mjs --target src-tauri/target",
    "release:version": "node scripts/release-version.mjs",
    "lint:css": "stylelint \"src/styles/*.css\"",
    "benchmark:startup": "node scripts/benchmark-startup.mjs"
  },
  "dependencies": {
    "@blobatar/react": "2.5.0",
    "@pierre/diffs": "1.3.4",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@tabler/icons-react": "^3.45.0",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "blobatar": "2.5.0",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "dompurify": "3.4.13",
    "highlight.js": "^11.11.1",
    "plyr": "^3.8.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0"
}

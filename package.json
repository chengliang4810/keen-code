{
  "name": "keencode-desktop",
  "private": true,
  "version": "0.0.1",
  "description": "KeenCode 本地优先桌面 AI 编码工具。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite apps/ui",
    "dev:desktop": "cd apps/desktop && tauri dev",
    "build": "pnpm run typecheck && vite build apps/ui",
    "build:desktop": "cd apps/desktop && tauri build",
    "preview": "vite preview apps/ui",
    "test": "pnpm run test:scripts && pnpm run check:clean-room && pnpm run check:design-system && vitest run --config vitest.config.ts",
    "test:scripts": "node --test tooling/scripts/*.test.mjs",
    "test:native-live": "node tooling/scripts/native-live-e2e.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -b --force packages/model-option-map packages/shared packages/rpc packages/provider packages/services packages/client packages/ui && tsc -p apps/ui/tsconfig.json --noEmit",
    "lint:css": "stylelint \"packages/ui/src/**/*.css\"",
    "check:design-system": "node tooling/scripts/design-system-gate.mjs",
    "check:clean-room": "node tooling/scripts/clean-room-source-gate.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "border-beam": "^1.0.1",
    "stylelint": "^17.14.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.14.0"
}

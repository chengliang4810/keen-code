{
  "name": "r-code",
  "private": true,
  "version": "0.9.0-beta",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:cli": "node scripts/build-cli.mjs --release",
    "build:cli:dev": "node scripts/build-cli.mjs",
    "dev": "pnpm --filter @rcode/desktop dev",
    "dev:inspect": "pnpm --filter @rcode/desktop dev:inspect",
    "build": "pnpm --filter @rcode/desktop build",
    "preview": "pnpm --filter @rcode/desktop preview",
    "tauri": "pnpm --filter @rcode/desktop tauri",
    "test": "pnpm --filter @rcode/desktop test",
    "test:watch": "pnpm --filter @rcode/desktop test:watch",
    "bench:ghostty": "pnpm --filter @rcode/desktop bench:ghostty",
    "profile:ghostty": "node scripts/ghostty-profile.mjs",
    "soak:ghostty": "vitest run --config scripts/ghostty-soak.config.ts",
    "check-types": "pnpm --filter @rcode/desktop check-types",
    "lint": "biome lint ./apps/desktop/ui",
    "lint:fix": "biome lint --write ./apps/desktop/ui",
    "format": "biome format --write ./apps/desktop/ui",
    "format:check": "biome format ./apps/desktop/ui",
    "analyze:bundle": "pnpm --filter @rcode/desktop analyze:bundle",
    "analyze:eager": "node scripts/eager-graph.mjs apps/desktop/ui/main.tsx && node scripts/eager-graph.mjs apps/desktop/ui/settings/SettingsApp.tsx",
    "size": "node scripts/check-built-bundle.mjs && size-limit --config config/size-limit.mjs",
    "knip": "knip --config config/knip.json",
    "cli": "cargo run --locked --package rcode-cli --bin rcode-cli --"
  },
  "dependencies": {
    "@rcode/ghostty-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "^2.5.14",
    "@rolldown/plugin-babel": "^0.2.4",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^6.38.0",
    "react-compiler-healthcheck": "^1.0.0",
    "react-scan": "^0.5.7",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.21.0",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-inspect": "^12.0.2",
    "vitest": "^4.1.11",
    "@iconify-json/catppuccin": "^1.2.17"
  }
}

{
  "steps": [
    { "do": "eval", "js": "document.querySelector('.sidebar [role=button][aria-expanded]').click(); 'collapsed-toggle'", "desc": "点击侧栏项目行收起" },
    { "do": "wait", "ms": 800 },
    { "do": "assert", "js": "[...document.querySelectorAll('.sidebar [role=button][aria-expanded]')].filter(e=>e.textContent.trim()==='e2e-test-project').map(e=>e.getAttribute('aria-expanded')).join()", "desc": "基线：项目行应已收起 false" },
    { "do": "clicktext", "role": "button", "text": "搜索" },
    { "do": "wait", "ms": 700 },
    { "do": "assert", "js": "!!document.querySelector('.search-panel')", "desc": "搜索弹窗已打开" },
    { "do": "eval", "js": "(() => { const rows=[...document.querySelectorAll('.search-panel button.search-panel__row')]; const row=rows.find(e=>e.textContent.includes('e2e-test-project')); window.__c3target = row ? row.textContent.slice(0,40) : null; if(row) row.click(); return row ? 'clicked:'+row.textContent.slice(0,30) : 'row-not-found'; })()", "desc": "JS 点击弹窗内项目命中行" },
    { "do": "eval", "js": "JSON.stringify({dialogOpen:!!document.querySelector('.search-panel'), expandedNow:[...document.querySelectorAll('.sidebar [role=button][aria-expanded]')].filter(e=>e.textContent.trim()==='e2e-test-project').map(e=>e.getAttribute('aria-expanded')).join()})", "desc": "立即读弹窗关闭与展开状态" },
    { "do": "wait", "ms": 900 },
    { "do": "eval", "js": "JSON.stringify({expandedLater:[...document.querySelectorAll('.sidebar [role=button][aria-expanded]')].filter(e=>e.textContent.trim()==='e2e-test-project').map(e=>e.getAttribute('aria-expanded')).join(), projOpen:[...document.querySelectorAll('.sidebar button')].filter(e=>e.textContent.trim()==='项目').map(e=>e.getAttribute('aria-expanded')).join()})", "desc": "延时再读展开状态" }
  ]
}

-font-family);\n  --dsw-font-l-20-font-family: var(--dsw-font-family);\n  --dsw-font-l-20-font-weight: 500;\n  --dsw-font-l-20-line-height: 28px;\n  --dsw-font-l-20-font-size: 20px;\n  --dsw-font-l-20-font-style: normal;\n\n  --dsw-font-m-18: 500 16px/28px var(--dsw-font-family);\n  --dsw-font-m-18-font-family: var(--dsw-font-family);\n  --dsw-font-m-18-font-weight: 500;\n  --dsw-font-m-18-line-height: 28px;\n  --dsw-font-m-18-font-size: 16px;\n  --dsw-font-m-18-font-style: normal;\n\n  --dsw-font-base-16: 16px/24px var(--dsw-font-family);\n  --dsw-font-base-16-font-family: var(--dsw-font-family);\n  --dsw-font-base-16-font-weight: 400;\n  --dsw-font-base-16-line-height: 24px;\n  --dsw-font-base-16-font-size: 16px;\n  --dsw-font-base-16-font-style: normal;\n\n  --dsw-font-base-strong-16: 500 16px/24px var(--dsw-font-family);\n  --dsw-font-base-strong-16-font-family: var(--dsw-font-family);\n  --dsw-font-base-strong-16-font-weight: 500;\n  --dsw-font-base-strong-16-line-height: 24px;\n  --dsw-font-base-strong-16-font-size: 16px;\n  --dsw-font-base-strong-16-font-style: normal;\n\n  --dsw-font-s-14: 14px/22px var(--dsw-font-family);\n  --dsw-font-s-14-font-family: var(--dsw-font-family);\n  --dsw-font-s-14-font-weight: 400;\n  --dsw-font-s-14-line-height: 22px;\n  --dsw-font-s-14-font-size: 14px;\n  --dsw-font-s-14-font-style: normal;\n\n  --dsw-font-s-strong-14: 500 14px/22px var(--dsw-font-family);\n  --dsw-font-s-strong-14-font-family: var(--dsw-font-family);\n  --dsw-font-s-strong-14-font-weight: 500;\n  --dsw-font-s-strong-14-line-height: 22px;\n  --dsw-font-s-strong-14-font-size: 14px;\n  --dsw-font-s-strong-14-font-style: normal;\n\n  --dsw-font-xs-13: 13px/20px var(--dsw-font-family);\n  --dsw-font-xs-13-font-family: var(--dsw-font-family);\n  --dsw-font-xs-13-font-weight: 400;\n  --dsw-font-xs-13-line-height: 20px;\n  --dsw-font-xs-13-font-size: 13px;\n  --dsw-font-xs-13-font-style: normal;\n\n  --dsw-font-xs-strong-13: 500 13px/20px var(--dsw-font-family);\n  --dsw-font-xs-strong-13-font-family: var(--dsw-font-family);\n  --dsw-font-xs-strong-13-font-weight: 500;\n  --dsw-font-xs-strong-13-line-height: 20px;\n  --dsw-font-xs-strong-13-font-size: 13px;\n  --dsw-font-xs-strong-13-font-style: normal;\n\n  --dsw-font-xxs-12: 12px/18px var(--dsw-font-family);\n  --dsw-font-xxs-12-font-family: var(--dsw-font-family);\n  --dsw-font-xxs-12-font-weight: 400;\n  --dsw-font-xxs-12-line-height: 18px;\n  --dsw-font-xxs-12-font-size: 12px;\n  --dsw-font-xxs-12-font-style: normal;\n\n  --dsw-font-xxs-strong-12: 500 12px/18px var(--dsw-font-family);\n  --dsw-font-xxs-strong-12-font-family: var(--dsw-font-family);\n  --dsw-font-xxs-strong-12-font-weight: 500;\n  --dsw-font-xxs-strong-12-line-height: 18px;\n  --dsw-font-xxs-strong-12-font-size: 12px;\n  --dsw-font-xxs-strong-12-font-style: normal;\n\n  --dsw-font-xxxs-11: 11px/14px var(--dsw-font-family);\n  --dsw-font-xxxs-11-font-family: var(--dsw-font-family);\n  --dsw-font-xxxs-11-font-weight: 400;\n  --dsw-font-xxxs-11-line-height: 14px;\n  --dsw-font-xxxs-11-font-size: 11px;\n  --dsw-font-xxxs-11-font-style: normal;\n\n  --dsw-font-xxxs-strong-11: 500 11px/14px var(--dsw-font-family);\n  --dsw-font-xxxs-strong-11-font-family: var(--dsw-font-family);\n  --dsw-font-xxxs-strong-11-font-weight: 500;\n  --dsw-font-xxxs-strong-11-line-height: 14px;\n  --dsw-font-xxxs-strong-11-font-size: 11px;\n  --dsw-font-xxxs-strong-11-font-style: normal;\n}\r\n\r\n:root {\r\n  color-scheme: dark;\r\n  /* ---- Feature palettes (ZCode Zai light defaults; dark overrides below) ---- */\n  /* Git change kinds (badges) + file kind marks. */\n  --change-added: #1e8a3e;\n  --change-new: #1e8a3e;\n  --change-new-ink: #1e8a3e;\n  --change-deleted: #e03131;\n  --change-typechange: #e07b00;\n  --change-renamed: #0b7fff;\n  --change-copied: #0b7fff;\n  --change-conflict: #e07b00;\n  --kind-git: #e07b00;\n  --kind-img: #7453b0;\n  /* Directory / URL accents (ZCode file-node foreground, attach chips, path icons). */\n  --dir-accent: #1a70b8;\n  --dir-accent-soft: #1a70b8;\n  /* Extensions panel badges */\r\n  --ext-plugin: #c49bff;\r\n  --ext-disabled: #9aa0a6;\r\n  /* Chat find marks (current vs alternate match) */\r\n  --find-current: #ff9f0a;\r\n  --find-current-strong: #ffb020;\r\n  --find-alt: #e6b800;\r\n  --find-alt-strong: #f5d76e;\r\n  /* Fixed ink & canvases (video letterbox, media overlays, paper pages) */\r\n  --ink-black: #000000;\r\n  --ink-on-media: #ffffff;\r\n  --paper-canvas: #ffffff;\r\n  --ink-on-paper: #1a1a1a;\r\n  --icon-tile-bg: rgba(127, 127, 127, 0.08);\r\n  /* xterm theme inputs; TerminalPanel resolves these variables at runtime. */\n  --terminal-bg: #f8f8f8;\n  --terminal-fg: #282828;\n  --terminal-cursor: #0d0d0d;\n  --terminal-cursor-accent: #f8f8f8;\n  --terminal-selection: rgba(11, 127, 255, 0.22);\n  --terminal-selection-inactive: rgba(13, 13, 13, 0.1);\n  --terminal-canvas: var(--terminal-bg);\n  --surface-tint-light: #eef0f3;\r\n  --ext-warn: #e0b44a;\r\n  /* 思考强度滑块的品牌色与“快速”色。轨道与旋钮在深浅主题下都使用这组固定值，\r\n   * 与画面动效的取值同源，避免画布与 DOM 出现两套颜色。 */\r\n  --effort-brand: #cc6b47;\r\n  --effort-brand-ink: #ed9470;\r\n  --effort-fast: #ffd65c;\r\n  --effort-fast-ink: #eda821;\n  --effort-spark: #ffffff;\n  /* Analytics 使用固定的可区分色板；业务组件只引用语义变量。 */\n  --analytics-model-1: #1683f8;\n  --analytics-model-2: #209447;\n  --analytics-model-3: #9567ec;\n  --analytics-model-4: #ed3434;\n  --analytics-model-5: #e78000;\n  --analytics-model-6: #0ba6a6;\n  --analytics-model-7: #e85ca3;\n  --analytics-model-8: #64748b;\n\r\n\r\n  --space-1: 4px;\r\n  --space-2: 8px;\r\n  --space-3: 12px;\r\n  --space-4: 16px;\r\n  --space-5: 20px;\r\n  /* ZCode composer uses a 16px shell radius; the remaining radii stay semantic. */\n  --radius-window: 16px;\n  --radius-composer: 16px;\n  /* ZCode conversation frame 的平台圆角；不复用通用 radius-sm/md。 */\n  --radius-workspace-win: 5px;\n  --radius-workspace-mac: 6px;\n  --radius-workspace-other: 12px;\n  --radius-lg: 12.5px;\n  /* Harness 消息统计胶囊的原始圆角。 */\r\n  --radius-stat: 28px;\r\n  --radius-md: 10px;\r\n  --radius-sm: 7.5px;\r\n  --radius-xs: 5px;\r\n  --radius-2xs: 2.5px;\r\n  --radius-full: 9999px;\r\n  --radius-settings: 30px;\r\n  --sidebar-width: 264px;\n  --content-max-width: 920px;\r\n  --aside-width: 360px;\r\n  /* ZCode desktop shell keeps a 48px drag/header band. */\n  --titlebar-height: 48px;\n  --control-height: 36px;\n  --titlebar-safe-left: 96px;\n  --sidebar-leading-icon-center: 26px;\n  /* 共享控件的 ZCode md 几何；不使用 rem，避免随 UI 根字号折算。 */\n  --control-height-compact: 28px;\n  --control-height-tabs: 32px;\n  --control-radius-compact: 10px;\n  /* 跨平台 UI 字体栈：优先系统字体，显式保留中文 fallback。 */\n  --dsw-font-family: -apple-system-body, ui-sans-serif, -apple-system, system-ui,\r\n    'Segoe UI', 'Helvetica', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei',\r\n    'Apple Color Emoji', 'Arial', sans-serif, 'Segoe UI Emoji', 'Segoe UI Symbol';\r\n  --ds-font-family-code: ui-monospace, 'SFMono-Regular', 'SF Mono', Menlo, Consolas,\r\n    'Liberation Mono', 'PingFang SC', 'Microsoft YaHei';\r\n  /* UI 正文权重；Windows 非可变字体会由浏览器就近取整。 */\n  --font-ui-weight: 430;\r\n  /* KeenCode 全局过渡默认 150ms。 */\n  --ds-transition-duration: 0.15s;\r\n  --ds-transition-duration-fast: 0.15s;\r\n  --font-sans: var(--dsw-font-family);\r\n  /* 显式中文后备字体防止 Windows 代码区域落入宋体。 */\r\n  --font-mono: var(--ds-font-family-code);\r\n  /* 界面字号：全部界面文字尺寸的唯一输入，默认 14px（12–20 由运行时写入）。\r\n   * --ui-font-delta 是相对 14px 基线的像素增量，文字令牌与硬编码字号按同一\r\n   * 增量随动，因此层级差值保持不变；图标字形与控件几何不读该变量。 */\r\n  --ui-font-size: 14px;\r\n  --ui-font-delta: calc(var(--ui-font-size) - 14px);\r\n  --text-xs: calc(12px + var(--ui-font-delta));\r\n  --text-sm: calc(13px + var(--ui-font-delta));\r\n  --text-md: var(--ui-font-size);\r\n  --text-lg: calc(16px + var(--ui-font-delta));\r\n  --text-xl: calc(28px + var(--ui-font-delta));\r\n  /* Harness 的 Markdown / 回合统计排版令牌按 --dsh-content-font-size 派生，\r\n   * 其上游未提供写入方；在此接到界面字号，使对话正文与标题层级随之缩放。 */\r\n  --dsh-content-font-size: var(--ui-font
dy {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  min-height: 0;\r\n}\r\n\r\n.wallpaper-focus-modal__hint {\r\n  margin: 0;\r\n  font-size: calc(12.5px + var(--ui-font-delta));\r\n  line-height: 1.45;\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.wallpaper-focus-modal__footer-spacer {\r\n  flex: 1;\r\n  min-width: 8px;\r\n}\r\n\r\n.wallpaper-focus-stage {\r\n  position: relative;\r\n  width: 100%;\r\n  height: min(52vh, 440px);\r\n  min-height: 220px;\r\n  border-radius: var(--radius-md);\r\n  border: 1px solid var(--border-subtle);\r\n  background: color-mix(in srgb, var(--ink-black) 55%, var(--bg-elevated));\r\n  overflow: hidden;\r\n  touch-action: none;\r\n  user-select: none;\r\n}\r\n\r\n.wallpaper-focus-stage__media {\r\n  display: block;\r\n  max-width: none;\r\n  /* Video: keep decode cheap — no filters / blend modes on the element. */\r\n  pointer-events: none;\r\n}\r\n\r\n.wallpaper-focus-frame {\r\n  position: absolute;\r\n  left: 0;\r\n  top: 0;\r\n  box-sizing: border-box;\r\n  /* Dim outside the crop with a huge box-shadow (no extra video layer). */\r\n  box-shadow: 0 0 0 9999px color-mix(in srgb, var(--ink-black) 52%, transparent);\r\n  border: 2px solid color-mix(in srgb, var(--accent) 85%, var(--ink-on-media));\r\n  border-radius: var(--radius-xs);\r\n  cursor: grab;\r\n  touch-action: none;\r\n  will-change: transform, width, height;\r\n}\r\n\r\n.wallpaper-focus-frame:active {\r\n  cursor: grabbing;\r\n}\r\n\r\n.wallpaper-focus-frame__edge {\r\n  position: absolute;\r\n  inset: 6px;\r\n  border: 1px dashed color-mix(in srgb, var(--ink-on-media) 55%, transparent);\r\n  border-radius: var(--radius-2xs);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Video clip dual-handle timeline */\r\n.wallpaper-clip {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n}\r\n\r\n.wallpaper-clip__head {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.wallpaper-clip_
 z-index: 10050;\r\n  max-height: min(360px, 50vh);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-width: 240px;\r\n  background: var(--menu-context-bg);\r\n  backdrop-filter: none;\r\n  -webkit-backdrop-filter: none;\r\n  border: 1px solid var(--menu-context-border, var(--border-subtle));\r\n  box-shadow: var(--menu-context-shadow, var(--glass-shadow));\r\n  transform: none;\r\n  isolation: auto;\r\n}\r\n.cpm__actions {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: stretch;\r\n  gap: 4px;\r\n  flex-shrink: 0;\r\n  padding-top: 6px;\r\n  border-top: 1px solid var(--border-subtle);\r\n}\r\n/* Project list keeps the panel stable and scrolls independently. */\r\n.cpm__list {\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  flex-shrink: 0;\n  overscroll-behavior: contain;\n  height: 220px;\n}\n.cpm__pop .cpm__item {\r\n  align-items: center;\r\n  margin: 0;\r\n  flex-shrink: 0;\r\n}\r\n.cpm__pop .cpm__item .cmm__opt-check {\r\n  margin-top: 0;\r\n}\r\n\r\n/* ===== KeenCode settings full page ===== */\r\n.settings-page {\r\n  display: flex;\r\n  flex-direction: row;\r\n  flex: 1;\r\n  min-height: 0;\r\n  height: 100%;\r\n  width: 100%;\r\n  background: var(--bg-elevated);\r\n  color: var(--text-primary);\r\n  position: relative;\r\n  border-radius: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n/* 异步加载设置页时仍绘制主题底色，避免暴露 WebView 的默认背景。 */\r\n.settings-page.settings-page--fallback {\r\n  background: var(--bg-main);\r\n}\r\n\r\n/*\r\n * Full-width drag overlay — sits on top of nav + content so the whole\r\n * titlebar band can move the window (mac Overlay traffic lights ok).\r\n */\r\n.settings-page__chrome {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  height: var(--titlebar-height, 40px);\r\n  z-index: 30;\r\n  user-select: none;\r\n  -webkit-app-region: drag;\r\n  app-region: drag;\r\n  background: transparent;\r\n  pointer-events: auto;\r\n  display: block;\r\n}\r\n\r\n.settings-page__skip-link {\r\n  position: absolute;\r\n  top: 8px;\r\n  left: 12px;\r\n  z-index: 60;\r\n  padding: 7px 10px;\r\n  border-radius: var(--radius-md);\r\n  background: var(--bg-elevated);\r\n  color: var(--text-primary);\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  font-weight: 600;\r\n  box-shadow: var(--shadow-pop);\r\n  transform: translateY(-160%);\r\n  transition: transform var(--motion-fast) var(--ease-out);\r\n}\r\n\r\n.settings-page__skip-link:focus-visible {\r\n  transform: translateY(0);\r\n}\r\n\r\n.settings-page__nav {\r\n  width: 188px;\r\n  min-width: 188px;\r\n  max-width: 188px;\r\n  flex-shrink: 0;\r\n  border-right: none;\r\n  /* 设置侧栏与面板共享实色表面。 */\r\n  background: transparent;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n  /* 全窗口设置页的导航与正文共同避让原生标题栏。 */\r\n  padding-top: calc(var(--titlebar-height, 40px) + 14px);\r\n  box-sizing: border-box;\r\n}\r\n\r\n.settings-page__nav-header {\r\n  flex-shrink: 0;\r\n  padding: 0 12px 12px;\r\n  -webkit-app-region: no-drag;\r\n  app-region: no-drag;\r\n}\r\n\r\n.settings-page__mobile-nav {\r\n  display: none;\r\n}\r\n\r\n.settings-page__nav-inner {\r\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  padding: 0 12px 24px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  -webkit-app-region: no-drag;\r\n  app-region: no-drag;\r\n}\r\n\r\n/* 纵向导航按侧栏宽度建立稳定选区，避免激活态退化成包住文字的小胶囊。 */\r\n.settings-page__nav-inner [data-slot=\"navigation-list\"],\r\n.settings-page__nav-inner [data-slot=\"navigation-item\"],\r\n.settings-page__nav-inner [data-slot=\"navigation-link\"] {\r\n  width: 100%;\r\n}\r\n\r\n.settings-page__back {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n  gap: var(--space-2);\r\n  width: 100%;\r\n  height: 30px;\r\n  padding: 0 10px 0 calc(var(--sidebar-leading-icon-center) - 20px);\r\n  margin-bottom: 4px;\r\n  text-align: left;\r\n}\r\n\r\n.settings-page__tabs {\r\n  margin-bottom: 14px;\r\n  position: relative;\r\n  z-index: 1;\r\n  pointer-events: auto;\r\n  -webkit-app-region: no-drag;\r\n  app-region: no-drag;\r\n}\r\n\r\n.settings-page__tabs-seg {\r\n  flex-wrap: wrap;\r\n  max-width: 100%;\r\n  pointer-events: auto;\r\n}\r\n\r\n.settings-page__tabs .settings-seg__btn {\r\n  pointer-events: auto;\r\n  cursor: pointer;\r\n  -webkit-app-region: no-drag;\r\n  app-region: no-drag;\r\n}\r\n\r\n.settings-page__nav-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.settings-page__group-label {\r\n  margin: 12px 10px 4px calc(var(--sidebar-leading-icon-center) - 20px);\r\n  font-size: var(--text-sm);\r\n  font-weight: 500;\r\n  line-height: 20px;\r\n  color: var(--text-secondary);\r\n  letter-spacing: 0;\r\n}\r\n\r\n/* Section changes focus the heading for screen-reader context. It is not in\r\n * the tab order, so a persistent box around the title would be visual noise. */\r\n.settings-page__title:focus-visible {\r\n  outline: none;\r\n}\r\n\r\n/*\r\n * Content column — sole vertical scrollport for every settings section.\r\n *\r\n * CRITICAL (WebKit / Tauri): do NOT make this a flex container.\r\n * When overflow-y:auto AND display:flex are combined, WebKit omits the\r\n * container's padding-bottom (and flex items' padding-bottom) from the\r\n * scrollable overflow height. max scrollTop ends flush with the last\r\n * child's border box → every section looks glued to the window bottom.\r\n *\r\n * Center the column with margin:auto on .settings-page__main instead.\r\n */\r\n.settings-page__content {\r\n  flex: 1;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  background: transparent;\r\n  display: block;\r\n  /* Clear drag band so title is not under traffic lights / drag strip */\r\n  padding-top: calc(var(--titlebar-height, 40px) + 14px);\r\n  box-sizing: border-box;\r\n  -webkit-app-region: no-drag;\r\n  app-region: no-drag;\r\n}\r\n\r\n.set
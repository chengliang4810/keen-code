-secondary);\r\n  text-wrap: pretty;\r\n}\r\n\r\n/* Stacked settings cards (e.g. Appearance: theme / skin / wallpaper) */\r\n.settings-page__main > [data-slot=\"card\"] + [data-slot=\"card\"] {\r\n  margin-top: 14px;\r\n}\r\n\r\n/* Appica Card 默认只有紧凑内距；设置表单需要更清晰的桌面端内容边界。 */\r\n.settings-page__main > [data-slot=\"card\"] > [data-slot=\"card-content\"],\r\n.settings-appearance-duo > [data-slot=\"card\"] > [data-slot=\"card-content\"] {\r\n  padding: 16px;\r\n}\r\n\r\n.settings-row {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  min-height: 64px;\r\n  padding: 16px 0;\r\n  border-bottom: 0.5px solid var(--dsw-alias-border-l2);\r\n}\r\n\r\n[data-slot=\"card-content\"] > .settings-row:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.settings-row.is-disabled {\r\n  opacity: 0.48;\r\n}\r\n\r\n.settings-row--stack {\r\n  flex-direction: column;\r\n  align-items: stretch;\r\n}\r\n\r\n.settings-row__text {\r\n  min-width: 0;\r\n  flex: 1;\r\n}\r\n\r\n.settings-row__label {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: calc(14px + var(--ui-font-delta));\r\n  font-weight: 400;\r\n  color: var(--text-primary);\r\n  line-height: calc(22px + var(--ui-font-delta));\r\n}\r\n\r\n.settings-row__desc {\n  margin-top: 4px;\n  font-size: calc(13px + var(--ui-font-delta));\n  line-height: calc(20px + var(--ui-font-delta));\n  color: var(--text-secondary);\n  text-wrap: pretty;\n}\n\n.web-host-settings__status,\n.web-host-settings__token {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  min-width: 0;\n  flex-wrap: wrap;\n}\n\n.web-host-settings__status {\n  justify-content: flex-end;\n}\n\n.web-host-settings__status-dot {\n  width: 8px;\n  height: 8px;\n  flex: 0 0 8px;\n  border-radius: var(--radius-full);\n  background: var(--text-tertiary);\n}\n\n.web-host-settings__status[data-state=\"running\"] .web-host-settings__status-dot {\n  background: var(--success);\n}\n\n.web-host-s
px;\r\n  padding: 6px 12px;\r\n  border-top: 1px solid var(--border-subtle);\r\n  color: var(--text-tertiary);\r\n  font-size: calc(11px + var(--ui-font-delta));\r\n  font-variant-numeric: tabular-nums;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* ===== Skill chips (composer + messages) ===== */\r\n.skill-chip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  max-width: 100%;\r\n  padding: 1px 8px 1px 6px;\r\n  margin: 0 2px;\r\n  border-radius: var(--radius-full);\r\n  background: var(--bg-hover);\r\n  border: 1px solid var(--border-subtle);\r\n  color: var(--text-primary);\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  line-height: calc(18px + var(--ui-font-delta));\r\n  vertical-align: middle;\r\n  user-select: none;\r\n  white-space: nowrap;\r\n}\r\n.skill-chip--sm {\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  line-height: calc(16px + var(--ui-font-delta));\r\n  padding: 0 7px 0 5px;\r\n}\r\n.skill-chip__icon,\r\n.skill-chip__glyph {\r\n  display: inline-flex;\r\n  flex-shrink: 0;\r\n  opacity: 0.75;\r\n  font-size: 11px;\r\n}\r\n.skill-chip__name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  max-width: 12rem;\n}\n\n/* 结构化 @ 引用在编辑器和用户消息中共用同一套原子外观。 */\n.composer-mention {\n  display: inline-flex;\n  align-items: center;\n  max-width: 100%;\n  margin: 0 2px;\n  padding: 0 7px;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-full);\n  color: var(--text-primary);\n  background: var(--bg-hover);\n  font-size: calc(12px + var(--ui-font-delta));\n  line-height: calc(18px + var(--ui-font-delta));\n  vertical-align: middle;\n  user-select: none;\n  white-space: nowrap;\n}\n\n.composer-mention--file {\n  border-color: color-mix(in srgb, var(--accent) 35%, var(--border-subtle));\n  background: color-mix(in srgb, var(--accent-muted) 50%, var(--bg-hover));\n}\n\n.composer-mention--directory {\n  border-color: color-mix(in srgb, var(--success) 45%, var(--border-subtle));\n  background: color-mix(in srgb, var(--success-muted) 55%, var(--bg-hover));\n}\n\n.composer-mention--session {\n  border-color: color-mix(in srgb, var(--warning) 42%, var(--border-subtle));\n  background: color-mix(in srgb, var(--warning-muted) 50%, var(--bg-hover));\n}\n\n.composer-mention--plugin {\n  border-color: color-mix(in srgb, var(--info) 38%, var(--border-subtle));\n  background: color-mix(in srgb, var(--info-muted) 50%, var(--bg-hover));\n}\n\n.composer-mention--skill {\n  border-color: color-mix(in srgb, var(--accent) 28%, var(--border-subtle));\n}\n\r\n/* Contenteditable composer */\r\n.composer-editor-wrap {\n  position: relative;\n  width: 100%;\n}\n\n.composer-editor-dropzone {\n  position: relative;\n  min-width: 0;\n  border-radius: var(--radius-md);\n}\n\n.composer-editor-dropzone--active {\n  outline: 1px dashed var(--accent);\n  outline-offset: 4px;\n  background: color-mix(in srgb, var(--accent-muted) 35%, transparent);\n}\n\n.composer-editor-dropzone__hint {\n  position: absolute;\n  inset: 0;\n  z-index: 2;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius-md);\n  background: color-mix(in srgb, var(--bg-input) 78%, var(--accent-muted));\n  color: var(--text-primary);\n  font-size: calc(12px + var(--ui-font-delta));\n  line-height: calc(20px + var(--ui-font-delta));\n  pointer-events: none;\n}\n\n.composer-editor__placeholder {\n  position: absolute;\n  left: 0;\n  top: 0;\n  right: 0;\n  color: var(--text-secondary);\n  font-size: calc(14px + var(--ui-font-delta));\n  line-height: calc(20px + var(--ui-font-delta));\n  pointer-events: none;\n  white-space: pre-wrap;\r\n  /* Sit fully behind editor ink; never paint over typed glyphs */\r\n  z-index: 0;\r\n  user-select: none;\r\n}\r\n.composer-editor-wrap > .composer__input {\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\ndiv.composer__input {\n  white-space: pre-wrap;\n  word-break: break-word;\n  min-height: 40px;\n  max-height: 160px;\n  outline: none;\n}\ndiv.composer__input:empty::before {\r\n  content: none;\r\n}\r\n\r\n/* Current-session prompt history (`/history` + empty ↑) */\r\n.prompt-history {\r\n  z-index: 10050;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  box-sizing: border-box;\r\n  max-width: calc(100vw - 16px) !important;\r\n  max-height: min(360px, 50vh);\r\n  padding: var(--menu-pad);\r\n  border-radius: var(--menu-radius);\r\n  color: var(--text-primary);\r\n  overflow: hidden;\r\n}\r\n.prompt-history__head {\r\n  padding: 2px 8px 0;\r\n}\r\n.prompt-history__title {\r\n  font-size: calc(11px + var(--ui-font-delta));\r\n  font-weight: 500;\r\n  color: var(--text-tertiary);\r\n  letter-spacing: 0.02em;\r\n  user-select: none;\r\n}\r\n.prompt-history__filter {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 0 4px;\r\n  padding: 6px 8px;\r\n  border-radius: var(--radius-md);\r\n  background: color-mix(in srgb, var(--text-primary) 6%, transparent);\r\n  border: 1px solid color-mix(in srgb, var(--text-primary) 8%, transparent);\r\n}\r\n.prompt-history__filter-ico {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  color: var(--text-tertiary);\r\n}\r\n.prompt-history__input {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  border: none;\r\n  outline: none;\r\n  background: transparent;\r\n  color: var(--text-primary);\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  line-height: 1.3;\r\n}\r\n.prompt-history__input::placeholder {\r\n  color: var(--text-tertiary);\r\n}\r\n.prompt-history__input::-webkit-search-cancel-button {\r\n  appearance: none;\r\n}\r\n.prompt-history__list {\r\n  flex: 1 1 auto;\r\n  min-height: 0;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n.prompt-history__item {\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n  min-height: 36px;\r\n  text-align: left;\r\n  box-sizing: border-box;\r\n}\r\n.prompt-history__item-text {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n.prompt-history__empty {\r\n  padding: 14px 10px;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--text-tertiary);\r\n  text-align: center;\r\n}\r\n/* Goal mode chip — compact “Goal active” status with clear affordance */\r\n\r\n/* Status modal */\r\n.status-modal__dl {\r\n  margin: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  flex: 1;\r\n  min-height: 0;\r\n  max-height: 360px;\r\n  overflow: auto;\r\n  padding: 2px 0;\r\n}\r\n\r\n.status-modal__row {\r\n  display: grid;\r\n  grid-template-columns: 7.5rem 1fr;\r\n  gap: 8px;\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  align-items: baseline;\r\n}\r\n\r\n.status-modal__row dt {\r\n  color: var(--text-tertiary);\r\n  margin: 0;\r\n}\r\n\r\n.status-modal__row dd {\r\n  margin: 0;\r\n  color: var(--text-primary);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n/* Compact confirm */\r\n\r\n/* 搜索遮罩显式固定并居中，避免 WebView2 将其降级成底部布局项。 */\r\n.search-overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 24px;\r\n}\r\n\r\n/* User message skill inline */\r\n.user-msg-body {\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n/* ── Settings → Extensions (Skills / MCP) ─────────────────────────────────── */\r\n.ext-panel {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0;\r\n  min-width: 0;\r\n}\r\n\r\n.ext-path-btn {\r\n  max-width: 100%;\r\n  margin: 0;\r\n  min-width: 0;\r\n}\r\n\r\n.ext-path-btn span {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.ext-card {\r\n  margin-bottom: 4px;\r\n}\r\n\r\n.settings-page__main > .ext-agent-card > [data-slot=\"card-content\"] {\r\n  padding: 0;\r\n}\r\n\r\n.ext-agent-card {\r\n  overflow: hidden;\r\n}\r\n\r\n.ext-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.ext-list > .ext-agent-row {\r\n  display: grid;\r\n  grid-template-columns: 48px minmax(0, 1fr) auto;\r\n  align-items: center;\r\n  gap: 16px;\r\n  min-height: 84px;\r\n  padding: 14px 16px;\r\n}\r\n\r\n.ext-agent-row__icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 48px;\r\n  height: 48px;\r\n  color: var(--text-secondary);\r\n  background: var(--bg-input, var(--bg-elevated));\r\n  border-radius: var(--radius-md);\r\n}\r\n\r\n.ext-agent-row__content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n\r\n.ext-agent-row__heading {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n.ext-agent-row .ext-item__head-btn {\r\n  flex: 0 1 auto;\r\n  height: auto;\r\n  min-width: 0;\r\n  padding: 0;\r\n  font-size: inherit;\r\n}\r\n\r\n.ext-agent-row .ext-item__desc {\r\n  display: -webkit-box;\r\n  overflow: hidden;\r\n  -webkit-box-orient: vertical;\r\n  -webkit-line-clamp: 2;\r\n}\r\n\r\n.ext-agent-row .ext-path-btn {\r\n  align-self: flex-start;\r\n  width: auto;\r\n  height: auto;\r\n  padding: 0;\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.ext-agent-row__controls {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n.ext-bulk-btn {\r\n  margin-left: auto;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  padding: 2px 8px;\r\n  height: auto;\r\n}\r\n\r\n.ext-h2-actions {\r\n  margin-left: auto;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: 4px;\r\n}\r\n\r\n.ext-h2-actions .ext-bulk-btn {\r\n  margin-left: 0;\r\n}\r\n\r\n.ext-field-hint {\r\n  display: block;\r\n  margin-top: 4px;\r\n  font-size: calc(11.5px + var(--ui-font-delta));\r\n  line-height: 1.4;\r\n  color: var(--text-tertiary
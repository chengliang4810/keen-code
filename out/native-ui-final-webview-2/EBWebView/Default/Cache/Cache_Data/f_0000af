art;\n  gap: 8px;\n  width: auto;\n  max-width: 100%;\n  padding: 6px 24px 6px 6px;\n}\r\n\r\n.attach-chip--image .attach-chip__main {\r\n  width: 100%;\r\n  padding: 0;\r\n  justify-content: center;\r\n}\r\n\r\n.attach-chip__thumb {\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  border-radius: var(--radius-sm);\r\n}\r\n\r\n.attach-chip__icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--text-tertiary);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.attach-chip--dir {\r\n  border-color: color-mix(in srgb, var(--dir-accent-soft) 35%, transparent);\r\n  background: color-mix(in srgb, var(--dir-accent-soft) 8%, transparent);\r\n}\r\n\r\n.attach-chip--dir .attach-chip__icon {\r\n  color: var(--dir-accent);\r\n}\r\n\r\n.attach-chip__name {\n  display: block;\r\n  min-width: 0;\r\n  max-width: 160px;\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  text-align: left;\r\n  line-height: 1.2;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.attach-chip__main:hover .attach-chip__name {\n  color: var(--text-primary);\n}\n\n.attach-chip__type,\n.att-card__type {\n  display: block;\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  color: var(--text-tertiary);\n  font-size: calc(10px + var(--ui-font-delta));\n  line-height: calc(12px + var(--ui-font-delta));\n  text-transform: uppercase;\n}\n\r\n.attach-chip__x {\n  --x-size: 20px;\n  position: absolute;\n  top: 2px;\n  right: 2px;\n  width: var(--x-size);\r\n  height: var(--x-size);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  opacity: 0;\n  transition: opacity var(--motion-fast) var(--ease-out);\r\n  z-index: 2;\r\n}\r\n\r\n.attach-chip:hover .attach-chip__x,\n.attach-chip:focus-within .attach-chip__x,\n.attach-chip__x:hover,\n.attach-chip__x:focus-visible {\n  opacity: 1;\n}\n\n@media (hover: none) {\n  .attach-chip__x {\n    opacity: 1;\n  }\n}\n\r\n/* Message attachment cards */\r\n.att-card {\r\n  --attach-h: 36px;\r\n  --attach-file-max-w: 220px;\r\n  position: relative;\r\n  height: var(--attach-h);\r\n  min-height: var(--attach-h);\r\n  box-sizing: border-box;\r\n}\r\n\r\n.att-card--image {\r\n  width: var(--attach-h);\r\n  flex: 0 0 var(--attach-h);\r\n}\r\n\r\n.att-card:not(.att-card--image) {\r\n  width: max-content;\r\n  max-width: var(--attach-file-max-w);\r\n  flex: 0 1 auto;\r\n}\r\n\r\n.att-card__btn {\r\n  display: flex;\r\n  align-items: center;\r\n  width: 100%;\r\n  height: 100%;\r\n  min-height: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* File row */\r\n.att-card:not(.att-card--image) .att-card__btn {\r\n  flex-direction: row;\r\n  justify-content: flex-start;\r\n  gap: 8px;\r\n  padding: 0 10px 0 8px;\r\n  text-align: left;\r\n}\r\n\r\n.att-card__btn--image {\r\n  padding: 0;\r\n  justify-content: center;\r\n}\r\n\r\n.att-card__meta {\r\n  min-width: 0;\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.att-card__name {\n  max-width: 160px;\n  font-size: calc(12px + var(--ui-font-delta));\n  font-weight: 500;\n  color: var(--text-primary);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  line-height: 1.2;\n  text-align: left;\n}\n\n.att-card--uploading {\n  border-color: color-mix(in srgb, var(--accent) 42%, var(--border-subtle));\n}\n\n.att-card--failed {\n  border-color: color-mix(in srgb, var(--danger) 58%, var(--border-subtle));\n}\n\n.att-card__status {\n  position: absolute;\n  right: 4px;\n  bottom: 2px;\n  left: 4px;\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 2px;\n  min-height: 16px;\n  padding: 1px 3px;\n  border-radius: var(--radius-xs);\n  background: color-mix(in srgb, var(--bg-app) 82%, transparent);\n  color: var(--text-tertiary);\n  font-size: var(--text-xs);\n  line-height: 1;\n}\n\n.att-card--failed .att-card__status {\n  color: var(--danger);\n}\n\r\n/* Path available via tooltip */\r\n\r\n/* Markdown inline images — RATIO-AWARE FRAME\r\n *\r\n * Frame always has a non-zero size (default 4:3, then natural ratio from JS)\r\n * so scrollHeight never collapses to 0 mid-decode. Width/height follow the\r\n * image; max 280×280. Inline style sets width + aspect-ratio per image.\r\n */\r\n.md-body__img-frame {\r\n  display: block;\r\n  position: relative;\r\n  box-sizing: border-box;\r\n  margin: 10px 0;\r\n  overflow: hidden;\r\n  background: color-mix(in srgb, var(--bg-hover) 80%, transparent);\r\n  vertical-align: middle;\r\n  /* Height comes from aspect-ratio (set inline); never leave empty box */\r\n  height: auto;\r\n}\r\n\r\n.md-body__img-frame--card {\r\n  max-width: min(100%, 280px);\r\n  max-height: 280px;\r\n  border-radius: var(--radius-window);\r\n  border: 1px solid var(--border-subtle);\r\n  box-shadow: 0 1px 0 color-mix(in srgb, var(--ink-black) 0.04%, transparent);\r\n}\r\n\r\n/* Resource sidebar / full-width previews — no chat 280 cap */\r\n.md-body__img-frame--pane {\r\n  width: 100%;\r\n  max-width: 100%;\r\n  max-height: none;\r\n  margin: 0;\r\n  border-radius: var(--radius-md);\r\n  border: none;\r\n  box-shadow: none;\r\n  background: transparent;\r\n}\r\n\r\n.md-body__img-frame--thumbnail {\r\n  flex-shrink: 0;\r\n  margin: 0;\r\n}\r\n\r\n.md-body__img-frame--thumbnail .md-body__img-frame__el {\r\n  object-fit: cover;\r\n}\r\n\r\n.md-body__img-frame__el {\r\n  display: block;\r\n  /* Absolute fill: % height of aspect-ratio boxes is unreliable in WebKit */\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  /* Box matches natural ratio → contain fills without crop or letterbox */\r\n  object-fit: contain;\r\n  object-position: center;\r\n  border: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  border-radius: inherit;\r\n  cursor: zoom-in;\r\n  opacity: 1;\r\n}\r\n\r\n.md-body__img-frame.is-pending {\r\n  background: color-mix(in srgb, var(--bg-hover) 80%, transparent);\r\n}\r\n\r\n.md-body__img-frame.is-broken {\r\n  border-style: dashed;\r\n  background: color-mix(in srgb, var(--bg-hover) 60%, transparent);\r\n}\r\n\r\n.md-body__img-frame__fallback {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  min-height: 0;\r\n  padding: 8px 12px;\r\n  box-sizing: border-box;\r\n  color: var(--text-tertiary);\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  text-align: center;\r\n  word-break: break-all;\r\n}\r\n\r\n.md-body__img,\r\n.md-body__img--card {\r\n  /* Size lives on .md-body__img-frame--card; bare img rules must not fight it */\r\n  max-width: 100%;\r\n}\r\n\r\n/* Path-in-place video card (replaces `videos/1.mp4` / links)\r\n *\r\n * Stage always has a non-zero reserved size (default 16:9 via JS aspect-ratio).\r\n * Video is absolute-fill so metadata load / stream remounts do not thrash\r\n * scrollHeight (that thrash + stick-to-bottom follow = chat flicker).\r\n */\r\n.md-body__video-card {\r\n  display: block;\r\n  box-sizing: border-box;\r\n  max-width: min(100%, 360px);\r\n  margin: 10px 0;\r\n  border-radius: var(--radius-window);\r\n  border: 1px solid var(--border-subtle);\r\n  background: var(--bg-elevated);\r\n  overflow: hidden;\r\n  box-shadow: 0 1px 0 color-mix(in srgb, var(--ink-black) 0.04%, transparent);\r\n}\r\n\r\n.md-body__video-card__stage {\r\n  position: relative;\r\n  display: block;\r\n  width: 100%;\r\n  /* Height from aspect-ratio (inline); never leave an empty collapsing box */\r\n  height: auto;\r\n  background: var(--ink-black);\r\n  overflow: hidden;\r\n}\r\n\r\n.md-body__video-card__el {\r\n  display: block;\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n  object-position: center;\r\n  background: var(--ink-black);\r\n  border: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.md-body__video-card__placeholder,\r\n.md-body__video-card__error {\r\n  position: absolute;\r\n  inset: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  padding: 12px;\r\n  box-sizing: border-box;\r\n  color: var(--text-secondary);\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  background: color-mix(in srgb, var(--bg-hover) 80%, var(--ink-black) 20%);\r\n}\r\n\r\n.md-body__video-card__name {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  max-width: 100%;\r\n}\r\n\r\n.md-body__video-card__caption {\r\n  padding: 6px 10px;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--text-secondary);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  border-top: 1px solid var(--border-subtle);\r\n  /* Fixed caption band so presence of title doesn't reflow after first paint */\r\n  min-height: 28px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.md-body__video-card__btn {\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Streamdown / markdown may wrap replaced code/link in p — keep block */\r\n.chat-md p:has(> .md-body__img-frame),\r\n.chat-md p:has(> .md-body__video-card),\r\n.chat-md p:has(> .file-path-link) {\r\n  margin-block: 0.35em;\r\n}\r\n\r\n/* File / URL path link — inline chat-theme link (name only; path in details / copy menu) */\r\n.file-path-link {\r\n  display: inline-block;\r\n  max-width: 100%;\r\n  vertical-align: baseline;\r\n}\r\n\r\n.file-path-link__main {\n  display: inline-flex;\n  /* Use the text baseline, not the leading SVG baseline, in prose. */\r\n  align-items: baseline;\r\n  max-width: 100%;\r\n  vertical-align: baseline;\n  text-align: start;\n  text-decoration: underline;\n  text-decoration-style: dotted;\n  text-underline-offset: 4px;\n}\n\r\n.file-path-link__icon {\r\n  align-self: center;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin: 0 4px 0 0;\r\n  color: var(--chat-link);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.file-path-link--dir .file-path-link__icon {\r\n  color: var(--dir-accent);\r\n}\r\n\r\n.file-path-link__meta {\r\n  display: block;\r\n  min-width: 0;\r\n}\r\n\r\n.file-path-link__name {\r\n  display: block;\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  font-weight: 550;\r\n  color: var(--chat-link);\r\n  overflow-wrap: anywhere;\r\n  white-space: normal;\r\n  line-height: 1.35;\r\n}\r\n\r\n.chat-md ul > li:has(.file-path-link) {\r\n  position: relative;\r\n  list-style: none;\r\n}\r\n\r\n.chat-md ul > li:has(.file-path-link)::before {\r\n  position: absolute;\r\n  /* 与通用列表标记同一几何（top 8px / -0.95em），保证横向、纵向都对齐。 */\r\n  top: 8px;\r\n  inset-inline-start: -0.95em;\r\n  font-size: inherit;\r\n  width: 5px;\r\n  height: 5px;\r\n  border-radius: 50%;\r\n  background: var(--chat-prose-text);\r\n  content: \"\";\r\n}\r\n\r\n/* 链接图标按字号取 1em 并块化：16px 基线对齐的 svg 会撑高行盒，\r\n * 使文字基线下移、列表圆点错位。 */\r\n.file-path-link__icon svg {\r\n  display: block;\r\n  width: 1em;\r\n  height: 1em;\r\n}\r\n\r\n.file-path-link--url .file-path-link__icon {\r\n  color: var(--chat-link);\r\n}\r\n\r\n/* Path never shown on link */\r\n\r\n/* Details dialog for file / URL cards */\r\n.file-path-details-overlay {\r\n  z-index: 13000;\r\n}\r\n\r\n.file-path-details {\r\n  width: min(440px, calc(100vw - 32px));\r\n  max-height: min(80vh, 520px);\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.file-path-details__head {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.file-path-details__body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  padding: 4px 0 8px;\r\n  overflow-y: auto;\r\n  min-height: 0;\r\n}\r\n\r\n.file-path-details__row {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  min-width: 0;\r\n}\r\n\r\n.file-path-details__label {\r\n  font-size: calc(11px + var(--ui-font-delta));\r\n  font-weight: 550;\r\n  color: var(--text-tertiary);\r\n  text-transform: none;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.file-path-details__value {\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  color: var(--text-primary);\r\n  word-break: break-all;\r\n  white-space: pre-wrap;\r\n  line-height: 1.4;\r\n  user-select: text;\r\n  -webkit-user-select: text;\r\n}\r\n\r\n.file-path-details__mono {\r\n  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  padding: 8px 10px;\r\n  border-radius: var(--radius-md);\r\n  background: var(--bg-hover);\r\n  border: 1px solid var(--border-subtle);\r\n}\r\n\r\n.file-path-details__actions {\r\n  flex-shrink: 0;\r\n  margin-top: 4px;\r\n}\r\n\r\n.composer__input {\n  width: 100%;\n  /* 与 ZCode LexicalChatInput 对齐：输入区最小 40px、滚动上限 160px，\n     contenteditable 增长及 IME 提交后仍保持稳定。 */\n  min-height: 40px;\n  max-height: 160px;\n  resize: none;\r\n  border: none !important;\r\n  outline: none !important;\r\n  box-shadow: none !important;\r\n  background: transparent;\r\n  color: var(--text-primary);\r\n  font: inherit;\r\n  font-size: calc(14px + var(--ui-font-delta));\r\n  line-height: calc(20px + var(--ui-font-delta));\n  overflow-y: auto;\r\n  /* room for floating native thumb (track stays transparent) */\r\n  padding: 0;\n  field-sizing: content;\r\n  caret-color: var(--accent);\r\n  margin: 0;\n}\r\n\r\n/* If any rich HTML still lands, strip visual styles (skill chips keep own classes). */\r\n.composer__input b,\r\n.composer__input strong,\r\n.composer__input i,\r\n.composer__input em,\r\n.composer__input u,\r\n.composer__input s,\r\n.composer__input span:not([data-skill]):not(.skill-chip):not(.skill-chip__name):not(.skill-chip__glyph):not(.composer-mention),\n.composer__input font,\r\n.composer__input a {\r\n  font: inherit !important;\r\n  font-weight: inherit !important;\r\n  font-style: inherit !important;\r\n  color: inherit !important;\r\n  background: transparent !important;\r\n  text-decoration: none !important;\r\n  letter-spacing: inherit !important;\r\n  border: none !important;\r\n}\r\n\r\n.composer__input::placeholder {\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.composer__row {\n  display: flex;\n  align-items: flex-end;\n  gap: 12px;\n  flex-wrap: nowrap;\n  min-height: 32px;\n  /* Do not use overflow-x:auto here — it clips absolute/portaled popovers\r\n     and was hiding the model menu (only a bottom shadow was visible). */\r\n  overflow: visible;\n  padding: 0;\n}\n\n.composer__leading-actions,\n.composer__trailing-actions {\n  display: flex;\n  min-width: 0;\n  align-items: center;\n  gap: 4px;\n}\n\n/* ZCode ChatPromptEditor keeps leading actions flexible and pins the\n   model/thought/usage/send cluster to the trailing edge. */\n.composer__leading-actions {\n  flex: 1 1 auto;\n  overflow: hidden;\n}\n\n.composer__trailing-actions {\n  flex: 0 1 auto;\n  justify-content: flex-end;\n  overflow: visible;\n}\n\n.composer__leading-actions > * {\n  flex-shrink: 0;\n}\n\n.composer__trailing-actions > .cmm--model {\n  flex: 0 1 auto;\n}\n\n.composer__trailing-actions > .cmm--reasoning,\n.composer__trailing-actions > .ctx-chip,\n.composer__trailing-actions > .composer__submit {\n  flex-shrink: 0;\n}\n\r\n.composer-plus-trigger,\n.composer__submit {\n  border-radius: var(--radius-lg);\n}\n\r\n/* Flat chips (project etc.) — no capsule border, hover wash only */\r\n.chip {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  height: 28px;\r\n  padding: 0 8px;\r\n  border-radius: var(--radius-md);\r\n  background: transparent;\r\n  border: none;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--text-secondary);\r\n  max-width: 140px;\r\n  flex-shrink: 0;\r\n  transition: background var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out);\r\n}\r\n\r\n.chip__label {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.chip:hover:not(:disabled) {\r\n  background: var(--bg-hover);\r\n  color: var(--text-primary);\r\n}\r\n\r\n/* Context usage chip (composer row) */\r\n.chip--context {\r\n  font-variant-numeric: tabular-nums;\r\n  width: 24px;\r\n  padding: 0 4px;\r\n  cursor: default;\r\n}\r\n\r\n.context-ring {\r\n  display: block;\r\n  overflow: visible;\r\n  transform: rotate(-90deg);\r\n}\r\n\r\n.context-ring__track,\r\n.context-ring__value {\r\n  fill: none;\r\n  stroke-width: 2.25;\r\n}\r\n\r\n.context-ring__track {\r\n  stroke: color-mix(in srgb, var(--text-secondary) 22%, transparent);\r\n}\r\n\r\n.context-ring__value {\r\n  stroke: var(--accent, var(--text-primary));\r\n  stroke-linecap: round;\r\n  transition: stroke-dashoffset var(--motion-enter) var(--ease-out);\r\n}\r\n\r\n.chip--muted .context-ring__value {\r\n  stroke: var(--text-tertiary);\r\n}\r\n\r\n.ctx-chip {\r\n  display: inline-flex;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.context-usage-tip {\r\n  min-width: 208px;\r\n  padding: 8px 10px;\r\n  overflow: visible;\r\n  white-space: normal;\r\n}\r\n\r\n.context-usage-board {\r\n  display: grid;\r\n  gap: 6px;\r\n}\r\n\r\n.context-usage-board__row {\r\n  display: grid;\r\n  grid-template-columns: minmax(0, 1fr) auto;\r\n  align-items: baseline;\r\n  gap: 14px;\r\n}\r\n\r\n.context-usage-board__label {\r\n  color: color-mix(in srgb, currentColor 72%, transparent);\r\n}\r\n\r\n.context-usage-board__value {\r\n  color: inherit;\r\n  font-weight: 600;\r\n  font-variant-numeric: tabular-nums;\r\n  white-space: nowrap;\r\n}\r\n\r\n\r\n.composer__spacer {\r\n  flex: 1;\r\n  min-width: 8px;\r\n}\r\n\r\n.composer-plus-trigger.is-open {\n  transform: none;\n}\n\r\n/* Harness ui-input-trigger/MenuView：与输入卡片同宽，行高至少 40px，上限 320px。 */\r\n.composer-plus {\r\n  z-index: 10000;\r\n  /* Beat .menu-panel width:max-content / max-width:360 without clobbering inline width */\r\n  max-width: calc(100vw - 16px) !important;\r\n  min-width: 0;\r\n  max-height: min(320px, calc(100vh - 24px));\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0;\r\n  padding: 4px;\r\n  border: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.composer-plus--portal {\n  position: fixed;\n}\n\n/* @ mention 候选与输入框等宽，但候选很多时只在面板内部滚动。 */\n.composer-mention-panel {\n  max-height: min(320px, calc(100vh - 24px));\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  box-sizing: border-box;\n}\n\n.composer-plus__section {\n  min-height: 26px;\r\n  padding: 6px 10px 2px;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  font-weight: 500;\r\n  line-height: calc(18px + var(--ui-font-delta));\r\n  color: var(--text-tertiary);\r\n  letter-spacing: 0;\r\n  text-transform: none;\r\n  user-select: none;\r\n}\r\n\r\n.composer-plus__section:not(:first-child) {\r\n  margin-top: 4px;\r\n}\r\n\r\n.composer-plus__item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  width: 100%;\r\n  min-height: 40px;\r\n  text-align: left;\r\n  box-sizing: border-box;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n}\r\n\r\n.composer-plus__item:hover:not(:disabled):not(.composer-plus__item--muted)\r\n  .composer-plus__ico,\r\n.composer-plus__item.is-active:not(:disabled):not(.composer-plus__item--muted)\r\n  .composer-plus__ico {\r\n  color: var(--text-primary);\r\n}\r\n\r\n.composer-plus__item--muted {\r\n  pointer-events: none;\r\n}\r\n\r\n.composer-plus__ico {\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 16px;\r\n  height: 16px;\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n/*\r\n * Name first: title does not shrink for description.\r\n * 标题最多占 40%，与参考菜单保留描述空间的规则一致。\r\n */\r\n.composer-plus__title {\r\n  flex: 0 0 auto;\r\n  max-width: 40%;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-weight: 400;\r\n  color: var(--text-primary);\r\n}\r\n\r\n.composer-plus__desc {\r\n  flex: 1 1 0;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-size: inherit;\r\n  font-weight: 400;\r\n  font-style: normal;\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n/* 欢迎标记与问候语在正常流中排列，长本地化文案不会与输入框重叠。 */\n.composer-welcome {\n  display: flex;\n  width: 100%;\n  max-width: 672px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  margin: 0;\n  color: var(--text-primary);\n  text-align: center;\n  pointer-events: auto;\n}\n.composer-welcome__logo {\n  display: block;\n  width: 48px;\n  height: 48px;\n  object-fit: contain;\n}\n.composer-welcome h1 {\n  max-width: 100%;\n  margin: 0;\n  padding: 0 16px;\n  font-size: calc(28px + var(--ui-font-delta));\n  line-height: 1.2;\n  font-weight: 500;\n  overflow-wrap: anywhere;\n}\n@container conversation-stage (max-width: 760px) {\n  .composer-wrap--welcome { gap: 16px; padding: 16px; }\n  .composer-welcome { gap: 10px; }\n  .composer-welcome__logo { width: 40px; height: 40px; }\n  .composer-welcome h1 { font-size: calc(22px + var(--ui-font-delta)); }\n}\n\n@media (max-height: 600px) {\n  .composer-wrap--welcome { gap: 16px; }\n  .composer-welcome { gap: 10px; }\n  .composer-welcome__logo { width: 40px; height: 40px; }\n  .composer-welcome h1 { font-size: calc(22px + var(--ui-font-delta)); }\n}\n\r\n/* 渲染异常兜底卡片：单个面板崩溃时就地提示重试/重载，阻止整窗白屏。 */\r\n.error-boundary-fallback {\n  margin: 12px;\n  padding: 20px 24px;\n  border: 1px solid var(--danger);\n  border-radius: var(--radius-lg);\n  color: var(--text-primary);\n  background: color-mix(in srgb, var(--danger) 14%, var(--bg-main));\n}\n.error-boundary-fallback__title,\n.error-boundary-fallback__description {\n  display: block;\n  margin: 0;\n}\n.error-boundary-fallback__description {\n  margin-top: 8px;\n  color: var(--text-secondary);\n}\n\n.attach-chip--uploading {\n  border-color: color-mix(in srgb, var(--accent) 42%, var(--border-subtle));\n  background: color-mix(in srgb, var(--accent-muted) 48%, var(--bg-hover));\n}\n\n.attach-chip--failed {\n  border-color: color-mix(in srgb, var(--danger) 58%, var(--border-subtle));\n  background: color-mix(in srgb, var(--danger-muted) 48%, var(--bg-hover));\n}\n\n.attach-chip__status {\n  position: absolute;\n  right: 6px;\n  bottom: 3px;\n  left: 6px;\n  overflow: hidden;\n  color: var(--text-tertiary);\n  font-size: var(--text-xs);\n  line-height: 1;\n  text-align: right;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  pointer-events: none;\n}\n\n.attach-chip--failed .attach-chip__status {\n  color: var(--danger);\n}\n\n.attach-chip--image .attach-chip__status {\n  right: 2px;\n  bottom: 2px;\n  left: 2px;\n  padding: 2px;\n  border-radius: var(--radius-xs);\n  background: color-mix(in srgb, var(--bg-app) 82%, transparent);\n  text-align: center;\n}\n\n.attach-chip__retry {\n  position: absolute;\n  top: 2px;\n  right: 22px;\n  z-index: 2;\n}\n.error-boundary-fallback__actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 16px;\n}\r\n/* ==========================================================================\r\n * Modals / overlays — GlassModal shell template\r\n * Structure: .overlay > .modal[.status-modal|glass-modal--*]\r\n *            .modal-head → title + close\r\n *            .modal-body (optional) / content\r\n *            .modal-actions → footer CTAs\r\n * 表面来自 Harness Modal；沿用 GlassModal 的组合接口和 --modal-* 布局令牌。\r\n * ========================================================================== */\r\n.overlay {\r\n  position: fixed;\r\n  inset: 0;\r\n  background: var(--bg-overlay);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 12000;\r\n  padding: 24px;\r\n  box-sizing: border-box;\r\n  backdrop-filter: blur(2px);\r\n}\r\n\r\n.modal {\r\n  width: min(var(--modal-width-md, 480px), 100%);\r\n  max-height: min(90vh, 720px);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--modal-gap, 16px);\r\n  overflow: hidden;\r\n  border-radius: var(--modal-radius);\r\n  padding: var(--modal-pad-y, 20px) var(--modal-pad-x, 24px);\r\n  box-sizing: border-box;\r\n  color: var(--text-primary);\r\n  background: var(--dsw-alias-bg-layer-2);\r\n  box-shadow: var(--dsw-elevation-prominent);\r\n}\r\n\r\n.modal.glass-modal--sm,\r\n.modal.app-dialog {\r\n  width: min(var(--modal-width-sm, 420px), 100%);\r\n}\r\n\r\n.modal.glass-modal--lg {\r\n  width: min(var(--modal-width-lg, 560px), 100%);\r\n}\r\n\r\n.modal h2 {\r\n  margin: 0;\r\n  font-size: var(--modal-title-size, 16px);\r\n  font-weight: 500;\r\n  color: var(--text-primary);\r\n  line-height: 24px;\r\n}\r\n\r\n.modal p {\r\n  margin: 0;\r\n  color: var(--text-secondary);\r\n  font-size: var(--text-sm);\r\n  line-height: 1.5;\r\n}\r\n\r\n.modal-body {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--modal-body-gap, 12px);\r\n  min-height: 0;\r\n  flex: 1;\r\n  overflow: auto;\r\n}\r\n\r\n/* Shared head: title + close */\r\n.modal-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: var(--space-3);\r\n  flex-shrink: 0;\r\n  min-width: 0;\r\n}\r\n\r\n.modal-title {\r\n  margin: 0;\r\n  font-size: var(--modal-title-size, 16px);\r\n  font-weight: 500;\r\n  color: var(--text-primary);\r\n  min-width: 0;\r\n  line-height: 24px;\r\n}\r\n\r\n.modal-close {\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Shared footer actions — right-aligned cancel + primary (ref dialog) */\r\n.modal-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: var(--modal-actions-gap, 8px);\r\n  flex-shrink: 0;\r\n  margin-top: auto;\r\n  padding-top: var(--space-3, 12px);\r\n  border-top: none;\r\n}\r\n\r\n/* Add project: existing modal/input/button variants own visual styling. */\r\n.modal.add-project-modal {\r\n  width: min(760px, 100%);\r\n}\r\n\r\n.add-project-form {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--space-4);\r\n}\r\n\r\n.add-project-field {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--space-2);\r\n  min-width: 0;\r\n}\r\n\r\n.add-project-name-control {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.add-project-name-control > .g-icon {\r\n  position: absolute;\r\n  left: var(--space-3);\r\n  z-index: 1;\r\n  pointer-events: none;\r\n}\r\n\r\n.add-project-name-control .settings-input {\r\n  height: 42px;\r\n  padding-left: 40px;\r\n}\r\n\r\n.add-project-name-control .settings-input:focus-visible {\r\n  border-color: var(--border-focus);\r\n}\r\n\r\n.add-project-drop:focus-visible {\r\n  outline: 2px solid var(--border-focus);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.cpm__action.add-project-drop {\r\n  flex: 0 0 auto;\r\n  width: 100%;\r\n  min-height: 148px;\r\n  flex-direction: column;\r\n  gap: var(--space-2);\r\n  padding: var(--space-5);\r\n  white-space: normal;\r\n}\r\n\r\n.add-project-drop__title,\r\n.add-project-drop__path {\r\n  display: block;\r\n  max-width: 100%;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.add-project-default-path {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: var(--space-2);\r\n  margin: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.add-project-default-path__settings {\r\n  flex-shrink: 0;\r\n}\r\n\r\n@media (max-height: 420px) {\r\n  .add-project-overlay {\r\n    padding: 6px 16px;\r\n  }\r\n\r\n  .modal.add-project-modal {\r\n    max-height: calc(100vh - 12px);\r\n    --modal-pad-x: 16px;\r\n    --modal-pad-y: 12px;\r\n    --modal-gap: 12px;\r\n  }\r\n\r\n  .add-project-form {\r\n    gap: var(--space-3);\r\n  }\r\n\r\n  .cpm__action.add-project-drop {\r\n    min-height: 96px;\r\n    padding: var(--space-3);\r\n  }\r\n\r\n  .add-project-modal .modal-actions {\r\n    padding-top: var(--space-2);\r\n  }\r\n}\r\n\r\n/* Body status lines (loading / error / empty) */\r\n\r\n/* Shortcuts help panel */\r\n.shortcuts-list {\r\n  list-style: none;
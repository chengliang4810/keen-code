.analytics-model-breakdown {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n.analytics-model-breakdown > div {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-width: 0;\r\n}\r\n\r\n.analytics-model-breakdown i {\r\n  width: 8px;\r\n  height: 8px;\r\n  flex-shrink: 0;\r\n  border-radius: var(--radius-2xs);\r\n}\r\n\r\n.analytics-model-breakdown span {\r\n  flex: 1;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1px;\r\n}\r\n\r\n.analytics-model-breakdown strong {\r\n  font-size: var(--text-xs);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.analytics-model-breakdown small {\r\n  color: var(--text-tertiary);\r\n  font-size: calc(11px + var(--ui-font-delta));\r\n}\r\n\r\n.analytics-model-breakdown b {\r\n  font-size: var(--text-xs);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n/* ── Request history panel (settings) ─────────────────────────────────── */\r\n\r\n.request-history {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  min-width: 0;\r\n}\r\n\r\n.request-history__filters-heading {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.request-history__filters-heading h2 {\r\n  margin: 0;\r\n  font-size: var(--text-sm);\r\n  font-weight: 600;\r\n}\r\n\r\n.request-history__filter-actions {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n\r\n.request-history__clear {\r\n  min-height: 30px;\r\n}\r\n\r\n.request-history__filters {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  gap: 10px;\r\n}\r\n\r\n.request-history__filters label {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 5px;\r\n  min-width: 0;\r\n  color: var(--text-tertiary);\r\n  font-size: var(--text-xs);\r\n}\r\n\r\n.request-history__filters [data-slot=\"select-trigger\"],\r\n.request-history__filters input {\r\n  width: 100%;\r\n  min-width: 0;\r\n}\r\n\r\n.request-history__table-wrap {\r\n  overflow-x: auto;\r\n}\r\n\r\n.request-history__model {\r\n  max-width: 180px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.request-history__details-modal-body {\r\n  min-height: 0;\r\n}\r\n\r\n.request-history__details-modal dl {\r\n  display: grid;\r\n  grid-template-columns: minmax(128px, max-content) minmax(0, 1fr);\r\n  gap: 8px 16px;\r\n  min-width: 0;\r\n  margin: 0;\r\n  font-size: var(--text-xs);\r\n}\r\n\r\n.request-history__details-modal dt {\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.request-history__details-modal dd {\r\n  min-width: 0;\r\n  margin: 0;\r\n  overflow-wrap: anywhere;\r\n  color: var(--text-secondary);\r\n  user-select: text;\r\n}\r\n\r\n.request-history__detail-error {\r\n  color: var(--danger) !important;\r\n}\r\n\r\n.request-history__pagination {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  color: var(--text-tertiary);\r\n  font-size: var(--text-xs);\r\n}\r\n\r\n@media (max-width: 720px) {\r\n  .request-history__filters {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (max-width: 460px) {\r\n  .request-history__filters {\r\n    grid-template-columns: minmax(0, 1fr);\r\n  }\r\n\r\n  .request-history__pagination {\r\n    align-items: stretch;\r\n    flex-direction: column;\r\n  }\r\n\r\n  .request-history__pagination > [data-slot=\"pagination\"] {\r\n    justify-content: flex-end;\r\n  }\r\n\r\n  .request-history__details-modal dl {\r\n    grid-template-columns: minmax(0, 1fr);\r\n    gap: 3px;\r\n  }\r\n\r\n  .request-history__details-modal dd:not(:last-child) {\r\n    margin-bottom: 9px;\r\n  }\r\n}\r\n\r\n/* ── Personalization settings (custom instructions) ───────────────────── */\r\n\r\n.settings-personalization {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 12px;\r\n  max-width: 640px;\r\n}\r\n\r\n.settings-personalization__header {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.settings-personalization__heading {\r\n  min-width: 0;\r\n}\r\n\r\n.settings-personalization__title {\r\n  margin: 0 0 4px;\r\n  font-size: var(--text-md);\r\n  font-weight: 600;\r\n}\r\n\r\n.settings-personalization__description {\r\n  margin: 0;\r\n  color: var(--text-secondary);\r\n  font-size: var(--text-sm);\r\n  line-height: var(--leading-normal);\r\n}\r\n\r\n.settings-personalization__learn-more {\r\n  align-self: flex-start;\r\n}\r\n\r\n.settings-personalization__help {\r\n  margin: 0;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border-subtle);\r\n  border-left: 2px solid var(--accent);\r\n  border-radius: var(--radius-md);\r\n  background: var(--bg-card);\r\n  color: var(--text-secondary);\r\n  font-size: var(--text-sm);\r\n  line-height: var(--leading-normal);\r\n}\r\n\r\n.settings-personalization__textarea {\r\n  width: 100%;\r\n  min-height: 160px;\r\n  padding: 10px 12px;\r\n  border: 1px solid var(--border-subtle);\r\n  border-radius: var(--radius-md);\r\n  background: var(--bg-input);\r\n  color: var(--text-primary);\r\n  font-size: var(--text-sm);\r\n  line-height: var(--leading-normal);\r\n  resize: vertical;\r\n}\r\n\r\n.settings-personalization__textarea:focus {\r\n  outline: none;\r\n  border-color: var(--border-focus);\r\n}\r\n\r\n.settings-personalization-stack {\r\n  display: grid;\r\n  gap: 24px;\r\n}\r\n\r\n.settings-personalization__memory-card {\n  margin-top: 16px;\n}\n/*\n * KeenCode UI 治理层。\n * 这里只放低风险的跨页面不变量；产品表面、控件变体和宿主专属壳层\n * 仍由各自的归属文件维护。\n */\n:root {\n  --ui-focus-ring: 0 0 0 2px var(--bg-main), 0 0 0 4px var(--border-focus);\n  --ui-touch-target: 32px;\n  --ui-touch-target-touch: 44px;\n  --ui-touch-target-touch-plus-12: 56px;\n  --ui-mobile-inline-padding: 12px;\n}\n\n/* Appica 的 md utility 使用 rem；产品正文根字号为 14px 时会把 h-7 折成\n * 24.5px。共享 wrapper 使用这些末端几何类锁定 ZCode 的实际屏幕尺寸，\n * 不改变根字号，也不绕过 Appica 的 md 状态语义。 */\n.keencode-control-md {\n  height: var(--control-height-compact);\n  min-height: var(--control-height-compact);\n  border-radius: var(--control-radius-compact);\n}\n\n.keencode-tabs-list-md {\n  height: var(--control-height-tabs);\n}\n\n/* 桌面侧栏在窄视口变成覆盖抽屉，避免固定 264px 参与主区 flex 计算。 */\n.sidebar-mobile-backdrop {\n  display: none;\n}\n\n/*\n * Appica styles load before this file and define the same unprefixed role\n * variables. This file is the sole KeenCode authority for those roles: the\n * bridge is kept after the Appica import so package defaults cannot win by\n * cascade. Product-only skin variables (`--accent`, `--border-focus`) remain\n * owned by tokens.css/skins.css and are intentionally not redeclared here.\n */\n[data-theme=\"light\"] {\n  --foreground: #282828;\n  --foreground-subtle: color-mix(in oklab, #282828 60%, transparent);\n  --foreground-subtlest: color-mix(in oklab, #282828 40%, transparent);\n  --foreground-muted: color-mix(in oklab, #282828 60%, transparent);\n  --foreground-strong: #282828;\n  --foreground-emphasis: #0d0d0d;\n  --foreground-intense: #0d0d0d;\n  --foreground-inverse: #ffffff;\n  --background: #f8f8f8;\n  --background-subtle: rgba(13, 13, 13, 0.03);\n  --background-muted: rgba(13, 13, 13, 0.05);\n  --background-strong: #ececee;\n  --background-inverse: #0d0d0d;\n  --border: rgba(13, 13, 13, 0.1);\n  --border-muted: rgba(13, 13, 13, 0.1);\n  --border-strong: rgba(13, 13, 13, 0.15);\n  --border-emphasis: rgba(13, 13, 13, 0.2);\n  --border-intense: rgba(13, 13, 13, 0.3);\n  --border-inverse: #ffffff;\n  --border-overlay: rgba(13, 13, 13, 0.1);\n  --border-subtle: var(--border);\n  --primary: #000000;\n  --primary-subtle: rgba(13, 13, 13, 0.05);\n  --primary-soft: #e6e6e6;\n  --primary-muted: #282828;\n  --primary-strong: #000000;\n  --primary-foreground: #ffffff;\n  --secondary: #e6e6e6;\n  --secondary-subtle: rgba(13, 13, 13, 0.05);\n  --secondary-soft: rgba(13, 13, 13, 0.1);\n  --secondary-muted: #8f8f8f;\n  --secondary-strong: #5d5d5d;\n  --secondary-emphasis: #282828;\n  --secondary-intense: #0d0d0d;\n  --secondary-foreground: #282828;\n  --error: #e03131;\n  --error-subtle: rgba(224, 49, 49, 0.1);\n  --error-soft: rgba(224, 49, 49, 0.2);\n  --error-muted: #e03131;\n  --error-strong: #e03131;\n  --error-emphasis: #e03131;\n  --error-intense: #b42323;\n  --error-foreground: #ffffff;\n  --success: #1e8a3e;\n  --success-subtle: rgba(30, 138, 62, 0.1);\n  --success-soft: rgba(30, 138, 62, 0.2);\n  --success-muted: #1e8a3e;\n  --success-strong: #1e8a3e;\n  --success-emphasis: #1e8a3e;\n  --success-intense: #166b32;\n  --success-foreground: #ffffff;\n  --warning: #e07b00;\n  --warning-subtle: rgba(224, 123, 0, 0.1);\n  --warning-soft: rgba(224, 123, 0, 0.2);\n  --warning-muted: #e07b00;\n  --warning-strong: #e07b00;\n  --warning-emphasis: #e07b00;\n  --warning-intense: #a85c00;\n  --warning-foreground: #ffffff;\n  --info: #0b7fff;\n  --info-subtle: rgba(11, 127, 255, 0.1);\n  --info-soft: rgba(11, 127, 255, 0.2);\n  --info-muted: #0b7fff;\n  --info-strong: #0066dd;\n  --info-emphasis: #0066dd;\n  --info-intense: #0052b3;\n  --info-foreground: #ffffff;\n  --focus-ring: rgba(11, 127, 255, 0.28);\n  --focus-ring-input: rgba(11, 127, 255, 0.28);\n  --focus-ring-primary: rgba(11, 127, 255, 0.28);\n  --focus-ring-secondary: rgba(11, 127, 255, 0.2);\n  --focus-ring-error: rgba(224, 49, 49, 0.25);\n  --focus-ring-success: rgba(30, 138, 62, 0.25);\n  --focus-ring-warning: rgba(224, 123, 0, 0.25);\n  --focus-ring-info: rgba(11, 127, 255, 0.25);\n  --focus-ring-light: rgba(255, 255, 255, 0.25);\n  --selection-color: rgba(13, 13, 13, 0.1);\n  --tooltip: #f0f0f0;\n  --tooltip-foreground: #0d0d0d;\n}\n\n:root:not([data-theme=\"light\"]),\n[data-theme=\"dark\"] {\n  --foreground: #d4d4d4;\n  --foreground-subtle: color-mix(in oklab, #d4d4d4 60%, transparent);\n  --foreground-subtlest: color-mix(in oklab, #d4d4d4 30%, transparent);\n  --foreground-muted: color-mix
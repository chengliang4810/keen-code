fo-subtle: rgba(64, 153, 255, 0.1);\n  --info-soft: rgba(64, 153, 255, 0.2);\n  --info-muted: #4099ff;\n  --info-strong: #80beff;\n  --info-emphasis: #80beff;\n  --info-intense: #a8d0ff;\n  --info-foreground: #000000;\n  --focus-ring: rgba(64, 153, 255, 0.32);\n  --focus-ring-input: rgba(64, 153, 255, 0.32);\n  --focus-ring-primary: rgba(64, 153, 255, 0.32);\n  --focus-ring-secondary: rgba(64, 153, 255, 0.24);\n  --focus-ring-error: rgba(255, 92, 92, 0.35);\n  --focus-ring-success: rgba(70, 191, 114, 0.35);\n  --focus-ring-warning: rgba(255, 138, 48, 0.35);\n  --focus-ring-info: rgba(64, 153, 255, 0.35);\n  --focus-ring-light: rgba(255, 255, 255, 0.25);\n  --selection-color: rgba(255, 255, 255, 0.1);\n  --tooltip: #2b2b2b;\n  --tooltip-foreground: #f8f8f8;\n}\n\n/* UI 控件继承产品字体，并统一字距；不在这里覆盖控件尺寸。 */\n:where(\n    button,\n    input,\n    select,\n    textarea,\n    [role=\"button\"],\n    [role=\"tab\"],\n    [role=\"menuitem\"],\n    [role=\"option\"]\n  ) {\n  font-family: inherit;\n  letter-spacing: 0;\n}\n\n/* Appica's motion switch stays on the md preset for state/keyboard behavior;\n * apply ZCode's 28/32px tracks without letting the animated thumb overflow\n * the compact track. */\n.keencode-switch[data-size=\"md\"] {\n  height: 18px;\n  width: 32px;\n}\n\n.keencode-switch[data-size=\"md\"] [data-slot=\"switch-thumb\"] {\n  width: 16px !important;\n  height: 16px !important;\n  background: var(--primary-foreground);\n}\n\n.keencode-switch [data-slot=\"switch-thumb\"] > svg {\n  display: none;\n}\n\n/*\n * Appica 基础层会给全局文本加选中底色，并通过 `focus-visible:outline-3`\n * 给所有元素加焦点轮廓。普通文本回退到浏览器/产品默认选中表现，终端\n * 选中仍由 xterm 运行时主题独立维护；焦点 ring 只由具体组件自己的\n * focus-visible utility 提供。\n */\n::selection {\n  background-color: revert;\n  color: revert;\n}\n\n:where(*):focus-visible {\n  outline: none;\n}\n\n/* Flex 子项先允许收缩，再对长文本做截断或换行。 */\n:where(\n    .workbench,\n    .main,\n    .main__stage,\n    .sidebar,\n    .aside,\n    .aside__inner,\n    .settings-page,\n    .settings-page
ent) 12%, transparent);\r\n  border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.composer__queue-hold-text {\r\n  flex: 1;\r\n  min-width: 0;\r\n  line-height: 1.35;\r\n}\r\n\r\n.composer__queue-hold-retry {\r\n  flex: 0 0 auto;\r\n}\r\n\r\n.composer__queue-list {\r\n  list-style: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  max-height: 120px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.composer__queue-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-height: 28px;\r\n  padding: 4px 6px;\r\n  border-radius: var(--radius-md);\r\n  background: var(--bg-hover);\r\n  border: 1px solid var(--border-subtle);\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.composer__queue-idx {\r\n  flex: 0 0 auto;\r\n  width: 1.1rem;\r\n  text-align: center;\r\n  opacity: 0.55;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.composer__queue-text {\r\n  flex: 1;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  color: var(--text-primary);\r\n}\r\n\r\n.composer__queue-steer,\n.composer__queue-send-now,\n.composer__queue-drag,\n.composer__queue-remove,\n.composer__queue-more {\n  flex: 0 0 auto;\n}\n\n.composer__queue-drag {\n  cursor: grab;\n  color: var(--text-tertiary);\n}\n\n.composer__queue-drag:active {\n  cursor: grabbing;\n}\n\n.composer__queue-steer {\n  width: auto;\n}\n\n.composer__queue-send-now {\n  width: auto;\n}\n\n.composer__queue-item--dragging {\n  opacity: 0.65;\n}\n\n.composer__queue-item--drop-target {\n  border-color: var(--border-focus);\n  background: var(--bg-input);\n}\n\r\n.composer__queue-editor {\r\n  display: flex;\r\n  flex: 1;\r\n  min-width: 0;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.composer__queue-editor textarea {\r\n  min-height: 64px
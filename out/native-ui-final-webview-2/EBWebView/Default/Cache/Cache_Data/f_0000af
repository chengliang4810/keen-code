: none;\r\n  appearance: none;\r\n  width: 100%;\r\n  height: 6px;\r\n  border-radius: var(--radius-full);\r\n  background: color-mix(in srgb, var(--border-strong) 55%, var(--bg-hover));\r\n  outline: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.wallpaper-focus-zoom__range::-webkit-slider-thumb {\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  width: 16px;\r\n  height: 16px;\r\n  border-radius: 50%;\r\n  background: var(--accent);\r\n  border: 2px solid var(--bg-elevated);\r\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);\r\n  cursor: pointer;\r\n}\r\n\r\n.wallpaper-focus-zoom__range::-moz-range-thumb {\r\n  width: 16px;\r\n  height: 16px;\r\n  border-radius: 50%;\r\n  background: var(--accent);\r\n  border: 2px solid var(--bg-elevated);\r\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);\r\n  cursor: pointer;\r\n}\r\n\r\n.wallpaper-focus-zoom__range:focus-visible {\r\n  outline: 2px solid var(--border-focus);\r\n  outline-offset: 3px;\r\n}\r\n\r\n/* Footer actions share one row with reset on the left */\r\n.wallpaper-focus-modal .modal-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.settings-wallpaper__error {\r\n  margin: 0;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--danger);\r\n  line-height: 1.35;\r\n}\r\n\r\n/* Wallpaper scrim strength — affects only the shell ::after overlay. */\r\n.settings-wallpaper__scrim {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  padding-top: 2px;\r\n}\r\n\r\n.settings-wallpaper__scrim-head {\r\n  display: flex;\r\n  align-items: baseline;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n}\r\n\r\n.settings-wallpaper__scrim-label {\r\n  font-size: calc(12.5px + var(--ui-font-delta));\r\n  font-weight: 560;\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.settings-wallpaper__scrim-value {\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.settings-wallpaper__scrim-range {\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  width: 100%;\r\n  height: 6px;\r\n  border-radius: var(--radius-full);\r\n  background: color-mix(in srgb, var(--border-strong) 55%, var(--bg-hover));\r\n  outline: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.settings-wallpaper__scrim-range::-webkit-slider-thumb {\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  width: 16px;\r\n  height: 16px;\r\n  border-radius: 50%;\r\n  background: var(--accent);\r\n  border: 2px solid var(--bg-elevated);\r\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);\r\n  cursor: pointer;\r\n}\r\n\r\n.settings-wallpaper__scrim-range::-moz-range-thumb {\r\n  width: 16px;\r\n  height: 16px;\r\n  border-radius: 50%;\r\n  background: var(--accent);\r\n  border: 2px solid var(--bg-elevated);\r\n  box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);\r\n  cursor: pointer;\r\n}\r\n\r\n.settings-wallpaper__scrim-range:focus-visible {\r\n  outline: 2px solid var(--border-focus);\r\n  outline-offset: 3px;\r\n}\r\n\r\n.settings-wallpaper__scrim-hint {\r\n  margin: 0;\r\n  font-size: calc(11.5px + var(--ui-font-delta));\r\n  line-height: 1.35;\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n/* Harness 品牌栏及设置面板。只负责布局，控件沿用统一语义样式。 */\r\n.sidebar-brand {\n  display: inline-flex;\n  align-items: center;\n  flex: 0 0 28px;\n  width: 28px;\n  min-width: 28px;\n  justify-content: center;\n  padding-inline: 0;\n  color: var(--text-primary);\n  font-size: calc(18px + var(--ui-font-delta));\r\n  font-weight: 600;\r\n  white-space: nowrap;\r\n  line-height: calc(24px + var(--ui-font-delta));\r\n  /* 高度随字号增量同步，避免 20px 档位文字（24px/30px）溢出固定 24px 行盒。 */\r\n  height: calc(24px + var(--ui-font-delta));\n}\n\n.sidebar-brand__logo {\n  width: 20px;\n  height: 20px;\n  object-fit: contain;\n}\n\n@media (max-width: 760px) {\n  .sidebar-chrome__task-nav {\n    display: none;\n  }\n}\n.settings-stage {\r\n  display: flex;\r\n  width: 100%;\r\n  min-height: 0;\r\n  /* 设置作为独立页面填满窗口，异步加载时也不保留居中面板的留白。 */\r\n  flex: 1;\r\n}\r\n@media (max-width: 760px) {\r\n  .settings-page__main { padding: 16px 20px 48px; }\r\n}\r\n@media (max-height: 600px) {\r\n  .sidebar-chrome { height: 48px; min-height: 48px; max-height: 48px; }\r\n}\r\n\r\n.ui-toggle-appearance-group {\r\n  display: flex;\r\n  width: 100%;\r\n  flex-wrap: wrap;\r\n  align-items: stretch;\r\n  gap: 8px;\r\n}\r\n.ui-toggle-appearance {\r\n  display: flex;\r\n  flex: 1 1 180px;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n}\r\n/* ===== Main — solid content surface (not glass) ===== */\r\n.main {\n  flex: 1;\n  min-width: 0;\n  display: flex;\r\n  flex-direction: column;\r\n  background: var(--bg-main);\r\n  position: relative;\r\n  border-radius: 0;\r\n  z-index: 2;\r\n  --content-max-width: clamp(680px, calc(var(--conversation-column-width, 0px) * 0.64), 920px);\n}\n\n/* ZCode 桌面会话列始终保留独立 frame；窄视口由媒体查询恢复无框全宽布局。 */\n@media (min-width: 761px) {\n  .main.main--frame {\n    margin: 4px 4px 4px 0;\n    border: 1px solid var(--border-subtle);\n    overflow: hidden;\n  }\n\n  /* 沿用 ZCode window chrome 的平台圆角；conversation frame 不使用通用产品圆角。 */\n  .platform-win .main.main--frame,\n  .has-custom-chrome .main.main--frame {\n    border-radius: var(--radius-workspace-win);\n  }\n\n  .platform-mac .main.main--frame {\n    border-radius: var(--radius-workspace-mac);\n  }\n\n  .platform-other .main.main--frame {\n    border-radius: var(--radius-workspace-other);\n  }\n}\n\n/* Center title bar — same height as sidebar-chrome + rv__head so dividers align */\n.main__top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\r\n  height: var(--titlebar-height, 48px);\n  min-height: var(--titlebar-height, 48px);\n  max-height: var(--titlebar-height, 48px);\n  padding: 8px;\n  border-bottom: 1px solid var(--border-subtle);\n  gap: var(--space-2);\n  overflow: hidden;\n  flex-shrink: 0;\n  box-sizing: border-box;\n  /* 标题的收缩基于实际 header 宽度，右侧面板打开时仍保持可用空间。 */\n  container-type: inline-size;\n  container-name: main-header;\n}\n\n.platform-win .settings-page__chrome,\r\n.platform-other .settings-page__chrome,\r\n.has-custom-chrome .settings-page__chrome {\r\n  padding-right: 138px; /* 46px × 3 window controls */\r\n}\r\n\r\n/*\r\n * 仅让实际贴住窗口右缘的标题栏避让三个窗口按钮，并保留 4px 间距。\r\n * 文件面板显示时，主标题栏恢复自身 12px 右内边距，避免中间栏出现大块空白。\r\n */\r\n.platform-win .main--aside-hidden .main__top,\r\n.platform-other .main--aside-hidden .main__top,\r\n.has-custom-chrome .main--aside-hidden .main__top,\r\n.platform-win .rp-chrome,\r\n.platform-other .rp-chrome,\r\n.has-custom-chrome .rp-chrome {\r\n  padding-right: 142px;\r\n}\r\n\r\n/* Settings content already clears chrome via .settings-page__content padding-top */\r\n\r\n/* Ensure buttons/inputs inside settings stay interactive under drag CSS */\r\n.settings-page__nav-inner button,\r\n.settings-page__nav-inner input,\r\n.settings-page__main button,\r\n.settings-page__main input,\r\n.settings-page__main textarea {\r\n  -webkit-app-region: no-drag;\r\n  app-region: no-drag;\r\n}\r\n\r\n.main__title-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  /* 标题区按内容占宽，空白区域留给外层标题栏拖动。 */\n  flex: 0 1 auto;\n  max-width: 100%;\n  height: 100%;\n  overflow: hidden;\n  -webkit-app-region: no-drag;\n  app-region: no-drag;\n}\n\n.main__brand-button,\n.main__task-nav-button {\n  width: 28px;\n  min-width: 28px;\n  height: 28px;\n  padding-inline: 0;\n}\n\n.main__task-nav {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  flex-shrink: 0;\n}\n\n.main__new-task-button {\n  width: 28px;\n  min-width: 28px;\n  height: 28px;\n  padding-inline: 0;\n}\n\n@container main-header (max-width: 760px) {\n  .main__task-nav {\n    display: none;\n  }\n}\n\n.main__title {\n  flex: 0 1 auto;\n  min-width: 0;\n  max-width: min(25rem, 42cqw);\n  margin: 0;\n  font-size: calc(14px + var(--ui-font-delta));\n  font-weight: 600;\n  letter-spacing: 0;\n  color: var(--text-primary);\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  line-height: 1.2;\n}\n\n.main__project-context {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  min-width: 28px;\n  height: 28px;\n  color: var(--text-secondary);\n  border-radius: var(--radius-md);\n  flex-shrink: 0;\n}\n\n.main__project-context:hover {\n  color: var(--text-primary);\n  background: var(--bg-hover);\n}\n\n.main__project-context-popover {\n  width: min(24rem, calc(100vw - 2rem));\n  max-width: calc(100vw - 2rem);\n  padding: var(--space-2);\n}\n\n.main__project-context-summary {\n  display: flex;\n  min-width: 0;\n  flex-direction: column;\n  gap: var(--space-2);\n  padding: var(--space-1) var(--space-2) var(--space-2);\n}\n\n.main__project-context-name,\n.main__project-context-branch {\n  display: flex;\n  min-width: 0;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.main__project-context-name strong,\n.main__project-context-branch span,\n.main__project-context-path {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.main__project-context-name strong {\n  color: var(--text-primary);\n  font-size: var(--text-md);\n  font-weight: 600;\n}\n\n.main__project-context-path {\n  color: var(--text-secondary);\n  font-family: var(--font-mono);\n  font-size: var(--text-xs);\n}\n\n.main__project-context-branch {\n  color: var(--text-secondary);\n  font-size: var(--text-xs);\n}\n\n.main__project-context-missing {\n  color: var(--danger);\n  font-size: var(--text-xs);\n}\n\n.main__project-context-option {\n  display: flex;\n  min-width: 0;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.main__project-context-option-copy {\n  display: flex;\n  min-width: 0;\n  flex: 1;\n  flex-direction: column;\n  gap: var(--space-1);\n}\n\n.main__project-context-option-name,\n.main__project-context-option-path {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.main__project-context-option-name {\n  font-weight: 500;\n}\n\n.main__project-context-option-path {\n  color: var(--text-secondary);\n  font-family: var(--font-mono);\n  font-size: var(--text-xs);\n}\n\n.main__title-menu {\n  opacity: 0.7;\r\n}\r\n\r\n.main__title-row:hover .main__title-menu,\n.main__title-menu:focus-visible {\n  opacity: 1;\n}\n\n@container main-header (max-width: 760px) {\n  .main__title {\n    max-width: min(50cqw, 25rem);\n  }\n}\n\n@container main-header (max-width: 560px) {\n  .main__title {\n    max-width: 30cqw;\n  }\n}\n\n@container main-header (max-width: 420px) {\n  .main__title {\n    max-width: 22cqw;\n  }\n}\n\r\n/* ===== KeenCode open-location split control =====\r\n   Height / radius / icon metrics match .chrome-btn (28×28) so it sits\r\n   evenly next to pane toggles in main__top-actions and rp-chrome__actions. */\r\n.open-loc {\r\n  position: relative;\r\n  display: inline-flex;\r\n  align-items: stretch;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.open-loc__main {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px; /* match chrome / chip internal gaps */\r\n  padding: 0 8px 0 8px;\r\n  white-space: nowrap;\r\n  min-width: 0;\r\n}\r\n\r\n.open-loc__app-ico {\r\n  width: 16px;\r\n  height: 16px;\r\n  flex-shrink: 0;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  overflow: hidden;\r\n}\r\n\r\n.open-loc__app-ico img {\r\n  width: 16px;\r\n  height: 16px;\r\n  object-fit: contain;\r\n  display: block;\r\n}\r\n\r\n.open-loc__label {\r\n  line-height: 1;\r\n  letter-spacing: 0;\r\n}\r\n\r\n.open-loc__caret {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 22px;\r\n}\r\n\r\n.open-loc--compact {\r\n  width: auto;\r\n}\r\n\r\n.open-loc--compact .open-loc__main {\r\n  padding: 0 6px;\r\n  gap: 0;\r\n}\r\n\r\n.open-loc--compact .open-loc__caret {\r\n  width: 20px;\r\n  padding: 0 4px 0 0;\r\n}\r\n\r\n.main__top-actions {\n  display: flex;\n  /* Match resource chrome actions (tree + close) and chrome-btn rhythm */\n  gap: 4px;\n  align-items: center;\n  flex-shrink: 0;\n  -webkit-app-region: no-drag;\n  app-region: no-drag;\n}\n\r\n.main__top-actions .open-loc,\r\n.main__top-actions .chrome-btn {\r\n  margin: 0;\r\n}\r\n\r\n/* Chat stage: full-height scroll with the session composer docked in its viewport. */\n.main__stage {\n  position: relative;\r\n  flex: 1;\r\n  min-height: 0;\r\n  min-width: 0;\r\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  /* 消息列和会话态 Composer 共用舞台宽度查询，随右侧栏实际收缩。 */\n  container-type: inline-size;\n  container-name: conversation-stage;\n}\n\r\n/* The conversation transcript fills the stage. */\r\n.main__stage > .lobe-chat {\r\n  flex: 1;\r\n  min-height: 0;\r\n  min-width: 0;\r\n  transition: width var(--motion-enter) var(--ease-out);\r\n}\r\n\r\n/* Windows WebView2 的滚动层保持独立合成边界，降低滚轮滚动时的纹理闪烁。 */\n.platform-win .main__stage {\r\n  isolation: isolate;\r\n}\r\n\r\n.platform-win .main__stage .lobe-chat__scroll {\r\n  contain: paint;\r\n  transform: translateZ(0);\r\n}\r\n\r\n/* Welcome: composer is centered, not bottom-docked — no extra chat pad */\n.main__stage:has(.composer-wrap--welcome) .lobe-chat__inner {\r\n  padding-bottom: 16px;\r\n}\r\n\r\n/* Phosphor SVGs inherit currentColor via wrapper */\r\n.g-icon svg {\r\n  display: block;\r\n}\r\n\r\n/* Markdown */\r\n.md-body {\r\n  font-size: calc(14px + var(--ui-font-delta));\r\n  line-height: 1.6;\r\n  color: var(--text-primary);\r\n  word-break: break-word;\r\n}\r\n\r\n/* Streaming caret intentionally disabled — smooth buffer handles reveal. */\r\n.md-body--streaming::after {\r\n  content: none;\r\n}\r\n\r\n.md-body p {\r\n  margin: 0 0 0.75em;\r\n}\r\n\r\n.md-body p:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.md-body h1,\r\n.md-body h2,\r\n.md-body h3 {\r\n  margin: 1em 0 0.4em;\r\n  font-weight: 600;\r\n  line-height: 1.3;\r\n}\r\n\r\n.md-body h1 {\r\n  font-size: 1.25em;\r\n}\r\n.md-body h2 {\r\n  font-size: 1.12em;\r\n}\r\n.md-body h3 {\r\n  font-size: 1.05em;\r\n}\r\n\r\n.md-body ul,\r\n.md-body ol {\r\n  margin: 0.4em 0 0.75em;\r\n  padding-left: 1.4em;\r\n}\r\n\r\n.md-body li {\r\n  margin: 0.2em 0;\r\n}\r\n\r\n.md-body a {\r\n  color: var(--accent);\r\n  text-decoration: underline;\r\n  text-underline-offset: 2px;\r\n}\r\n\r\n.md-body blockquote {\r\n  margin: 0.6em 0;\r\n  padding: 0.2em 0 0.2em 12px;\r\n  border-left: 3px solid var(--border-strong);\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.md-body__pre {\r\n  margin: 0.6em 0;\r\n  padding: 12px 14px;\r\n  border-radius: var(--radius-lg);\r\n  background: var(--bg-code);\r\n  border: 1px solid var(--border-subtle);\r\n  color: var(--text-primary);\r\n  overflow-x: auto;\r\n  font-family: var(--font-mono);\r\n  font-size: calc(12.5px + var(--ui-font-delta));\r\n  line-height: 1.45;\r\n}\r\n\r\n.md-body__pre code {\r\n  color: inherit;\r\n  background: transparent;\r\n}\r\n\r\n.md-body__code-inline {\r\n  font-family: var(--font-mono);\r\n  font-size: var(--text-sm);\r\n  padding: 2px 6px;\r\n  border-radius: var(--radius-xs);\r\n  background: var(--bg-code);\r\n  color: var(--text-primary);\r\n}\r\n\r\n/*\r\n * Tables: fill wrap by default; overflow scrolls horizontally.\r\n * width 100% + min-width max-content = stretch when narrow, grow when wide.\r\n */\r\n.md-body__table-wrap,\r\n.md-body .chat-md__table-wrap {\r\n  display: block;\r\n  width: 100%;\r\n  max-width: 100%;\r\n  overflow-x: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.md-body table {\r\n  border-collapse: collapse;\r\n  margin: 0.6em 0;\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  width: 100%;\r\n  min-width: max-content;\r\n  max-width: none;\r\n  table-layout: auto;\r\n}\r\n\r\n.md-body th,\r\n.md-body td {\r\n  border: 1px solid var(--border-subtle);\r\n  padding: 6px 12px;\r\n  text-align: left;\r\n  white-space: nowrap;\r\n  word-break: normal;\r\n  overflow-wrap: normal;\r\n}\r\n\r\n.md-body th {\r\n  background: var(--bg-hover);\r\n}\r\n\r\n/* In-conversation find bar (Cmd/Ctrl+F) */\r\n.chat-find {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin: 8px var(--space-5) 0;\r\n  padding: 6px 8px 6px 10px;\r\n  border-radius: var(--radius-window);\r\n  border: 1px solid var(--border-subtle);\r\n  background: var(--bg-card, var(--bg-elevated));\r\n  min-width: 0;\r\n  box-shadow: 0 1px 0 color-mix(in srgb, var(--border-subtle) 60%, transparent);\r\n}\r\n\r\n.chat-find__icon {\r\n  display: inline-flex;\r\n  color: var(--text-tertiary);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.chat-find__input {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  height: 28px;\r\n  border: none;\r\n  outline: none;\r\n  background: transparent;\r\n  color: var(--text-primary);\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  font-family: inherit;\r\n}\r\n\r\n.chat-find__input::placeholder {\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.chat-find__input::-webkit-search-cancel-button {\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n}\r\n\r\n.chat-find__count {\r\n  flex-shrink: 0;\r\n  font-size: calc(11.5px + var(--ui-font-delta));\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text-tertiary);\r\n  min-width: 4.5em;\r\n  text-align: right;\r\n  white-space: nowrap;\r\n}\r\n\r\n.chat-find__count.is-empty {\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.chat-find__actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.chat-find__btn {\r\n  flex-shrink: 0;\r\n}\r\n\r\n.chat-find__btn--close {\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.chat-find__chev--up {\r\n  transform: rotate(90deg);\r\n}\r\n\r\n/* Find hit marks + message chrome */\r\n.chat-find-mark {\r\n  background: color-mix(in srgb, var(--find-alt) 48%, transparent);\r\n  color: inherit;\r\n  border-radius: var(--radius-2xs);\r\n  padding: 0 1px;\r\n}\r\n\r\n.chat-find-mark--current {\r\n  background: color-mix(in srgb, var(--find-current) 72%, transparent);\r\n  outline: 1px solid color-mix(in srgb, var(--find-current) 80%, transparent);\r\n}\r\n\r\n[data-theme=\"light\"] .chat-find-mark {\r\n  background: color-mix(in srgb, var(--find-alt-strong) 70%, transparent);\r\n}\r\n\r\n[data-theme=\"light\"] .chat-find-mark--current {\r\n  background: color-mix(in srgb, var(--find-current-strong) 78%, transparent);\r\n}\r\n\r\n.lobe-chat-item--find-current {\r\n  border-radius: var(--radius-window);\r\n  outline: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);\r\n  outline-offset: 2px;\r\n  background: color-mix(in srgb, var(--accent) 6%, transparent);\r\n}\r\n\r\n.lobe-chat-error.lobe-chat-item--find-current {\r\n  outline: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* 问答卡片与输入框同宽、底部对齐，覆盖待回答期间的输入区。 */\r\n.ask-user-wrap {\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 0;\r\n  left: 0;\r\n  z-index: 21;\r\n  display: flex;\r\n  justify-content: center;\r\n  padding: 24px 16px 14px;\r\n  pointer-events: none;\r\n  transition: right var(--motion-enter) var(--ease-out);\r\n}\r\n\r\n.ask-user {\r\n  position: relative;\r\n  pointer-events: auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  width: 100%;\r\n  max-width: calc(var(--content-max-width) + 32px);\r\n  min-height: max(0px, calc(var(--composer-height, 168px) - 38px));\r\n  max-height: calc(100dvh - 96px);\r\n  padding: 14px;\r\n  overflow-y: auto;\r\n  box-sizing: border-box;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: var(--radius-window);\r\n  background: var(--bg-card);\r\n  box-shadow: var(--shadow-pop);\r\n}\r\n\r\n.ask-user__header,\r\n.ask-user__nav,\r\n.ask-user__custom,\r\n.ask-user__footer {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n/* 长问题会折成多行，导航组必须贴右上角，不随文本块垂直居中。 */\r\n.ask-user__header {\r\n  align-items: flex-start;\r\n  min-height: 32px;\r\n  gap: 12px;\r\n}\r\n\r\n.ask-user__prompt {\r\n  flex: 1;\r\n  min-width: 0;\r\n  margin: 0;\r\n  font-size: calc(15px + var(--ui-font-delta));\r\n  font-weight: 600;\r\n  line-height: 1.4;\r\n  color: var(--text-primary);\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n.ask-user__nav {\r\n  flex-shrink: 0;\r\n  gap: 2px;\r\n}\r\n\r\n.ask-user__page {\r\n  min-width: 44px;\r\n  text-align: center;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  font-variant-numeric: tabular-nums;\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.ask-user__hint {\r\n  margin: -6px 0 0;\r\n  font-size: calc(11.5px + var(--ui-font-delta));\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.ask-user__options {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.ask-user__opt {\r\n  width: 100%;\r\n  text-align: left;\r\n  justify-content: flex-start;\r\n  gap: 10px;\r\n}\r\n\r\n.ask-user__index {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 28px;\r\n  height: 28px;\r\n  flex: 0 0 28px;\r\n  border: 1px solid var(--border-strong);\r\n  border-radius: var(--radius-full);\r\n  color: var(--text-secondary);\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n}\r\n\r\n.ask-user__opt-copy {\r\n  display: flex;\r\n  flex: 1;\r\n  min-width: 0;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n}\r\n\r\n.ask-user__opt-label {\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  font-weight: 550;\r\n  line-height: 1.3;\r\n}\r\n\r\n.ask-user__opt-desc {\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--text-secondary);\r\n  line-height: 1.35;\r\n}\r\n\r\n.ask-user__opt-arrow { flex-shrink: 0; color: var(--text-secondary); }\r\n\r\n.ask-user__custom {\r\n  justify-content: flex-start;\r\n  gap: 10px;\r\n}\r\n\r\n.ask-user__free {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n}\r\n\r\n.ask-user__free-hint {\r\n  font-size: calc(11.5px + var(--ui-font-delta));\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.ask-user__textarea {\r\n  width: 100%;\r\n  box-sizing: border-box;\r\n  resize: vertical;\r\n  min-height: 2.6em;\r\n  max-height: 8em;\r\n  border-radius: var(--radius-lg);\r\n  border: 1px solid var(--border-subtle);\r\n  background: var(--bg-input);\r\n  color: var(--text-primary);\r\n  font: inherit;\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  line-height: 1.4;\r\n  padding: 8px 10px;\r\n}\r\n\r\n.ask-user__textarea:focus {\r\n  outline: none;\r\n  border-color: var(--border-strong);\r\n}\r\n\r\n.ask-user__footer {\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  padding-top: 2px;\r\n}\r\n\r\n/* In-thread turn failure (retries exhausted / provider error) */\r\n.chat-turn-error {\r\n  width: 100%;\r\n  max-width: 48rem;\r\n  margin: 0 auto;\r\n  padding: 12px 14px;\r\n  border-radius: var(--radius-window);\r\n  border: 1px solid color-mix(in srgb, var(--danger) 45%, var(--border-subtle));\r\n  background: var(--danger-muted);\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* Composer — session dock is supplied inside ConversationThread's scroll viewport. */\n.composer-wrap {\n  padding: 12px 16px 16px;\n  position: relative;\n  display: flex;\n  justify-content: center;\n}\n\n.composer-wrap--sticky {\n  width: 100%;\n  box-sizing: border-box;\n  pointer-events: none;\n  padding: 0 16px 16px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n}\n\n/* Empty / new session: welcome copy + composer share the stage's flex flow. */\n.composer-wrap--welcome {\n  position: relative;\n  flex: 1 1 auto;\n  min-height: 0;\n  width: 100%;\n  box-sizing: border-box;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 24px;\n  padding: 0 16px;\n  pointer-events: auto;\n  background: transparent;\n}\n\n/* A fresh draft has no transcript content; let the welcome flex column own the stage. */\n.main__stage:has(.composer-wrap--welcome) > .lobe-chat {\n  display: none;\n}\n\r\n.composer-wrap--welcome .composer {\n  width: 100%;\n  border: 1px solid var(--border-subtle);\n  background: var(--bg-input);\n  padding: 12px;\n  gap: 12px;\n  max-width: 672px;\n  --dsw-elevation-stroke-color: var(--dsw-alias-border-l2);\r\n  box-shadow: var(--dsw-elevation-soft);\r\n}\r\n\r\n/* 欢迎标题由输入区域正常流承载，关闭聊天线程原有的空状态副本。 */\r\n.main__stage:has(.composer-wrap--welcome) .lobe-chat-empty {\r\n  display: none;\r\n}\r\n\r\n/* Context bar + composer share width; tight gap when bar is present */\r\n.composer-stack {\n  pointer-events: none;\n  width: 100%;\n  /* ZCode 的 72rem 包含 dock 的左右 16px 内边距，surface 需扣除 32px。 */\n  max-width: min(100%, calc(72rem - 32px));\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 12px;\n}\n\n@container conversation-stage (min-width: 864px) {\n  .composer-stack {\n    max-width: min(calc(100% - 6rem), calc(56rem - 32px));\n  }\n}\n\n@container conversation-stage (min-width: 1280px) {\n  .composer-stack {\n    max-width: min(calc(100% - 24rem), calc(72rem - 32px));\n  }\n}\n\n.composer-stack--with-context {\n  max-width: inherit;\n  gap: 0;\n  padding: 0;\n  border-radius: var(--radius-composer);\n  background: var(--background-subtle);\n  box-shadow: var(--shadow-composer-context);\n}\n\n.composer-stack .composer {\n  width: 100%;\r\n  max-width: none;\r\n}\r\n\r\n/* 当前计划固定显示在输入框上方，不占用对话消息时间线。 */\r\n.composer-todo {\r\n  --composer-todo-progress: var(--todo-progress);\r\n  pointer-events: auto;\r\n  position: relative;\r\n  z-index: 2;\r\n  align-self: center;\r\n  display: flex;\r\n  width: min(29.5rem, calc(100% - 24px));\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-bottom: 10px;\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.composer-todo__card {\r\n  display: none;\r\n  position: static;\r\n  box-sizing: border-box;\r\n  width: 100%;\r\n  margin: 0;\r\n  padding: 13px 18px;\r\n  list-style: none;\r\n  border: 1px solid color-mix(in srgb, var(--text-secondary) 38%, transparent);\r\n  border-radius: var(--radius-lg);\r\n  background: color-mix(in srgb, var(--bg-elevated) 96%, transparent);\r\n  box-shadow: 0 6px 18px color-mix(in srgb, var(--ink-black) 7%, transparent);\r\n  opacity: 0;\r\n  visibility: hidden;\r\n  transform: translateY(5px);\r\n}\r\n\r\n.composer-todo.is-open .composer-todo__card {\r\n  display: block;\r\n  opacity: 1;\r\n  visibility: visible;\r\n  transform: translateY(0);\r\n}\r\n\r\n.composer-todo__item {\r\n  display: grid;\r\n  grid-template-columns: 20px minmax(0, 1fr);\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-height: 28px;\r\n  font-size: calc(14px + var(--ui-font-delta));\r\n  font-weight: 550;\r\n  line-height: 1.35;\r\n}\r\n\r\n.composer-todo__item-icon {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: var(--text-secondary);\r\n}\r\n\r\n.composer-todo__item--in_progress .composer-todo__item-icon {\r\n  color: var(--composer-todo-progress);\r\n  animation: composer-todo-spin 1.1s linear infinite;\r\n}\r\n\r\n.composer-todo__item--pending {\r\n  color: color-mix(in srgb, var(--text-secondary) 82%, transparent);\r\n}\r\n\r\n.composer-todo__content {\r\n  min-width: 0;\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n.composer-todo__step {\r\n  align-self: center;\r\n  min-height: 38px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.composer-todo__progress {\r\n  width: 16px;\r\n  height: 16px;\r\n  margin-right: 7px;\r\n  flex: 0 0 auto;\r\n  fill: none;\r\n  stroke-width: 2;\r\n  transform: rotate(-90deg);\r\n}\r\n\r\n.composer-todo__progress-track {\r\n  stroke: color-mix(in srgb, var(--text-secondary) 24%, transparent);\r\n}\r\n\r\n.composer-todo__progress-value {\r\n  stroke: var(--composer-todo-progress);\r\n  stroke-linecap: round;\r\n}\r\n\r\n/* 持久 Goal 与 Todo 可同时出现；目标卡作为输入框顶段贴附展示。 */\r\n.composer-goal {\r\n  pointer-events: auto;\r\n  position: relative;\r\n  z-index
ition: relative;\r\n  /* Transparent on mac so sidebar vibrancy is not covered by solid paint */\r\n  background: transparent;\r\n}\r\n\r\n/*\r\n * Left sidebar — frosted glass rail.\r\n * mac: native Sidebar vibrancy + translucent CSS tint (one material layer).\r\n * Light: airy white glass + soft inward edge shade.\r\n * Win: solid via .platform-win .sidebar.\r\n */\r\n.sidebar {\r\n  position: relative;\r\n  width: var(--sidebar-width, 264px);\n  min-width: var(--sidebar-width, 264px);\n  max-width: var(--sidebar-width, 264px);\n  background: var(--bg-sidebar);\r\n  border-right: 0.5px solid var(--border-strong);\r\n  box-shadow: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  /* No outer padding — chrome / brand / scroll / footer own their insets */\r\n  padding: 0;\r\n  gap: 0;\r\n  transition:\r\n    width var(--motion-enter) var(--ease-out),\r\n    min-width var(--motion-enter) var(--ease-out),\r\n    max-width var(--motion-enter) var(--ease-out);\r\n  z-index: 1;\r\n}\r\n\r\n.sidebar.is-resizing {\r\n  transition: none;\r\n}\r\n\r\n/* 三类横向拖拽条只共享完全一致的尺寸与交互声明，定位仍由各自规则负责。 */\r\n.sidebar-resizer,\n.aside-resizer,\n.rp-split__resizer {\n  width: 4px;\n  cursor: col-resize;\r\n  touch-action: none;\r\n}\r\n\r\n.sidebar-resizer,\r\n.aside-resizer {\r\n  position: absolute;\r\n  top: 0;\r\n  bottom: 0;\r\n  z-index: 6;\r\n}\r\n\r\n.sidebar-resizer {\r\n  right: 0;\r\n}\r\n\r\n.sidebar-resizer::after,\r\n.aside-resizer::after,\r\n.rp-split__resizer::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  top: 0;\r\n  bottom: 0;\r\n  width: 2px;\r\n  transition: background var(--motion-fast) var(--ease-out);\r\n}\r\n\r\n.sidebar-resizer::after,\r\n.aside-resizer::after {\r\n  background: transparent;\r\n}\r\n\r\n.sidebar-resizer::after {\r\n  right: 1px;\r\n}\r\n\r\n.sidebar-resizer:hover::after,\r\n.sidebar.is-resizing .sidebar-resizer::after,\r\n.aside-resizer:hover::after,\r\n.aside.is-resizing .aside-resizer::after,\r\n.rp-split__resizer:hover::after,\r\n.rp-split.is-resizing .rp-split__resizer::after {\r\n  background: var(--border-focus);\r\n}\r\n\r\n/* 各平台共用 Harness 实色表面；原生拖动区规则独立保留。 */\r\n/* Fully closed left pane (no icon rail) — reopen from main top icons */\r\n.sidebar--hidden {\r\n  width: 0 !important;\r\n  min-width: 0 !important;\r\n  max-width: 0 !important;\r\n  padding: 0 !important;\r\n  border: none !important;\r\n  overflow: hidden;\r\n  pointer-events: none;\r\n}\r\n\r\n.sidebar--collapsed {\r\n  width: 0 !important;\r\n  min-width: 0 !important;\r\n  max-width: 0 !important;\r\n  padding: 0 !important;\r\n  border: none !important;\r\n  opacity: 0;\r\n  overflow: hidden;\r\n  pointer-events: none;\r\n}\r\n\r\n/* ZCode desktop sidebar: a fixed 48px drag band followed by dense navigation. */\n.sidebar-chrome {\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  height: 48px;\n  min-height: 48px;\n  max-height: 48px;\n  padding: 0 12px 0 16px;\n  /* Traffic lights + control width — must clear red/yellow/green entirely */\r\n  padding-left: var(--titlebar-safe-left, 96px);\r\n  margin: 0;\n  user-select: none;\r\n  flex-shrink: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* macOS：使用 40px 标题栏，按钮中心保持 20px，导航与标题栏间隔 8px。 */\r\n.platform-mac .sidebar-chrome {\r\n  height: var(--titlebar-height, 40px);\r\n  min-height: var(--titlebar-height, 40px);\r\n  max-height: var(--titlebar-height, 40px);\r\n  padding-block: 0;\r\n  margin: 0 0 8px;\r\n}\r\n\r\n.platform-win .sidebar-chrome,\r\n.platform-other .sidebar-chrome,\r\n.has-custom-chrome .sidebar-chrome {\r\n  padding-left: 16px;\r\n}\r\n\r\n/* macOS 全屏：红绿灯收入菜单栏悬停区，侧栏按钮回到与品牌行同一左缘。 */\r\n.platform-mac .app-shell.is-fullscreen .sidebar-chrome {\r\n  padding-left: 16px;\r\n}\r\n\r\n/* Panel toggle next to traffic lights — no extra left margin; keep drawable */\r\n.sidebar-chrome > .chrome-btn--traffic {\r\n  margin-left: 0;\r\n  margin-right: 2px;\r\n  flex-shrink: 0;\r\n  -webkit-app-region: no-drag;\r\n  app-region: no-drag;\r\n  position: r
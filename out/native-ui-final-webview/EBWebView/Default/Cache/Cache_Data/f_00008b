import { createHotContext as __vite__createHotContext } from "/@vite/client";import.meta.hot = __vite__createHotContext("/src/components/lobe-chat/lobe-chat.css");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from "/@vite/client"
const __vite__id = "D:/projects/keen-code/src/components/lobe-chat/lobe-chat.css"
const __vite__css = "/**\r\n * KeenCode chat transcript with soft message surfaces.\r\n * Includes path/code chrome, file links, and file cards.\r\n */\r\n\r\n.lobe-chat {\r\n  /* Type */\r\n  --chat-font: var(--font-sans);\r\n  --chat-mono: var(--font-mono);\r\n\r\n  /* 对话字号跟随界面字号：默认 14px 时与改动前逐像素一致。 */\r\n  --chat-fs: var(--text-md);\n  --chat-prose-fs: var(--text-md);\n  /* 对齐 ZCode MessageResponse 的 text-ui-xl/lg/base：18/16/14px。 */\n  --chat-prose-heading-xl: calc(18px + var(--ui-font-delta));\n  --chat-prose-heading-lg: var(--text-lg);\n  --chat-prose-heading-base: var(--text-md);\n  --chat-fs-sm: var(--text-sm);\n  --chat-fs-xs: var(--text-xs);\r\n  --chat-lh: 1.5;\r\n  --chat-lh-sm: 1.5;\r\n\r\n  --chat-r: 6px;\r\n  --chat-r-lg: 8px;\r\n  --chat-r-sm: 5px;\r\n\r\n  /*\r\n   * Default = follow app design tokens (tokens.css on html[data-theme]).\r\n   * Do NOT pin dark via `:root .lobe-chat` — that forced dark code chrome in\r\n   * light theme and made fenced code unreadable (dark bg + wrong fg).\r\n   */\r\n  --chat-text: var(--text-primary, #e8e8ea);\r\n  --chat-prose-text: var(--chat-text);\r\n  --chat-text-2: var(--text-secondary, #a1a1a6);\r\n  --chat-text-3: var(--text-tertiary, #6e6e73);\r\n  --chat-link: var(--accent, #6db3f2);\r\n  --chat-link-hover: var(--accent-hover, #8fc4f5);\r\n  --chat-bg: transparent;\r\n  /* Code surfaces: always pair bg + fg from the active theme */\r\n  --chat-code-bg: var(--bg-code, #1e1e22);\r\n  --chat-code-fg: var(--text-primary, #e8e8ea);\r\n  --chat-code-bar: color-mix(\r\n    in srgb,\r\n    var(--chat-code-bg) 88%,\r\n    var(--chat-text) 12%\r\n  );\r\n  --chat-code-border: var(--border-subtle, rgba(255, 255, 255, 0.08));\r\n  --chat-inline-code-bg: color-mix(\r\n    in srgb,\r\n    var(--chat-code-bg) 70%,\r\n    transparent\r\n  );\r\n  --chat-inline-code-fg: var(--chat-code-fg);\r\n  --chat-bubble: var(--bg-user-bubble);\r\n  --chat-card: var(--bg-card, #2a2a2e);\r\n  --chat-card-border: var(--border-subtle, rgba(255, 255, 255, 0.08));\r\n  --chat-card-hover: var(--bg-hover, rgba(255, 255, 255, 0.04));\r\n  --chat-divider: var(--border-subtle, rgba(255, 255, 255, 0.08));\r\n  --chat-success: var(--success, #3ecf8e);\r\n  --chat-danger: var(--danger, #f07178);\r\n  --chat-tag-bg: var(--bg-hover, rgba(255, 255, 255, 0.08));\r\n  --chat-icon-btn: var(--text-secondary, rgba(255, 255, 255, 0.55));\r\n  --chat-icon-btn-hover: var(--text-primary, rgba(255, 255, 255, 0.9));\r\n\r\n  font-family: var(--chat-font);\r\n  font-size: var(--chat-fs);\r\n  line-height: var(--chat-lh);\r\n  color: var(--chat-text);\r\n}\r\n\r\n/* Optional dark polish (slightly softer code well than pure --bg-code) */\r\n[data-theme=\"dark\"] .lobe-chat {\r\n  --chat-code-bg: var(--bg-code, #111111);\r\n  --chat-code-fg: var(--text-primary, #e8e8ea);\r\n  --chat-inline-code-bg: rgba(255, 255, 255, 0.08);\r\n  --chat-inline-code-fg: var(--chat-code-fg);\r\n}\r\n\r\n/* Light: elevated soft gray code well + dark ink (never dark-on-dark) */\r\n[data-theme=\"light\"] .lobe-chat {\r\n  /*\r\n   * Final answers need denser, near-neutral ink than the translucent,\r\n   * skin-tinted application foreground. Keep activity chrome on the shared\r\n   * secondary tokens so process and answer remain visually distinct.\r\n   */\r\n  --chat-prose-text: var(--text-primary);\r\n  --chat-code-bg: var(--bg-code, #f0f0f2);\r\n  --chat-code-fg: var(--text-primary, #1d1d1f);\r\n  --chat-code-bar: color-mix(in srgb, var(--chat-code-bg) 92%, #000 8%);\r\n  --chat-code-border: var(--border-subtle, rgba(0, 0, 0, 0.08));\r\n  --chat-inline-code-bg: rgba(0, 0, 0, 0.06);\r\n  --chat-inline-code-fg: var(--chat-code-fg);\r\n  --chat-bubble: var(--bg-user-bubble);\r\n  --chat-card: var(--bg-card, #f5f5f7);\r\n  --chat-card-border: var(--border-subtle, rgba(0, 0, 0, 0.08));\r\n  --chat-card-hover: var(--bg-hover, rgba(0, 0, 0, 0.03));\r\n  --chat-icon-btn: var(--text-secondary, rgba(0, 0, 0, 0.45));\r\n  --chat-icon-btn-hover: var(--text-primary, rgba(0, 0, 0, 0.85));\r\n}\r\n\r\n/* ── Shell ── */\r\n.lobe-chat {\r\n  --chat-content-max: 100%;\r\n  position: relative;\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1;\r\n  min-height: 0;\r\n  width: 100%;\r\n  background: var(--chat-bg);\r\n  color: var(--chat-text);\r\n}\r\n\r\n.lobe-chat__scroll {\n  flex: 1;\r\n  min-height: 0;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\n  scrollbar-gutter: stable;\n  overscroll-behavior: contain;\r\n  /* We manage stick-to-bottom ourselves; browser anchoring fights\n   * programmatic scrollTop during stream growth and feels like bounce. */\n  overflow-anchor: none;\n}\n\n.lobe-chat__scroll-content {\n  width: 100%;\n  min-height: 100%;\n  display: flex;\n  flex-direction: column;\n}\n\n.lobe-chat__inner {\n  box-sizing: border-box;\n  width: 100%;\n  max-width: min(100%, 72rem);\n  margin: 0 auto;\n  padding: 0 0 28px;\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n\n/* ZCode 的会话列在中等桌面保留 3rem 两侧空间，大屏为状态面板让位。 */\n@container conversation-stage (min-width: 864px) {\n  .lobe-chat__inner {\n    max-width: min(calc(100% - 6rem), 56rem);\n  }\n}\n\n@container conversation-stage (min-width: 1280px) {\n  .lobe-chat__inner {\n    max-width: min(calc(100% - 24rem), 72rem);\n  }\n}\n\r\n/* ── Message rows ── */\r\n.lobe-chat-item {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  max-width: 100%;\n  padding: 56px 16px 20px;\n  gap: 0;\n  box-sizing: border-box;\n}\n\n.lobe-chat-item--user {\n  align-items: flex-end;\n  padding-inline-start: 16px;\n}\n\n.lobe-chat-item--assistant {\n  padding-top: 20px;\n}\n\n/* 用户行的底部 20px 已经承担相邻 Assistant 的组间距；独立 Assistant\n * 和连续 Assistant 行仍保留自己的顶部 20px。虚拟列表用外层测量容器，\n * 因此同步覆盖该 DOM 形态。 */\n.lobe-chat-item--user + .lobe-chat-item--assistant,\n.lobe-chat__inner\n  > [data-virtual-message-index]:has(> .lobe-chat-item--user)\n  + [data-virtual-message-index]\n  > .lobe-chat-item--assistant {\n  padding-top: 0;\n}\n\n@container conversation-stage (min-width: 864px) {\n  .lobe-chat-item {\n    padding-inline: 24px;\n  }\n\n  .lobe-chat-item--user {\n    padding-inline-start: 24px;\n  }\n}\n\r\n/*\r\n * 用户消息行还包含块级包装、附件和操作区。WebKit 会把这些结构边界\r\n * 序列化成换行；整行先禁选，只重新开放真正的消息正文。\r\n */\r\n.lobe-chat .lobe-chat-item--user,\r\n.lobe-chat .lobe-chat-item--user * {\r\n  -webkit-user-select: none;\r\n  user-select: none;\r\n}\r\n\r\n.lobe-chat .lobe-chat-item--user .user-msg-body,\r\n.lobe-chat .lobe-chat-item--user .user-msg-body * {\r\n  -webkit-user-select: text;\r\n  user-select: text;\r\n}\r\n\r\n.lobe-chat-item--assistant {\r\n  align-items: stretch;\r\n}\r\n\r\n.lobe-chat-item__header {\r\n  display: none; /* no avatars / titles */\r\n}\r\n\r\n.lobe-chat-item__body {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n  max-width: 100%;\n  min-width: 0;\n  overflow: hidden;\n}\r\n\r\n.lobe-chat-item--assistant .lobe-chat-item__body {\r\n  width: 100%;\r\n}\r\n\r\n/* ZCode user row: surface bubble with a deliberately clipped top-right corner. */\n.lobe-chat-bubble {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-width: 100%;\n  padding: 12px 16px;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-lg);\n  border-top-right-radius: var(--radius-xs);\n  background: var(--chat-bubble);\n  color: var(--chat-text);\n  font-size: var(--chat-fs);\n  line-height: var(--leading-normal);\n  white-space: pre-wrap;\n  word-break: break-word;\n  box-shadow: none;\n}\n\n@container conversation-stage (min-width: 624px) {\n  .lobe-chat-bubble {\n    max-width: 36rem;\n  }\n}\n\n.lobe-chat-user-body {\n  position: relative;\n  min-width: 0;\n}\n\n/* 历史消息中的 Mention 是正文内联 token；不要继承 Composer 的胶囊按钮外观。 */\n.message-mention {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  max-width: 100%;\n  margin: 0 2px;\n  padding: 0 5px;\n  border-radius: var(--radius-sm);\n  background: var(--bg-hover);\n  color: var(--chat-text);\n  font-weight: 500;\n  line-height: calc(24px + var(--ui-font-delta));\n  vertical-align: middle;\n  user-select: none;\n  white-space: nowrap;\n}\n\n.message-mention__icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: 0 0 auto;\n  color: var(--chat-text-2);\n}\n\n.message-mention__label {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.message-mention--file .message-mention__icon {\n  color: var(--accent);\n}\n\n.message-mention--directory .message-mention__icon {\n  color: var(--success);\n}\n\n.message-mention--session .message-mention__icon {\n  color: var(--warning);\n}\n\n.message-mention--plugin .message-mention__icon {\n  color: var(--info);\n}\n\n.message-mention--skill .message-mention__icon {\n  color: var(--accent);\n}\n\n.lobe-chat-user-body__content {\n  min-width: 0;\n  max-height: 120px;\n  overflow: hidden;\n  transition: max-height var(--motion-enter) var(--ease-out);\n}\n\n.lobe-chat-user-body__content.is-expanded {\n  max-height: var(--user-message-content-height);\n}\n\n.lobe-chat-user-body__content.is-collapsed {\n  mask-image: linear-gradient(\n    to bottom,\n    var(--text-primary) 0%,\n    var(--text-primary) 70%,\n    transparent 100%\n  );\n}\n\n.lobe-chat-user-body__toggle {\n  position: absolute;\n  inset: auto 0 0;\n  display: flex;\n  justify-content: center;\n}\n\n.lobe-chat-user-body__toggle.is-expanded {\n  position: static;\n  padding-top: 8px;\n}\n\n.lobe-chat-user-body__toggle [data-slot=\"button\"] {\n  border-radius: var(--radius-full);\n  background: var(--bg-main);\n  box-shadow: var(--shadow-sm);\n}\n\n.lobe-chat-user-body__toggle svg {\n  transition: transform var(--motion-enter) var(--ease-out);\n}\n\n.lobe-chat-user-body__toggle svg.is-expanded {\n  transform: rotate(180deg);\n}\n\r\n.lobe-chat-user-editor {\n  box-sizing: border-box;\r\n  width: min(36rem, calc(100vw - 64px));\r\n  min-height: 132px;\r\n  padding: 18px 16px 14px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 14px;\r\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-lg);\n  border-top-right-radius: var(--radius-xs);\n  background: var(--chat-bubble);\n}\n\r\n.lobe-chat .lobe-chat-user-editor textarea {\r\n  flex: 1 1 auto;\r\n  min-height: 64px;\r\n  resize: vertical;\r\n  border: 0;\r\n  outline: 0;\r\n  background: transparent;\r\n  color: var(--chat-text);\r\n  font: inherit;\r\n  line-height: var(--chat-lh);\r\n  -webkit-user-select: text;\r\n  user-select: text;\r\n}\r\n\r\n.lobe-chat-user-editor__actions {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n}\r\n\r\n.lobe-chat-user-editor__actions > * {\r\n  min-width: 64px;\r\n}\r\n\r\n/* 所有轮次统一在悬浮或键盘聚焦时显示操作栏，隐藏时保留高度以免布局跳动。 */\r\n.lobe-chat-item__actions {\n  display: flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n  max-width: 100%;\n  min-width: 0;\n  margin-top: 4px;\n  opacity: 0;\n  pointer-events: none;\r\n  transition: opacity 160ms ease;\r\n}\r\n\r\n.lobe-chat-item:hover .lobe-chat-item__actions,\r\n.lobe-chat-item:focus-within .lobe-chat-item__actions {\r\n  opacity: 1;\r\n  pointer-events: auto;\r\n}\r\n\r\n/* Thought/tool-only turns have no pre-existing action row. Float metrics over\r\n * the row's lower padding so a hidden footer never adds permanent height. */\r\n.lobe-chat-item__actions--overlay {\r\n  position: absolute;\r\n  z-index: 4;\r\n  inset-inline-start: 0;\r\n  bottom: -8px;\r\n  max-width: 100%;\r\n  border-radius: 6px;\r\n  background: var(--chat-bg);\r\n}\r\n\r\n.lobe-chat-item--user .lobe-chat-item__actions {\r\n  justify-content: flex-end;\r\n}\r\n\r\n.lobe-chat-item--assistant .lobe-chat-item__actions {\r\n  justify-content: flex-start;\r\n}\r\n\r\n.lobe-chat-action-time {\r\n  font-size: calc(11px + var(--ui-font-delta));\r\n  line-height: calc(28px + var(--ui-font-delta));\r\n  color: var(--chat-text-3, var(--text-tertiary));\r\n  font-variant-numeric: tabular-nums;\r\n  user-select: none;\r\n  padding-inline: 4px 2px;\r\n  white-space: nowrap;\r\n}\r\n\r\n@media (hover: none) {\r\n  .lobe-chat-item__actions {\r\n    opacity: 1;\r\n    pointer-events: auto;\r\n  }\r\n}\r\n\r\n/* ── Markdown body ── */\r\n.chat-md {\n  /* 不使用 Harness 的 font 简写：它会把 Codex 的 430 可变字重重置为 400。 */\r\n  font-family: var(--chat-font);\n  font-weight: var(--font-ui-weight);\n  font-size: var(--chat-prose-fs);\n  /* 对齐 ZCode MessageResponse：正文使用 unitless 行高，字号变化时保持比例。 */\n  line-height: 1.75;\n  letter-spacing: 0.025em;\n  color: var(--chat-prose-text);\r\n  word-break: break-word;\r\n  min-width: 0;\r\n}\r\n\r\n.chat-md > *:first-child {\r\n  margin-top: 0;\r\n}\r\n.chat-md > *:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.chat-md p {\n  margin: 12px 0;\n}\n.chat-md p:last-child {\r\n  margin-bottom: 0;\r\n}\r\n\r\n.chat-md h1,\n.chat-md h2,\n.chat-md h3,\n.chat-md h4,\n.chat-md h5,\n.chat-md h6 {\n  margin: 24px 0 16px;\n  font-weight: 600;\n  color: var(--chat-prose-text);\n  letter-spacing: 0;\n}\n.chat-md h1 {\n  font-size: var(--chat-prose-heading-xl);\n  line-height: calc(30px + var(--ui-font-delta));\n}\n.chat-md h2 {\n  font-size: var(--chat-prose-heading-lg);\n  line-height: calc(28px + var(--ui-font-delta));\n}\n.chat-md h3 {\n  font-size: var(--chat-prose-heading-base);\n  line-height: calc(26px + var(--ui-font-delta));\n}\n.chat-md h4 {\n  font-size: var(--chat-prose-fs);\n  line-height: calc(24px + var(--ui-font-delta));\n}\n.chat-md h5 {\n  font-size: var(--chat-prose-fs);\n  font-weight: 500;\n  line-height: calc(24px + var(--ui-font-delta));\n}\n.chat-md h6 {\n  font-size: var(--chat-prose-fs);\n  font-weight: 400;\n  line-height: calc(24px + var(--ui-font-delta));\n}\n\r\n/* Markdown lists follow ZCode's native marker and wrapping semantics. */\n.chat-md ul {\n  margin: 12px 0;\n  padding-left: 20px;\n  list-style: disc outside;\n}\n\n.chat-md ol {\n  margin: 12px 0;\n  padding-left: 0;\n  list-style: decimal inside;\n}\n\n.chat-md ul::marker,\n.chat-md ol::marker {\n  color: var(--foreground-subtlest, var(--text-tertiary));\n}\n\n.chat-md li {\n  padding-left: 4px;\n}\n\n.chat-md li > p {\n  display: inline;\n  margin: 0;\n}\n\n.chat-md ul > li + li,\n.chat-md ol > li + li {\n  margin-top: 6px;\n}\n\n.chat-md ul ul,\n.chat-md ul ol,\n.chat-md ol ul,\n.chat-md ol ol {\n  margin-block: 6px;\n}\n\r\n.chat-md strong {\r\n  font-weight: 600;\r\n  color: var(--chat-prose-text);\r\n}\r\n\r\n.chat-md blockquote {\n  margin: 16px 0;\n  padding: 0 0 0 12px;\n  border-left: 2px solid var(--border-subtle);\n  color: var(--chat-text-2);\n}\n\r\n/* 引用文字与竖线对齐：清除继承的段落外边距，否则 p 的 16px margin-top\r\n * 会把首行推离竖线顶端。 */\r\n.chat-md blockquote > p {\n  margin: 0;\n}\n\n.chat-md blockquote > p + p {\n  margin-top: 8px;\n}\n\r\n.chat-md hr {\r\n  display: block;\r\n  height: 1px;\r\n  margin: 24px 0;\r\n  border: none;\r\n  background: var(--chat-divider);\r\n}\r\n\r\n.chat-md__link {\n  color: var(--chat-link);\n  text-decoration: underline;\n  text-decoration-style: dotted;\n  text-underline-offset: 4px;\n}\n.chat-md__link:hover {\n  color: var(--chat-link-hover);\n  text-decoration-style: solid;\n}\n\r\n/* File path / name links (blue + doc icon) */\r\n\r\n/* Inline code / tags — always readable on both themes */\r\n.chat-md__inline-code,\n.chat-md :not(pre) > code {\n  display: inline;\n  margin-inline: 2px;\n  padding: 2px 6px;\n  border-radius: var(--radius-md);\n  background: var(--chat-inline-code-bg);\r\n  border: 0;\r\n  font-family: var(--chat-mono);\r\n  font-size: var(--text-sm);\r\n  color: var(--chat-inline-code-fg);\r\n  box-shadow: none;\r\n  outline: none;\r\n}\r\n\r\n/* ── Code / path block (theme-aware chrome) ── */\r\n.chat-code {\n  /* ZCode 代码面板使用 rounded-xl 语义，消息上下保持 16px 外边距。 */\n  margin: 16px 0;\n  border-radius: var(--radius-lg);\n  background: var(--chat-code-bg);\n  border: 1px solid var(--border-subtle);\n  color: var(--chat-code-fg);\r\n  overflow: hidden;\r\n  box-shadow: none;\r\n}\r\n\r\n.chat-code__bar {\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  min-height: 30px;\r\n  padding: 8px 12px;\n  background: transparent;\r\n  border-bottom: none;\r\n  color: var(--chat-text-2);\r\n  font: 11px/18px var(--font-sans);\r\n}\r\n\r\n.chat-code__lang {\n  display: inline-flex;\n  align-items: center;\n  min-width: 0;\n  flex: 1 1 auto;\n  gap: 6px;\n  font-size: var(--text-sm);\n  font-weight: 600;\n  color: var(--chat-code-fg);\r\n  user-select: none;\r\n  line-height: calc(18px + var(--ui-font-delta));\n}\n\n.chat-code__icon {\n  display: inline-flex;\n  flex: 0 0 auto;\n}\n\n.chat-code__language-label {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  color: var(--chat-text-3);\n  font-weight: 500;\n}\n\r\n.chat-code__bar-actions {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 2px;\r\n}\r\n\r\n.chat-code__pre {\n  margin: 0;\r\n  /* Codex 实测：pre 内边距 8px（--spacing × 2）、行高 20px（--spacing × 5）。\r\n   * 头部栏到代码首行的距离由这里决定，16px 会比 Codex 大一倍。 */\r\n  padding: 8px 0;\n  overflow: auto;\n  font-family: var(--chat-mono);\n  /* 代码字号跟随界面基线，默认是 14px；行距保持 20px 便于扫描。 */\n  font-size: var(--chat-fs);\n  line-height: calc(var(--spacing) * 5);\r\n  /* Explicit fg — never inherit a muted/wrong parent color */\r\n  color: var(--chat-code-fg) !important;\r\n  background: var(--bg-code);\r\n  border: none;\r\n  border-radius: 0;\r\n  box-shadow: none;\r\n  outline: none;\r\n  white-space: pre;\r\n  -webkit-text-fill-color: var(--chat-code-fg);\n}\n\r\n.chat-code__pre.is-wrap {\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n.chat-code__pre code {\n  display: block;\n  min-width: max-content;\n  font: inherit;\n  color: var(--chat-code-fg) !important;\r\n  -webkit-text-fill-color: var(--chat-code-fg);\r\n  background: none !important;\r\n  border: none;\r\n  padding: 0;\r\n  white-space: inherit;\n}\n\n.chat-code__line {\n  position: relative;\n  display: block;\n  min-height: calc(var(--spacing) * 5);\n  padding: 0 12px;\n  color: inherit;\n  white-space: inherit;\n}\n\n.chat-code__line-content {\n  display: inline;\n  white-space: inherit;\n}\n\n.chat-code__line.is-focused {\n  background: color-mix(in srgb, var(--chat-link) 10%, transparent);\n}\n\n.chat-code__line.is-marked {\n  background: color-mix(in srgb, var(--chat-danger) 10%, transparent);\n}\n\n.chat-code__line.is-focused.is-marked {\n  background: color-mix(in srgb, var(--chat-danger) 14%, transparent);\n}\n\n.chat-code__pre.is-wrap,\n.chat-code__pre.is-wrap code {\n  min-width: 0;\n}\n\n.chat-code__pre.is-wrap .chat-code__line {\n  overflow-wrap: anywhere;\n  white-space: pre-wrap;\n}\n\n.chat-code__pre.is-wrap .chat-code__line-content {\n  white-space: pre-wrap;\n}\n\n.chat-mermaid {\n  min-width: 0;\n  background: var(--chat-code-bg);\n  color: var(--chat-code-fg);\n}\n\n.chat-mermaid__loading {\n  padding: 8px 14px 0;\n  color: var(--chat-text-3);\n  font-size: var(--chat-fs-sm);\n}\n\n.chat-mermaid__source {\n  max-height: 240px;\n}\n\n.chat-mermaid__svg {\n  display: flex;\n  min-height: 140px;\n  max-height: 420px;\n  align-items: center;\n  justify-content: center;\n  padding: 18px;\n  overflow: auto;\n}\n\n.chat-mermaid__svg > svg {\n  display: block;\n  width: auto;\n  max-width: 100%;\n  height: auto;\n}\n\n.chat-diagram-dialog {\n  width: min(96vw, 72rem);\n  max-width: none;\n  height: min(90vh, 56rem);\n  max-height: 90vh;\n}\n\n.chat-diagram-dialog__header {\n  flex: 0 0 auto;\n}\n\n.chat-diagram-dialog__body {\n  display: flex;\n  min-height: 0;\n  flex: 1 1 auto;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.chat-diagram-dialog__viewport {\n  display: flex;\n  min-height: 0;\n  flex: 1 1 auto;\n  align-items: center;\n  justify-content: center;\n  overflow: auto;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-lg);\n  background: var(--chat-code-bg);\n}\n\n.chat-diagram-dialog__canvas {\n  display: flex;\n  min-width: min-content;\n  min-height: min-content;\n  align-items: center;\n  justify-content: center;\n  transform: scale(var(--chat-diagram-scale, 1));\n  transform-origin: center;\n  transition: transform var(--motion-enter) var(--ease-out);\n}\n\n.chat-diagram-dialog__canvas > svg {\n  display: block;\n  width: auto;\n  max-width: none;\n  height: auto;\n}\n\n.chat-diagram-dialog__controls {\n  display: inline-flex;\n  flex: 0 0 auto;\n  align-items: center;\n  align-self: center;\n  gap: 2px;\n  color: var(--chat-text-2);\n}\n\n.chat-diagram-dialog__zoom {\n  min-width: 48px;\n  color: var(--chat-text-2);\n  font-size: var(--chat-fs-sm);\n  font-variant-numeric: tabular-nums;\n  text-align: center;\n}\n\n.chat-diagram-dialog__hint {\n  margin-inline-start: 4px;\n  color: var(--chat-text-3);\n}\n\r\n/* Settled fences only: compact syntax tokens from highlight.js output. */\r\n.chat-code .hljs-comment,\r\n.chat-code .hljs-quote {\r\n  color: #7f848e;\r\n  font-style: italic;\r\n}\r\n.chat-code .hljs-keyword,\r\n.chat-code .hljs-doctag,\r\n.chat-code .hljs-formula {\r\n  color: #c678dd;\r\n}\r\n.chat-code .hljs-name,\r\n.chat-code .hljs-section,\r\n.chat-code .hljs-selector-tag,\r\n.chat-code .hljs-deletion {\r\n  color: #e06c75;\r\n}\r\n.chat-code .hljs-string,\r\n.chat-code .hljs-regexp,\r\n.chat-code .hljs-addition,\r\n.chat-code .hljs-attribute {\r\n  color: #98c379;\r\n}\r\n.chat-code .hljs-attr,\r\n.chat-code .hljs-number,\r\n.chat-code .hljs-type,\r\n.chat-code .hljs-variable,\r\n.chat-code .hljs-selector-class {\r\n  color: #d19a66;\r\n}\r\n.chat-code .hljs-built_in,\r\n.chat-code .hljs-title.class_,\r\n.chat-code .hljs-class .hljs-title {\r\n  color: #e6c07b;\r\n}\r\n.chat-code .hljs-literal,\r\n.chat-code .hljs-meta,\r\n.chat-code .hljs-symbol,\r\n.chat-code .hljs-title {\r\n  color: #61aeee;\r\n}\r\n.chat-code .hljs span {\r\n  -webkit-text-fill-color: currentColor;\r\n}\r\n\r\n[data-theme=\"light\"] .chat-code .hljs-comment,\r\n[data-theme=\"light\"] .chat-code .hljs-quote {\r\n  color: #a
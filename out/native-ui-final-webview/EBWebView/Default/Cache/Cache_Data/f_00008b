ar(--bg-hover);\r\n  color: var(--text-tertiary);\r\n  font-size: calc(10px + var(--ui-font-delta));\r\n  font-weight: 500;\r\n  line-height: 1.4;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.lobe-subagent-card__exception,\r\n.lobe-subagent-card__status {\r\n  flex: 0 0 auto;\r\n  font-size: var(--text-xs);\r\n}\r\n\r\n.lobe-subagent-card__exception {\r\n  color: var(--danger);\r\n}\r\n\r\n/* 中断沿用既有状态标签的排版，仅以中性色区别于真正失败。 */\r\n.lobe-subagent-card__status {\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n.lobe-subagent-card__identity small {\r\n  display: block;\r\n  width: 100%;\r\n  overflow: hidden;\r\n  color: var(--text-tertiary);\r\n  font-size: var(--text-xs);\r\n  font-weight: 400;\r\n  line-height: 1.35;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.lobe-subagent-card__chevron {\r\n  flex: 0 0 auto;\r\n  color: var(--text-tertiary);\r\n}\r\n\r\n/* ── Thinking disclosure ── */\r\n.lobe-chat-thinking {\r\n  width: 100%;\r\n  min-width: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0;\r\n}\r\n\r\n.lobe-chat-thinking__trigger {\n  position: relative;\n  overflow: hidden;\n  box-sizing: border-box;\n  display: flex;\n  align-items: center;\n  align-self: flex-start;\n  width: fit-content;\n  max-width: 100%;\n  min-width: 0;\n  flex-shrink: 1;\n  height: 24px;\n  margin: 0;\r\n  gap: 8px;\n  line-height: 24px;\n  text-align: left;\n}\n\n/* Appica Collapsible 负责高度过渡；面板本身保持零宽度约束，避免长 reasoning\n * 在 flex 行中把消息列撑开。内容节点在关闭动画结束后才由 Thinking 卸载。 */\n.lobe-chat-thinking__content {\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n}\n\n/* 间距放在内容节点内部，收起时由 Collapsible 高度动画一起裁切，避免窄屏末帧跳动。 */\n.lobe-chat-thinking__content-inner {\n  box-sizing: border-box;\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  padding-top: 12px;\n}\n\n.lobe-chat-thinking__trigger--status {\n  width: 100%;\r\n  height: auto;\r\n  min-height: 34px;\r\n  padding: 4px 0 6px;\r\n}\r\n\r\n.lobe-chat-model-divider {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 16px;\r\n  color: var(--chat-text-2);\r\n  font-size: var(--chat-fs-sm);\r\n  font-weight: 500;\r\n  white-space: nowrap;\r\n}\r\n\r\n.lobe-chat-model-divider::before,\r\n.lobe-chat-model-divider::after {\r\n  height: 1px;\r\n  flex: 1;\r\n  background: var(--chat-divider);\r\n  content: \"\";\r\n}\r\n\r\n.lobe-chat-thinking__leading {\n  position: relative;\r\n  flex: none;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 16px;\n  height: 16px;\n  margin-right: 0;\n  color: var(--chat-text-3);\r\n}\r\n\r\n.lobe-chat-thinking__icon {\n  color: var(--chat-text-3);\n  transform: none;\n}\n\r\n.lobe-chat-thinking__title {\n  flex: none;\n  color: var(--chat-text-2);\n  font-size: var(--chat-fs);\n  font-weight: 500;\n  line-height: 24px;\n}\n\n.lobe-chat-thinking__title-text {\n  display: inline-block;\n  white-space: nowrap;\n}\n\r\n.lobe-chat-thinking__duration {\n  flex: none;\r\n  color: var(--chat-text-3);\r\n  font-size: var(--chat-fs);\n}\r\n\r\n.lobe-chat-thinking__separator {\r\n  flex: none;\r\n  width: 2px;\r\n  height: 2px;\r\n  margin: 0 8px;\r\n  border-radius: 1px;\r\n  background: var(--chat-text-3);\r\n}\r\n\r\n.lobe-chat-thinking__label {\r\n  min-width: 0;\r\n  flex: 0 1 auto;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-family: inherit;\r\n  font-size: calc(12.5px + var(--ui-font-delta));\r\n  color: var(--chat-text-2);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.lobe-chat-thinking__label--live {\r\n  color: var(--chat-text-2);\r\n  opacity: 1;\r\n}\r\n\r\n.lobe-chat-thinking__summary {\n  display: block;\n  box-sizing: border-box;\n  min-width: 0;\n  overflow: hidden;\n  flex: 1 1 auto;\r\n  color: var(--chat-text-3);\r\n  font-size: var(--chat-fs);\n  line-height: 24px;\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.lobe-chat-thinking__summary[data-follow-end] {\n  text-overflow: clip;\n}\n\n.lo
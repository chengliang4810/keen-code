ng__body {\n  box-sizing: border-box;\n  width: 100%;\n  max-width: 100%;\n  min-width: 0;\n  max-height: 240px;\n  margin: 0;\n  padding: 0 0 0 14px;\n  overflow: auto;\n  scrollbar-gutter: stable;\n  overscroll-behavior: contain;\n  border-left: 1px solid var(--chat-divider);\n  color: var(--chat-text-3);\r\n  font-size: calc(13px + var(--ui-font-delta));\r\n  line-height: 1.6;\r\n  white-space: pre-wrap;\r\n  word-break: break-word;\r\n}\r\n\r\n/* Inside phase rail: thinking sits flush with markdown text. */\r\n.lobe-timeline-rail > .lobe-chat-thinking {\r\n  margin: 0;\r\n}\r\n.lobe-timeline-rail .lobe-chat-thinking__trigger {\r\n  padding-inline: 0;\r\n}\r\n.lobe-timeline-rail .lobe-chat-thinking__body {\n  padding-left: 14px;\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\n  .animated-gradient-text {\n    animation: none;\n  }\n}\n\r\n/* Failed tools: no transcript banner — red dots live only in turn-activity. */\r\n\r\n/* ── End-of-turn chip family ── */\r\n.lobe-end-turn {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  width: fit-content;\r\n  max-width: 100%;\r\n  margin: 8px 0 4px;\r\n  padding: 4px 0;\r\n  color: var(--chat-text-2);\r\n  font-size: var(--chat-fs-sm);\r\n}\r\n.lobe-end-turn--warning {\r\n  color: var(--chat-warning, #c90);\r\n}\r\n.lobe-end-turn--error {\r\n  color: var(--chat-danger, #e11);\r\n}\r\n.lobe-end-turn__mark {\r\n  display: inline-flex;\r\n  opacity: 0.75;\r\n}\r\n.lobe-end-turn__title {\r\n  color: inherit;\r\n}\r\n\r\n/* ── Work phase header ── */\r\n.lobe-timeline-phase {\r\n  width: 100%;\r\n  max-width: var(--chat-content-max, 48rem);\r\n  margin: 0;\r\n  font-size: calc(12px + var(--ui-font-delta));\r\n  color: var(--chat-text-2);\r\n}\r\n.lobe-timeline-phase__trigger {\r\n  justify-content: flex-start;\r\n  gap: 6px;\r\n  width: 100%;\r\n  min-height: 24px;\r\n  margin: 0;\r\n  padding: 2px 0;\r\n  text-align: left;\r\n}\r\n.lobe-timeline-phase__activity {\r\n  width: 10px;\r\n  height: 10px;\r\n 
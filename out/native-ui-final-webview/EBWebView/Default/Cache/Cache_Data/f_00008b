tool.is-error .lobe-timeline-tool__icon {\r\n  color: var(--chat-danger, #c44);\r\n}\r\n.lobe-timeline-tool__action {\n  flex: 0 0 auto;\n  font-size: var(--chat-fs);\n  font-weight: 500;\n  white-space: nowrap;\n}\n.lobe-timeline-tool__primary {\n  display: flex;\n  flex: 1 1 auto;\n  min-width: 0;\n  align-items: baseline;\n  overflow: hidden;\n  gap: 8px;\n}\n.lobe-timeline-tool__name {\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-size: var(--chat-fs);\n  font-weight: 500;\r\n  color: var(--chat-text-2);\r\n}\r\n.lobe-timeline-tool__name.is-error {\r\n  color: var(--chat-danger, #c44);\r\n}\r\n.lobe-timeline-tool.is-running .lobe-timeline-tool__name {\r\n  color: var(--chat-text);\r\n}\r\n.lobe-timeline-tool__path {\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\r\n  font-size: calc(11px + var(--ui-font-delta));\r\n  color: var(--chat-text-2);\r\n}\r\n.lobe-timeline-tool__meta {\n  display: inline-flex;\n  align-items: center;\n  flex: 0 0 auto;\n  gap: 7px;\n  margin-inline-start: auto;\n  color: var(--chat-text-2);\n  font-size: var(--chat-fs-sm);\n  white-space: nowrap;\r\n}\r\n.lobe-timeline-tool__meta.is-error {\r\n  color: var(--chat-danger, #c44);\r\n}\r\n.lobe-timeline-tool__chevron {\n  display: inline-flex;\r\n  color: var(--chat-text-3);\r\n  opacity: 0;\n  transition:\n    opacity var(--motion-enter) var(--ease-out),\n    transform var(--motion-enter) var(--ease-out);\n}\n.lobe-timeline-tool__row:hover .lobe-timeline-tool__chevron,\n.lobe-timeline-tool__row:focus-visible .lobe-timeline-tool__chevron,\n.lobe-timeline-tool__chevron.is-open {\n  opacity: 1;\n}\n.lobe-timeline-tool__chevron.is-open {\n  transform: rotate(90deg);\n}\n.lobe-timeline-tool__detail-shell[data-closed] {\n  pointer-events: none;\n}\n.lobe-timeline-tool__detail {\n  margin: 8px 0 0 24px;
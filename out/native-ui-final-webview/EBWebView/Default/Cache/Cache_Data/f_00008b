e;\r\n  /* Fill container when content is narrow; grow when content is wide */\r\n  width: 100%;\r\n  min-width: max-content;\r\n  max-width: none;\r\n  margin: 0;\r\n  font-size: var(--chat-fs-sm);\r\n  line-height: var(--chat-lh-sm);\r\n  table-layout: auto;\r\n}\r\n\r\n.chat-md th,\r\n.chat-md td {\r\n  border-bottom: 1px solid var(--chat-divider);\r\n  padding: 8px 14px;\r\n  text-align: left;\r\n  vertical-align: top;\r\n  color: var(--chat-text);\r\n  white-space: nowrap;\r\n  word-break: normal;\r\n  overflow-wrap: normal;\r\n}\r\n\r\n.chat-md th {\r\n  background: rgba(128, 128, 128, 0.08);\r\n  font-weight: 600;\r\n}\r\n\r\n.chat-md tbody tr:last-child td {\r\n  border-bottom: none;\r\n}\r\n\r\n/* Streaming caret disabled — smooth buffer handles reveal. */\r\n.chat-md--streaming > *:last-child::after {\r\n  content: none;\r\n  display: none;\r\n}\r\n\r\n/* Muted prose only — do not paint code blocks with secondary/low-contrast ink */\r\n.chat-md--muted {\r\n  color: var(--chat-text-2);\r\n}\r\n.chat-md--muted :not(code):not(pre) {\r\n  color: inherit;\r\n}\r\n.chat-md--muted .chat-code,\r\n.chat-md--muted .chat-code__pre,\r\n.chat-md--muted .chat-code__pre code,\r\n.chat-md--muted .chat-md__inline-code,\r\n.chat-md--muted :not(pre) > code {\r\n  color: var(--chat-code-fg) !important;\r\n  -webkit-text-fill-color: var(--chat-code-fg);\r\n}\r\n\r\n/* ── Assistant activity timeline ── */\r\n.lobe-chat-assistant-timeline {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: start;\n  /* 连续工作项对齐 ZCode ConversationTurnGroup 的 gap-4（16px）。 */\n  gap: 16px;\n  min-width: 0;\n  width: 100%;\n}\n\r\n.lobe-chat-assistant-timeline > :not(.lobe-timeline-rail--subagent) {\r\n  flex: 0 0 100%;\r\n}\r\n\r\n/* Single vertical rail for a flat tool list. */\r\n.lobe-timeline-rail {\r\n  width: 100%;\r\n  max-width: var(--chat-content-max, 48rem);\r\n  margin: 0;\r\n  padding: 0;\r\n  border-left: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0;\r\n}\r\n\r\n.
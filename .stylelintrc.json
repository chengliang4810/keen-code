{
  "ignoreFiles": [
    "**/node_modules/**",
    "packages/ui/src/styles.css",
    "src/styles.css",
    "apps/ui/src/index.css",
    "packages/ui/src/onboarding/onboardingLogoSweep.css"
  ],
  "rules": {
    "declaration-property-value-allowed-list": {
      "border-radius": [
        "inherit",
        "0",
        "/^var\\(/",
        "/^[0-9.]+%$/"
      ]
    },
    "declaration-property-value-disallowed-list": {
      "/color$/": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "background": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "/^border(-|$)/": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "outline": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "/shadow$/": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "fill": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "stroke": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ]
    }
  }
}

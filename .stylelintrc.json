{
  "ignoreFiles": [
    "**/node_modules/**",
    "apps/ui/src/styles/tokens.css",
    "apps/ui/src/styles/skins.css",
    "apps/ui/src/styles/code-preview.css",
    "apps/ui/src/styles/ui-governance.css",
    "apps/ui/src/components/lobe-chat/lobe-chat.css",
    "apps/ui/src/styles/harness/**"
  ],
  "rules": {
    "declaration-property-value-allowed-list": {
      "border-radius": [
        "inherit",
        "0",
        "/^var\\(/",
        "/^[0-9.]+%$/"
      ]
    },
    "declaration-property-value-disallowed-list": {
      "/color$/": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "background": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "/^border(-|$)/": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "outline": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "/shadow$/": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "fill": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ],
      "stroke": [
        "/rgba?\\(/",
        "/#[0-9a-fA-F]{3,8}\\b/"
      ]
    }
  }
}

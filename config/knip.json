{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/desktop/ui/main.tsx",
    "scripts/*.mjs",
    "config/*.mjs",
    "apps/desktop/vite.config.ts",
    "apps/desktop/ui/styles/globals.css"
  ],
  "project": ["apps/desktop/ui/**/*.{ts,tsx}"],
  "ignore": ["apps/desktop/ui/components/ui/**", "apps/desktop/ui/components/ai-elements/**"],
  "ignoreDependencies": [
    "@size-limit/file",
    "@tauri-apps/plugin-log",
    "@tauri-apps/plugin-window-state",
    "tailwindcss",
    "tw-animate-css",
    "shadcn",
    "@fontsource-variable/inter",
    "@codemirror/autocomplete",
    "@uiw/codemirror-themes"
  ]
}
